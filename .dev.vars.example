# Copy to .dev.vars for local development. These are SECRETS — .dev.vars is
# gitignored. Leave a value blank to exercise the dev fallback for that feature
# (no TURNSTILE_SECRET_KEY skips the challenge; outbound email is logged).

SESSION_SECRET=dev-only-local-session-secret-change-me-0123456789
APP_URL=http://localhost:4321
# Comma-separated emails that may place orders at $0, for testing the whole
# purchase → licence → build → download chain without moving money. Each comped
# order is a normal order with its full subtotal written off as a discount and a
# payment row at $0, so it stays visible and auditable. Keep the addresses out of
# wrangler.jsonc (this repo is public): set the same list in production with
#   wrangler secret put COMP_EMAILS
COMP_EMAILS=
TURNSTILE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TRONGRID_API_KEY=
# Point at a mock TronGrid in tests; leave blank for the real api.trongrid.io.
TRONGRID_BASE_URL=
TRON_RECEIVING_ADDRESS=
CRON_SECRET=
PERF_INGEST_TOKEN=
# Brevo transactional email — the fallback sender behind the Cloudflare Email
# binding (which is tried first). Two free senders: Cloudflare ~100/day + Brevo
# ~300/day = ~400/day combined, after which mail logs `skipped` instead of
# failing. Leave blank to use only the Cloudflare binding; with neither, mail is
# logged to the console.
# Set in production with: wrangler secret put BREVO_API_KEY
BREVO_API_KEY=

# Google sign-in (optional). Create an OAuth 2.0 "Web application" client in the
# Google Cloud Console and register these redirect URIs exactly:
#   https://bestmt4ea.com/auth/google/callback/
#   http://localhost:4321/auth/google/callback/
# Leave either blank to hide the "Continue with Google" button.
# Set in production with: wrangler secret put GOOGLE_CLIENT_ID
#                         wrangler secret put GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
