{
  "name": "bestmt4ea",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run redirects && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "redirects": "node scripts/build-redirects.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:rendered": "node scripts/check-rendered-html.mjs",
    "check:canonicals": "node scripts/check-canonicals.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:preview": "node scripts/check-preview.mjs",
    "test:worker": "node scripts/worker.test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:content": "node scripts/check-content.mjs",
    "check:content:strict": "node scripts/check-content.mjs --strict",
    "check:content:changed": "node scripts/check-content.mjs --changed",
    "check:debt": "node scripts/check-content.mjs --debt",
    "check:links": "node scripts/check-links.mjs",
    "check:downloads": "node scripts/check-downloads.mjs",
    "check:downloads:live": "node scripts/check-downloads-live.mjs",
    "build:inventory": "node scripts/build-inventory.mjs",
    "changed-files": "node scripts/changed-files.mjs",
    "new-post": "node scripts/new-post.mjs",
    "content:strip-dups": "node scripts/strip-dup-sections.mjs",
    "rewrite-queue": "node scripts/rewrite-queue.mjs",
    "wp:export": "node scripts/wp-export.mjs",
    "wp:refresh": "node scripts/wp-export.mjs --refresh",
    "sync:myfxbook": "node scripts/sync-myfxbook.mjs",
    "db:generate": "drizzle-kit generate",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply bestmt4ea --local",
    "db:migrate:remote": "wrangler d1 migrations apply bestmt4ea --remote",
    "db:seed:local": "node scripts/seed-catalog.mjs && wrangler d1 execute bestmt4ea --local --file=./scripts/seed-catalog.sql",
    "db:seed:remote": "node scripts/seed-catalog.mjs && wrangler d1 execute bestmt4ea --remote --file=./scripts/seed-catalog.sql",
    "release:check": "node scripts/release-gate.mjs",
    "predeploy": "npm run release:check",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "drizzle-orm": "^0.45.3",
    "github-slugger": "^2.0.0",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "drizzle-kit": "^0.31.11",
    "gray-matter": "^4.0.3",
    "tailwindcss": "^4.1.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.20.0"
  }
}
