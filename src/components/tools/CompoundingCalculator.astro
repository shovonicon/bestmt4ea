---
/** Compounding calculator — ported from `compounding-calculator.tsx`. */
---

<div id="calc-compounding" class="space-y-6">
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="metric-label mb-2 block">Starting balance ($)</span>
      <input class="tool-input" type="number" min="0" value="1000" data-field="balance" />
    </label>
    <label class="block">
      <span class="metric-label mb-2 block">Monthly return (%)</span>
      <input class="tool-input" type="number" step="0.5" min="0" value="10" data-field="return" />
    </label>
    <label class="block">
      <span class="metric-label mb-2 block">Number of months</span>
      <input class="tool-input" type="number" min="1" max="120" value="12" data-field="months" />
    </label>
    <label class="block">
      <span class="metric-label mb-2 block">Monthly deposit ($)</span>
      <input class="tool-input" type="number" min="0" value="0" data-field="deposit" />
    </label>
  </div>

  <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="tool-result text-center">
      <p class="mb-1 text-[10px] font-bold uppercase tracking-wider text-emerald-400">Final balance</p>
      <p class="text-xl font-bold text-white" data-out="final">$3,138</p>
    </div>
    <div class="tool-stat">
      <p class="mb-1 text-[10px] font-bold uppercase tracking-wider text-slate-500">Total profit</p>
      <p class="text-xl font-bold text-emerald-400" data-out="profit">$2,138</p>
    </div>
    <div class="tool-stat">
      <p class="mb-1 text-[10px] font-bold uppercase tracking-wider text-slate-500">Total return</p>
      <p class="text-xl font-bold text-white" data-out="return">213.8%</p>
    </div>
    <div class="tool-stat">
      <p class="mb-1 text-[10px] font-bold uppercase tracking-wider text-slate-500">Months</p>
      <p class="text-xl font-bold text-white" data-out="count">12</p>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-white/10">
    <div class="max-h-80 overflow-y-auto">
      <table class="w-full text-sm">
        <thead class="sticky top-0 bg-black/90 backdrop-blur">
          <tr class="border-b border-white/10">
            <th scope="col" class="px-4 py-3 text-left text-[10px] font-bold uppercase tracking-wider text-slate-500">Month</th>
            <th scope="col" class="px-4 py-3 text-right text-[10px] font-bold uppercase tracking-wider text-slate-500">Balance</th>
            <th scope="col" class="px-4 py-3 text-right text-[10px] font-bold uppercase tracking-wider text-slate-500">Profit</th>
          </tr>
        </thead>
        <tbody data-out="rows"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
  (() => {
    const el = document.getElementById('calc-compounding');
    if (!el) return;
    const root = el;
    const field = (name: string) => root.querySelector<HTMLInputElement>(`[data-field="${name}"]`)!;
    const out = (name: string) => root.querySelector<HTMLElement>(`[data-out="${name}"]`)!;
    const money = (value: number, decimals = 0) =>
      `$${value.toLocaleString(undefined, { minimumFractionDigits: decimals, maximumFractionDigits: decimals })}`;

    const calc = () => {
      const balance = parseFloat(field('balance').value) || 0;
      const rate = parseFloat(field('return').value) || 0;
      const months = Math.min(parseInt(field('months').value, 10) || 1, 120);
      const deposit = parseFloat(field('deposit').value) || 0;

      let current = balance;
      let totalProfit = 0;
      let html = '';
      for (let i = 1; i <= months; i++) {
        const profit = current * (rate / 100);
        totalProfit += profit;
        current += profit + deposit;
        html += `<tr class="border-b border-white/5"><td class="px-4 py-2.5 text-slate-400">${i}</td><td class="px-4 py-2.5 text-right font-mono text-white">${money(current, 2)}</td><td class="px-4 py-2.5 text-right font-mono text-emerald-400">+${money(profit, 2)}</td></tr>`;
      }

      const contributed = balance + deposit * months;
      const totalReturn = contributed > 0 ? ((current - contributed) / contributed) * 100 : 0;

      out('final').textContent = money(current);
      out('profit').textContent = money(totalProfit);
      out('return').textContent = `${totalReturn.toFixed(1)}%`;
      out('count').textContent = String(months);
      out('rows').innerHTML = html || '<tr><td class="px-4 py-3 text-slate-500" colspan="3">No months to show.</td></tr>';
    };

    root.querySelectorAll('input').forEach((node) => node.addEventListener('input', calc));
    calc();
  })();
</script>
