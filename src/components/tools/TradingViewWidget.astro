---
/**
 * TradingView embed widgets (live rates, advanced chart, economic calendar).
 *
 * Ported from the reference `components/tools/tradingview-widgets.tsx`. The
 * third-party embed script is appended client-side, so nothing is requested
 * until this page is opened.
 */
export interface Props {
  widget: 'rates' | 'chart' | 'calendar';
}

const { widget } = Astro.props;

const WIDGETS = {
  rates: {
    id: 'tv-forex-rates',
    src: 'https://s3.tradingview.com/external-embedding/embed-widget-forex-cross-rates.js',
    height: 500,
    config: {
      width: '100%',
      height: 500,
      currencies: ['EUR', 'USD', 'GBP', 'JPY', 'AUD', 'CAD', 'CHF', 'NZD'],
      isTransparent: true,
      colorTheme: 'dark',
      locale: 'en',
    },
  },
  chart: {
    id: 'tv-live-chart',
    src: 'https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js',
    height: 550,
    config: {
      autosize: true,
      symbol: 'FX:EURUSD',
      interval: '60',
      timezone: 'Etc/UTC',
      theme: 'dark',
      style: '1',
      locale: 'en',
      allow_symbol_change: true,
      support_host: 'https://www.tradingview.com',
    },
  },
  calendar: {
    id: 'tv-eco-calendar',
    src: 'https://s3.tradingview.com/external-embedding/embed-widget-events.js',
    height: 550,
    config: {
      colorTheme: 'dark',
      isTransparent: true,
      width: '100%',
      height: 550,
      locale: 'en',
      importanceFilter: '-1,0,1',
      countryFilter: 'us,eu,gb,jp,au,ca,ch,nz,cn',
    },
  },
} as const;

const selected = WIDGETS[widget];
---

{
  /*
   * The fixed height goes on the WRAPPER, and the widget container fills it.
   * With `autosize: true` TradingView sizes the chart to its parent, so putting
   * the height on the widget div itself collapses it to its minimum (~150px).
   */
}
<div style={`height:${selected.height}px`}>
  <div
    id={selected.id}
    class="tradingview-widget-container h-full w-full"
    data-tv-src={selected.src}
    data-tv-config={JSON.stringify(selected.config)}
  ></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tv-src]').forEach((container) => {
    if (container.dataset.tvLoaded === '1') return;
    container.dataset.tvLoaded = '1';
    const script = document.createElement('script');
    script.src = container.dataset.tvSrc ?? '';
    script.async = true;
    script.type = 'text/javascript';
    script.innerHTML = container.dataset.tvConfig ?? '{}';
    container.appendChild(script);
  });
</script>
