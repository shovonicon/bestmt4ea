---
/** Margin calculator — ported from `margin-calculator.tsx`. */
const PAIRS = [
  { key: 'EURUSD', price: 1.085, contract: 100000, label: 'EUR/USD' },
  { key: 'GBPUSD', price: 1.27, contract: 100000, label: 'GBP/USD' },
  { key: 'USDJPY', price: 149.5, contract: 100000, label: 'USD/JPY' },
  { key: 'USDCHF', price: 0.875, contract: 100000, label: 'USD/CHF' },
  { key: 'AUDUSD', price: 0.655, contract: 100000, label: 'AUD/USD' },
  { key: 'USDCAD', price: 1.36, contract: 100000, label: 'USD/CAD' },
  { key: 'GBPJPY', price: 189.8, contract: 100000, label: 'GBP/JPY' },
  { key: 'XAUUSD', price: 2350, contract: 100, label: 'XAU/USD (Gold)' },
];
const LEVERAGES = [30, 50, 100, 200, 500];
---

<div id="calc-margin" class="space-y-6">
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <label class="block">
      <span class="metric-label mb-2 block">Currency pair</span>
      <select class="tool-input" data-field="pair">
        {
          PAIRS.map((pair) => (
            <option value={pair.key} data-price={pair.price} data-contract={pair.contract}>
              {pair.label}
            </option>
          ))
        }
      </select>
    </label>
    <label class="block">
      <span class="metric-label mb-2 block">Lot size</span>
      <input class="tool-input" type="number" step="0.01" min="0.01" value="1.00" data-field="lots" />
    </label>
    <label class="block">
      <span class="metric-label mb-2 block">Leverage</span>
      <select class="tool-input" data-field="leverage">
        {LEVERAGES.map((value) => <option value={value} selected={value === 100}>1:{value}</option>)}
      </select>
    </label>
    <label class="block">
      <span class="metric-label mb-2 block">Current price</span>
      <input class="tool-input" type="number" step="0.0001" value="1.0850" data-field="price" />
    </label>
  </div>

  <div class="tool-result">
    <p class="metric-label">Required margin</p>
    <p class="display-stat mt-2 text-4xl text-white">
      <span data-out="margin">$1,085.00</span> <span class="text-lg text-slate-400">USD</span>
    </p>
    <p class="mt-2 text-sm text-slate-400" data-out="caption">1.00% of notional value at 1:100 leverage</p>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div class="tool-stat">
      <p class="mb-1 text-xs text-slate-500">Notional value</p>
      <p class="text-lg font-bold text-white" data-out="notional">$108,500.00</p>
    </div>
    <div class="tool-stat">
      <p class="mb-1 text-xs text-slate-500">Free margin needed</p>
      <p class="text-lg font-bold text-white" data-out="free">$1,085.00</p>
    </div>
  </div>

  <div class="rounded-xl border border-white/5 bg-white/[0.01] p-4">
    <p class="text-xs leading-relaxed text-slate-500">
      <strong class="text-slate-300">Formula:</strong> Required Margin = (Lot Size × Contract Size × Price) ÷ Leverage.
      Higher leverage reduces margin but increases risk exposure.
    </p>
  </div>
</div>

<script>
  (() => {
    const el = document.getElementById('calc-margin');
    if (!el) return;
    const root = el;
    const field = (name: string) =>
      root.querySelector(`[data-field="${name}"]`) as HTMLInputElement | HTMLSelectElement;
    const out = (name: string) => root.querySelector<HTMLElement>(`[data-out="${name}"]`)!;

    const calc = () => {
      const option = (field('pair') as HTMLSelectElement).selectedOptions[0] as HTMLOptionElement;
      const contract = Number(option.dataset.contract);
      const lots = parseFloat(field('lots').value) || 0;
      const leverage = parseInt(field('leverage').value, 10) || 100;
      const price = parseFloat(field('price').value) || Number(option.dataset.price);

      const notional = lots * contract * price;
      const margin = notional / leverage;

      out('margin').textContent = `$${margin.toFixed(2)}`;
      out('notional').textContent = `$${notional.toLocaleString(undefined, { maximumFractionDigits: 2 })}`;
      out('free').textContent = `$${margin.toFixed(2)}`;
      out('caption').textContent = `${((1 / leverage) * 100).toFixed(2)}% of notional value at 1:${leverage} leverage`;
    };

    // Changing the pair resets the price field to that pair's reference price.
    (field('pair') as HTMLSelectElement).addEventListener('change', () => {
      const option = (field('pair') as HTMLSelectElement).selectedOptions[0] as HTMLOptionElement;
      (field('price') as HTMLInputElement).value = String(option.dataset.price);
      calc();
    });

    root.querySelectorAll('input,select').forEach((node) => node.addEventListener('input', calc));
    calc();
  })();
</script>
