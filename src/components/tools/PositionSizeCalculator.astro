---
/** Position size calculator — ported from `position-size-calculator.tsx`. */
---

<div id="calc-position" class="space-y-6">
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="metric-label mb-2 block">Account balance ($)</span>
      <input class="tool-input" type="number" min="0" value="10000" data-field="balance" />
    </label>
    <label class="block">
      <span class="metric-label mb-2 block">Risk per trade (%)</span>
      <input class="tool-input" type="number" step="0.5" min="0.1" max="100" value="2" data-field="risk" />
    </label>
    <label class="block">
      <span class="metric-label mb-2 block">Stop loss (pips)</span>
      <input class="tool-input" type="number" min="1" value="50" data-field="stop" />
    </label>
    <label class="block">
      <span class="metric-label mb-2 block">Pip value ($ per standard lot)</span>
      <input class="tool-input" type="number" min="0.01" step="0.01" value="10" data-field="pip" />
    </label>
  </div>

  <div class="tool-result">
    <p class="metric-label">Recommended position size</p>
    <p class="display-stat mt-2 text-4xl text-white">
      <span data-out="lots">0.40</span> <span class="text-lg text-slate-400">standard lots</span>
    </p>
    <p class="mt-2 text-sm text-slate-400" data-out="caption">Risking $200.00 (2% of $10,000) with 50 pip stop loss</p>
  </div>

  <div class="grid grid-cols-3 gap-3">
    <div class="tool-stat">
      <p class="mb-1 text-xs text-slate-500">Standard lots</p>
      <p class="text-xl font-bold text-white" data-out="standard">0.40</p>
    </div>
    <div class="tool-stat">
      <p class="mb-1 text-xs text-slate-500">Mini lots</p>
      <p class="text-xl font-bold text-white" data-out="mini">4.0</p>
    </div>
    <div class="tool-stat">
      <p class="mb-1 text-xs text-slate-500">Micro lots</p>
      <p class="text-xl font-bold text-white" data-out="micro">40</p>
    </div>
  </div>
</div>

<script>
  (() => {
    const el = document.getElementById('calc-position');
    if (!el) return;
    const root = el;
    const field = (name: string) => root.querySelector<HTMLInputElement>(`[data-field="${name}"]`)!;
    const out = (name: string) => root.querySelector<HTMLElement>(`[data-out="${name}"]`)!;

    const calc = () => {
      const balance = parseFloat(field('balance').value) || 0;
      const risk = parseFloat(field('risk').value) || 0;
      const stop = parseFloat(field('stop').value) || 1;
      const pip = parseFloat(field('pip').value) || 10;

      const riskAmount = balance * (risk / 100);
      const lots = riskAmount / (stop * pip);

      out('lots').textContent = lots.toFixed(2);
      out('standard').textContent = lots.toFixed(2);
      out('mini').textContent = (lots * 10).toFixed(1);
      out('micro').textContent = (lots * 100).toFixed(0);
      out('caption').textContent = `Risking $${riskAmount.toFixed(2)} (${risk}% of $${balance.toLocaleString()}) with ${stop} pip stop loss`;
    };

    root.querySelectorAll('input').forEach((node) => node.addEventListener('input', calc));
    calc();
  })();
</script>
