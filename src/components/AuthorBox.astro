---
/**
 * Article byline.
 *
 * The dates and reading time now live in the article header, so this is the
 * credibility half: who writes the reviews, and how to reach them. The avatar is
 * the brand mark extracted from the logo.
 */
import { site } from '../lib/site';
---

<section class="panel-flat flex flex-wrap items-center justify-between gap-x-6 gap-y-4 p-5">
  <div class="flex items-center gap-3">
    <span
      aria-hidden="true"
      class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full border border-emerald-400/25 bg-emerald-400/10 p-1.5"
    >
      <img
        src="/media/brand-mark.png"
        alt=""
        width="26"
        height="26"
        class="h-full w-full object-contain"
        loading="lazy"
        decoding="async"
      />
    </span>
    <div>
      <p class="text-sm font-semibold text-[var(--color-ink)]">BESTMT4EA Trading Desk</p>
      <p class="text-xs text-[var(--color-ink-dim)]">
        MQL4/MQL5 developers and traders. We publish the live track record for everything we review.
      </p>
    </div>
  </div>

  <a href={site.telegram.support} rel="noopener" class="btn btn-ghost !px-4 !py-2 !text-xs">
    Ask us on Telegram
  </a>
</section>
