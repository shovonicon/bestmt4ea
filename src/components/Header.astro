---
import { getCollection } from 'astro:content';
import { getPublicProducts } from '../lib/content';
import { getPerformance } from '../lib/performance';
import { site } from '../lib/site';
import { url } from '../lib/urls';
import { AFFILIATE_REL, getAffiliate, goPath } from '../lib/affiliates';
import taxonomies from '../data/taxonomies.json';

/**
 * Mega-menu icons. The reference (`forexcracked.com`) labels every menu section
 * with a small icon rather than a bare list of links, which is a large part of
 * why its menu is easy to scan — mirrored here.
 */
const MENU_ICONS: Record<string, string> = {
  flash: '<path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/>',
  tools:
    '<path d="M14.7 6.3a4 4 0 0 0 5 5l-9.4 9.4a2.1 2.1 0 0 1-3-3l9.4-9.4z"/><path d="m6 6 3 3"/>',
  chart: '<path d="M3 3v18h18"/><path d="M7 15l3-4 3 3 4-6"/>',
  scale:
    '<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>',
  shield:
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  trend: '<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>',
  download:
    '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>',
};
const CHEVRON = '<path d="m9 18 6-6-6-6"/>';

// Public products only — a withdrawn one must not reappear in the mega menu.
const products = await getPublicProducts();

/*
 * The menu splits the catalogue into two columns of six. Products are ranked by
 * verified gain, so the first column is the strongest published track records and
 * the second holds the rest — systems with no tracking account, the indicator and
 * the VPS. Neither column is named by hand: adding or removing a product
 * rebalances them, and every public product stays reachable.
 */
const rankedProducts = products
  .map((product) => ({ product, perf: getPerformance(product.data.slug) }))
  .sort((a, b) => (b.perf?.totalGainPct ?? -Infinity) - (a.perf?.totalGainPct ?? -Infinity));

const menuLink = (product: any) => ({
  href: url(`/product/${product.data.slug}`),
  label: product.data.title,
});

const featured = rankedProducts.slice(0, 6).map(({ product }) => menuLink(product));
const moreProducts = rankedProducts.slice(6).map(({ product }) => menuLink(product));

/**
 * Blog categories, grouped for the mega menu.
 *
 * Only categories that actually have posts get a page (mirrors
 * `scripts/routes.mjs`), so the menu is built from the live ones — a category
 * with no posts has no route and would be a dead link. Titles group the
 * taxonomy's own paths; every label comes from the taxonomy.
 */
const BLOG_GROUPS: Array<{ title: string; icon: string; segments: string[] }> = [
  { title: 'Expert Advisors', icon: 'flash', segments: ['mt4-mt5-expert-advisors'] },
  { title: 'Trading Tools', icon: 'tools', segments: ['ai-powered-trading-tools', 'forex-indicator-reviews'] },
  { title: 'Strategies', icon: 'trend', segments: ['forex-trading-strategies'] },
  {
    title: 'Free Downloads & Guides',
    icon: 'download',
    segments: ['free-forex-ea', 'free-forex-indicator', 'risk-money-management'],
  },
];

const usedCategoryNames = new Set<string>();
for (const post of await getCollection('posts')) {
  for (const name of (post.data as any).categories ?? []) usedCategoryNames.add(name);
}

const seenCategoryLabels = new Set<string>();
const liveBlogCategories = ((taxonomies as any).blogCategories ?? [])
  .map((cat: any) => {
    const href = `/${String(cat.path)
      .replace(/^https?:\/\/[^/]+/, '')
      .replace(/^\/+/, '')
      .replace(/\/+$/, '')}/`;
    return { href, label: String(cat.name), segment: href.replace(/^\/category\//, '').split('/')[0] };
  })
  .filter((cat: any) => usedCategoryNames.has(cat.label) && !seenCategoryLabels.has(cat.label))
  .filter((cat: any) => {
    seenCategoryLabels.add(cat.label);
    return true;
  });

const blogColumns = BLOG_GROUPS.map((group) => ({
  title: group.title,
  icon: group.icon,
  links: liveBlogCategories
    .filter((cat: any) => group.segments.includes(cat.segment))
    .map((cat: any) => ({ href: url(cat.href), label: cat.label })),
})).filter((column) => column.links.length > 0);

if (blogColumns.length > 0) {
  blogColumns[blogColumns.length - 1].links.push({ href: url('/blog'), label: 'View All Posts →' });
}

/** Links shown before the dropdown menus. */
const leadLinksRaw = [
  { href: '/', label: 'Home' },
  { href: '/top-ranking', label: 'EA Rankings' },
];

/** Links shown after the dropdown menus. */
const tailLinksRaw = [
  { href: '/best-forex-brokers', label: 'Forex Brokers' },
  { href: '/copy-trading', label: 'Fund Management' },
  { href: '/tools', label: 'Free Tools' },
  { href: '/product/vps', label: 'Forex VPS' },
  { href: '/customer-feedback', label: 'Testimonials' },
];

/** The store, highlighted in the bar. It replaces both the old "Shop" link and the old button. */
const exploreHref = url('/shop');
const exploreCount = products.length;

const menusRaw = [
  {
    label: 'Expert Advisors',
    columns: [
      { title: 'Featured Expert Advisors', icon: 'flash', links: featured },
      { title: 'More Systems & Tools', icon: 'tools', links: moreProducts },
    ],
  },
  {
    label: 'EA Reviews',
    columns: [
      {
        title: 'Best EAs by Platform',
        icon: 'chart',
        links: [
          { href: '/best-mt4-ea', label: 'Best MT4 EAs' },
          { href: '/best-mt5-ea', label: 'Best MT5 EAs' },
          { href: '/best-forex-ea', label: 'Best Forex EAs' },
          { href: '/top-ranking', label: 'All EA Rankings' },
        ],
      },
      {
        title: 'Best EAs by Strategy',
        links: [
          { href: '/product-category/gold-forex-ea', label: 'Best Gold EAs' },
          { href: '/product-category/forex-robot', label: 'Best Scalping Robots' },
          { href: '/product-category/indicator', label: 'Forex Indicators' },
        ],
      },
      {
        title: 'Brokers & Services',
        links: [
          { href: '/best-forex-brokers', label: 'Best Forex Brokers' },
          { href: '/copy-trading', label: 'Copy Trading' },
          { href: '/product/vps', label: 'Forex VPS' },
          { href: '/customer-feedback', label: 'Customer Feedback' },
        ],
      },
    ],
  },
  {
    label: 'Forex Blog',
    href: '/blog',
    columns: blogColumns,
  },
];

/**
 * Every internal href is normalised here once, so the trailing-slash policy
 * cannot be broken by adding a menu entry without one.
 */
const withUrls = (links: { href: string; label: string }[]) =>
  links.map((link) => ({ ...link, href: url(link.href) }));

const leadLinks = withUrls(leadLinksRaw);
const tailLinks = withUrls(tailLinksRaw);
const menus = menusRaw.map((menu) => ({
  ...menu,
  /* A menu may carry its own destination as well as a panel — Blog goes to the
     archive — so its href needs the same trailing-slash normalisation. */
  href: menu.href ? url(menu.href) : undefined,
  columns: menu.columns.map((col) => ({ ...col, links: withUrls(col.links) })),
}));

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);

/**
 * The session is only resolved on on-demand routes, so a prerendered page (the
 * homepage, a product page) always renders the signed-out header. That is the
 * trade for keeping those pages static — inside `/dashboard` the account nav is
 * where the signed-in state is authoritative.
 */
const signedIn = Astro.locals.session?.subjectType === 'customer';

/** Sponsor line under the logo. The registry supplies the label and logo. */
const roboforex = getAffiliate('roboforex');
const searchIndexUrl = url('/search-index.json').replace(/\/$/, '');
---

<header data-site-header class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div class="container-x flex h-16 items-center justify-between gap-4 lg:grid lg:grid-cols-[1fr_auto_1fr]">
    <div class="relative hidden lg:block" data-search data-index={searchIndexUrl}>
      <form role="search" action={url('/blog')} class="relative max-w-[18rem]" onsubmit="return false">
        <label for="site-search" class="sr-only">Search the site</label>
        <svg
          viewBox="0 0 24 24"
          class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-500"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
        <input
          id="site-search"
          type="search"
          autocomplete="off"
          placeholder="Search EAs and guides"
          data-search-input
          aria-controls="site-search-results"
          class="h-10 w-full rounded-full border border-white/10 bg-white/5 pl-9 pr-3 text-sm text-white placeholder:text-slate-500 focus:border-emerald-400/50 focus:outline-none focus:ring-2 focus:ring-emerald-400/30"
        />
      </form>
      <ul
        id="site-search-results"
        data-search-results
        hidden
        class="absolute left-0 top-full z-50 mt-2 max-h-80 w-[22rem] overflow-auto rounded-2xl border border-white/10 bg-[#05070f] p-2 shadow-[0_30px_80px_-20px_rgba(0,0,0,0.9)]"
      >
      </ul>
    </div>

    <div class="flex items-center gap-6">
      <a href="/" class="group flex items-center gap-3" aria-label={`${site.name} home`}>
        <img
          src="/logo.png"
          alt={site.name}
          width="800"
          height="132"
          data-logo-dark
          class="h-8 w-auto object-contain transition-transform duration-300 group-hover:brightness-110 sm:h-9"
        />
        <img
          src="/media/bestmt4ea-logo-light.png"
          alt={site.name}
          width="800"
          height="132"
          data-logo-light
          class="hidden h-8 w-auto object-contain transition-transform duration-300 group-hover:brightness-110 sm:h-9"
        />
      </a>
      {
        roboforex && (
          <a
            href={goPath('roboforex')}
            rel={AFFILIATE_REL}
            class="hidden flex-col items-start gap-0.5 border-l border-white/10 pl-6 text-[10px] uppercase tracking-wider text-slate-400 hover:text-white lg:flex"
          >
            Sponsored by
            <img src={roboforex.logo} alt={roboforex.label} class="h-5 w-auto" height="20" width="100" />
          </a>
        )
      }
    </div>

    <div class="hidden items-center justify-end gap-2.5 lg:flex">
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle light/dark theme"
        class="nav-pill"
      >
        <svg data-theme-icon-sun viewBox="0 0 24 24" class="h-3.5 w-3.5 hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
        </svg>
        <svg data-theme-icon-moon viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <a
        href={site.telegram.support}
        rel="noopener"
        class="nav-pill nav-pill-telegram"
        aria-label="Telegram support"
      >
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true">
          <path d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.7.8l-4.7-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.8 8.8-8c.4-.3-.1-.5-.6-.2L6.6 13.2 2 11.8c-1-.3-1-1 .2-1.5L20 3.3c.8-.3 1.6.2 1.9 1z" />
        </svg>
        Support
      </a>
      <a
        href={site.telegram.community}
        rel="noopener"
        class="nav-pill nav-pill-telegram"
        aria-label="Join our Telegram community"
      >
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true">
          <path d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.7.8l-4.7-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.8 8.8-8c.4-.3-.1-.5-.6-.2L6.6 13.2 2 11.8c-1-.3-1-1 .2-1.5L20 3.3c.8-.3 1.6.2 1.9 1z" />
        </svg>
        Community
      </a>
      <a href={signedIn ? url('/dashboard') : url('/login')} class="nav-pill nav-pill-login">
        <svg
          viewBox="0 0 24 24"
          class="h-3.5 w-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </svg>
        {signedIn ? 'My dashboard' : 'Login'}
      </a>
    </div>

    <button
      type="button"
      data-nav-toggle
      aria-label="Open menu"
      aria-expanded="false"
      class="grid h-11 w-11 place-items-center rounded-lg border border-white/10 bg-white/5 text-white lg:hidden"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
      >
        <line x1="4" x2="20" y1="12" y2="12" />
        <line x1="4" x2="20" y1="6" y2="6" />
        <line x1="4" x2="20" y1="18" y2="18" />
      </svg>
    </button>
  </div>

  <div class="hidden border-t border-white/10 bg-black/90 backdrop-blur-xl lg:block">
    <div class="container-x flex h-[2.75rem] items-center justify-center">
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        leadLinks.map((item) => (
          <a href={item.href} class="nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a
        href={exploreHref}
        class="nav-explore mx-1"
        aria-current={isActive(exploreHref) ? 'page' : undefined}
      >
        <span class="live-dot" aria-hidden="true"></span>
        EA Store
        <span class="nav-explore-count" aria-label={`${exploreCount} systems`}>{exploreCount}</span>
      </a>
      {
        menus.map((menu) => (
          <div class="relative" data-menu>
            {/*
              An item with a destination renders as a link, so clicking it
              navigates as well as opening the panel; everything else stays a
              button. `data-menu-toggle` carries the panel behaviour either way,
              which is what the script and the keyboard contract bind to.
            */}
            {menu.href ? (
              <a
                href={menu.href}
                data-menu-toggle
                aria-haspopup="true"
                aria-expanded="false"
                class="nav-link"
              >
                <span>{menu.label}</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="menu-chevron h-3.5 w-3.5 text-slate-400"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </a>
            ) : (
              <button
                type="button"
                data-menu-toggle
                aria-haspopup="true"
                aria-expanded="false"
                class="nav-link"
              >
                <span>{menu.label}</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="menu-chevron h-3.5 w-3.5 text-slate-400"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>
            )}

            <div class="pointer-events-none absolute left-1/2 top-full z-50 -translate-x-1/2 pt-2">
              <div
                class="menu-panel flex gap-6 rounded-2xl border border-white/10 bg-[#05070f] p-6 shadow-[0_30px_80px_-20px_rgba(0,0,0,0.9)] ring-1 ring-white/5"
              >
                {
                  menu.columns.map((col) => (
                    <div class="flex min-w-[13rem] flex-col gap-2">
                      <h4 class="mb-1 flex items-center gap-2 border-b border-white/5 pb-2 font-mono text-[12px] font-bold uppercase tracking-wider text-emerald-400">
                        {col.icon && (
                          <span class="grid h-6 w-6 shrink-0 place-items-center rounded-md border border-emerald-400/25 bg-emerald-400/10 text-emerald-300">
                            <svg
                              viewBox="0 0 24 24"
                              class="h-3.5 w-3.5"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              aria-hidden="true"
                              set:html={MENU_ICONS[col.icon]}
                            />
                          </span>
                        )}
                        {col.title}
                      </h4>
                      <ul class="flex flex-col gap-1">
                        {col.links.map((link) => (
                          <li>
                            <a
                              href={link.href}
                              class="menu-link"
                              aria-current={currentPath === link.href ? 'page' : undefined}
                            >
                              {link.label}
                              <svg
                                viewBox="0 0 24 24"
                                class="menu-link-arrow"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                                set:html={CHEVRON}
                              />
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        ))
      }

      {
        tailLinks.map((item) => (
          <a href={item.href} class="nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    </div>
  </div>

  <nav data-mobile-nav class="hidden border-t border-white/5 bg-black/90 backdrop-blur-xl lg:hidden" aria-label="Mobile">
    <div class="container-x flex flex-col py-3">
      <div class="relative mb-3" data-search>
        <form role="search" onsubmit="return false" class="relative">
          <label for="site-search-m" class="sr-only">Search the site</label>
          <input
            id="site-search-m"
            type="search"
            autocomplete="off"
            placeholder="Search EAs and guides"
            data-search-input
            class="h-11 w-full rounded-full border border-white/10 bg-white/5 px-4 text-sm text-white placeholder:text-slate-500 focus:border-emerald-400/50 focus:outline-none focus:ring-2 focus:ring-emerald-400/30"
          />
        </form>
        <ul
          data-search-results
          hidden
          class="mt-2 max-h-72 overflow-auto rounded-2xl border border-white/10 bg-[#05070f] p-2"
        >
        </ul>
      </div>
      <a
        href={exploreHref}
        class="nav-explore mb-2 min-h-[44px] justify-between !rounded-2xl !px-4 !text-sm"
        aria-current={isActive(exploreHref) ? 'page' : undefined}
      >
        <span class="flex items-center gap-2.5">
          <span class="live-dot" aria-hidden="true"></span>
          EA Store
        </span>
        <span class="nav-explore-count">{exploreCount} systems</span>
      </a>
      {
        leadLinks.map((item) => (
          <a
            href={item.href}
            class="flex min-h-[44px] items-center rounded-lg px-3 text-sm font-medium text-slate-300 transition-colors hover:bg-white/[0.06] hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
      {
        menus.map((menu) => (
          <details class="group border-t border-white/5">
            <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between rounded-lg px-3 text-sm font-medium text-slate-300">
              {menu.label}
              <span class="text-slate-500 transition-transform group-open:rotate-180">▾</span>
            </summary>
            <div class="pb-2">
              {menu.columns.map((col) => (
                <div class="mt-2">
                  <p class="flex items-center gap-2 px-3 font-mono text-[11px] font-bold uppercase tracking-wider text-emerald-400">
                    {col.icon && (
                      <svg
                        viewBox="0 0 24 24"
                        class="h-3.5 w-3.5 shrink-0"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        set:html={MENU_ICONS[col.icon]}
                      />
                    )}
                    {col.title}
                  </p>
                  <ul>
                    {col.links.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          class="menu-link-m"
                          aria-current={currentPath === link.href ? 'page' : undefined}
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        ))
      }
      {
        tailLinks.map((item) => (
          <a
            href={item.href}
            class="flex min-h-[44px] items-center rounded-lg px-3 text-sm font-medium text-slate-300 transition-colors hover:bg-white/[0.06] hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
      {
        signedIn && (
          <a
            href="/logout/"
            class="flex min-h-[44px] items-center rounded-lg px-3 text-sm font-medium text-slate-300 transition-colors hover:bg-white/[0.06] hover:text-white"
          >
            Sign out
          </a>
        )
      }
      <div class="mt-3 grid grid-cols-2 gap-2.5 border-t border-white/5 pt-3">
        <a
          href={signedIn ? url('/dashboard') : url('/login')}
          class="nav-pill nav-pill-login min-h-[44px] justify-center !text-sm"
        >
          <svg
            viewBox="0 0 24 24"
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
          {signedIn ? 'Dashboard' : 'Login'}
        </a>
        <a href={site.telegram.support} rel="noopener" class="nav-pill nav-pill-telegram min-h-[44px] justify-center !text-sm">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.7.8l-4.7-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.8 8.8-8c.4-.3-.1-.5-.6-.2L6.6 13.2 2 11.8c-1-.3-1-1 .2-1.5L20 3.3c.8-.3 1.6.2 1.9 1z" />
          </svg>
          Support
        </a>
        <a href={site.telegram.community} rel="noopener" class="nav-pill nav-pill-telegram col-span-2 min-h-[44px] justify-center !text-sm">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.7.8l-4.7-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.8 8.8-8c.4-.3-.1-.5-.6-.2L6.6 13.2 2 11.8c-1-.3-1-1 .2-1.5L20 3.3c.8-.3 1.6.2 1.9 1z" />
          </svg>
          Join the community
        </a>
        <button
          type="button"
          data-theme-toggle
          aria-label="Toggle light/dark theme"
          class="nav-pill col-span-2 min-h-[44px] justify-center !text-sm"
        >
          <svg data-theme-icon-sun viewBox="0 0 24 24" class="h-4 w-4 hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
          </svg>
          <svg data-theme-icon-moon viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
          <span data-theme-label>Dark mode</span>
        </button>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-site-header]');
    const navToggle = document.querySelector('[data-nav-toggle]');
    const mobile = document.querySelector('[data-mobile-nav]');

    const isLight = () => document.documentElement.dataset.theme === 'light';

    const onScroll = () => {
      if (!header) return;
      const solid = window.scrollY > 8;
      header.classList.toggle('border-b', solid);
      header.classList.toggle('border-white/5', solid && !isLight());
      header.classList.toggle('border-black/5', solid && isLight());
      header.classList.toggle('bg-black/80', solid && !isLight());
      header.classList.toggle('bg-white/80', solid && isLight());
      header.classList.toggle('backdrop-blur-xl', solid);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    /* ---------------------------------------------------------- mobile nav */

    const mobileOpen = () => Boolean(mobile) && !mobile.classList.contains('hidden');

    const setMobile = (open) => {
      if (!mobile || !navToggle) return;
      mobile.classList.toggle('hidden', !open);
      navToggle.setAttribute('aria-expanded', String(open));
      /* The accessible name must describe the action, not the icon. */
      navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    navToggle?.addEventListener('click', () => setMobile(!mobileOpen()));

    /* -------------------------------------------------------------- search */

    let indexPromise = null;
    const loadIndex = () =>
      (indexPromise ??= fetch(document.querySelector('[data-search]')?.dataset.index || '/search-index.json')
        .then((r) => (r.ok ? r.json() : []))
        .catch(() => []));

    document.querySelectorAll('[data-search]').forEach((root) => {
      const input = root.querySelector('[data-search-input]');
      const list = root.querySelector('[data-search-results]');
      if (!input || !list) return;
      let active = -1;

      const items = () => Array.from(list.querySelectorAll('a'));
      const hide = () => {
        list.hidden = true;
        active = -1;
      };
      const mark = (i) => {
        const links = items();
        links.forEach((a, n) => a.classList.toggle('bg-white/10', n === i));
        active = i;
      };

      const render = async () => {
        const q = input.value.trim().toLowerCase();
        if (q.length < 2) return hide();
        const words = q.split(/\s+/);
        const index = await loadIndex();
        const hits = index
          .map((it) => {
            const title = it.t.toLowerCase();
            if (!words.every((w) => title.includes(w))) return null;
            return { it, score: (title.startsWith(q) ? 0 : 2) + (it.k === 'p' ? 0 : 1) };
          })
          .filter(Boolean)
          .sort((a, b) => a.score - b.score)
          .slice(0, 8);
        list.textContent = '';
        if (hits.length === 0) {
          const li = document.createElement('li');
          li.className = 'px-3 py-2 text-sm text-slate-400';
          li.textContent = 'No matches. Try a shorter word.';
          list.appendChild(li);
        }
        hits.forEach(({ it }) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = it.u;
          a.className = 'flex min-h-[40px] items-center justify-between gap-3 rounded-lg px-3 py-1.5 text-sm text-slate-200 hover:bg-white/10';
          const t = document.createElement('span');
          t.textContent = it.t;
          const k = document.createElement('span');
          k.className = 'shrink-0 font-mono text-[10px] uppercase tracking-wider text-emerald-400';
          k.textContent = it.k === 'p' ? 'EA' : 'Guide';
          a.append(t, k);
          li.appendChild(a);
          list.appendChild(li);
        });
        list.hidden = false;
        active = -1;
      };

      input.addEventListener('focus', loadIndex, { once: true });
      input.addEventListener('input', render);
      input.addEventListener('keydown', (e) => {
        const links = items();
        if (e.key === 'ArrowDown' && links.length) {
          e.preventDefault();
          mark((active + 1) % links.length);
        } else if (e.key === 'ArrowUp' && links.length) {
          e.preventDefault();
          mark((active - 1 + links.length) % links.length);
        } else if (e.key === 'Enter') {
          e.preventDefault();
          (links[active] ?? links[0])?.click();
        } else if (e.key === 'Escape') {
          hide();
        }
      });
      document.addEventListener('click', (e) => {
        if (!root.contains(e.target)) hide();
      });
    });

    /* ------------------------------------------------------- desktop menus */

    const menus = Array.from(document.querySelectorAll('[data-menu]'));

    const setOpen = (menu, open) => {
      menu.classList.toggle('menu-open', open);
      menu.querySelector('[data-menu-toggle]')?.setAttribute('aria-expanded', String(open));
    };

    const closeAll = (except) => {
      menus.forEach((menu) => {
        if (menu !== except) setOpen(menu, false);
      });
    };

    menus.forEach((menu) => {
      const btn = menu.querySelector('[data-menu-toggle]');
      const firstLink = menu.querySelector('.menu-panel a');
      let closeTimer = 0;

      /**
       * Set while focus is being returned to the trigger after a close. The
       * trigger lives inside the menu, so focusing it fires `focusin` and would
       * reopen the menu immediately — which is exactly what Escape must not do.
       */
      let restoringFocus = false;

      const open = () => {
        if (restoringFocus) return;
        window.clearTimeout(closeTimer);
        closeAll(menu);
        setOpen(menu, true);
      };
      const close = () => setOpen(menu, false);

      /**
       * Closing is delayed so the pointer can cross the small gap between the
       * trigger and the panel without the menu vanishing mid-approach. Re-entering
       * cancels the pending close.
       */
      const scheduleClose = () => {
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(close, 220);
      };

      menu.addEventListener('mouseenter', open);
      menu.addEventListener('mouseleave', scheduleClose);

      /* Click keeps the menu open (mouseenter already opened it on hover) and is
         the only way in on touch, where hover never fires.
         An item with a destination keeps its default action, so the click both
         opens the panel and follows the link — Blog reaches the archive that way.
         Only a plain toggle is prevented, because it has nowhere to go. */
      btn?.addEventListener('click', (event) => {
        if (!btn.hasAttribute('href')) event.preventDefault();
        open();
      });

      /**
       * Keyboard entry: ArrowDown opens the menu and moves focus to its first
       * link. Without it a keyboard user can open the menu but has no way into
       * its contents, because the panel is not in the tab order while closed.
       */
      btn?.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowDown') return;
        event.preventDefault();
        open();
        firstLink?.focus();
      });

      /**
       * Escape closes the menu and returns focus to its trigger, so focus is
       * never dropped to the top of the document.
       */
      menu.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !menu.classList.contains('menu-open')) return;
        event.stopPropagation();
        close();
        restoringFocus = true;
        btn?.focus();
        window.setTimeout(() => {
          restoringFocus = false;
        }, 0);
      });

      menu.addEventListener('focusin', open);
      menu.addEventListener('focusout', (event) => {
        if (!menu.contains(event.relatedTarget)) scheduleClose();
      });
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('[data-menu]')) closeAll();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closeAll();
      if (mobileOpen()) {
        setMobile(false);
        navToggle?.focus();
      }
    });

    /* --------------------------------------------------------- theme toggle */

    const syncThemeUI = () => {
      const light = isLight();
      document.querySelectorAll('[data-theme-icon-sun]').forEach(el => el.classList.toggle('hidden', !light));
      document.querySelectorAll('[data-theme-icon-moon]').forEach(el => el.classList.toggle('hidden', light));
      document.querySelectorAll('[data-theme-label]').forEach(el => { el.textContent = light ? 'Dark mode' : 'Light mode'; });
      document.querySelectorAll('[data-logo-dark]').forEach(el => el.classList.toggle('hidden', light));
      document.querySelectorAll('[data-logo-light]').forEach(el => el.classList.toggle('hidden', !light));
      onScroll();
    };
    syncThemeUI();

    document.querySelectorAll('[data-theme-toggle]').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = isLight() ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        syncThemeUI();
      });
    });
  })();
</script>
