---
/**
 * Comparison registry — ported from the reference `RankingsTable`
 * (Strive Algo, components/global/rankings-table.tsx) so the board matches it
 * one-to-one: tinted header strip, circular rank chip, name + "MyFxBook
 * Tracked", platform pill, emerald gain/ROI, red drawdown pill, strategy,
 * highlight and a Review + Buy EA action cell.
 *
 * Only the data source differs. Every figure comes from `getPerformance` / the
 * product's own detail, and a system with no tracked record says so instead of
 * borrowing a number.
 */
import { getPerformance } from '../lib/performance';
import { url } from '../lib/urls';
import detailData from '../data/product-detail.json';

export interface Props {
  products: any[];
}

const { products } = Astro.props;

type Setting = { label: string; value: string };
type Detail = { settings?: Setting[] };
const details = detailData as unknown as Record<string, Detail>;

const settingValue = (slug: string, match: RegExp): string | undefined =>
  details[slug]?.settings?.find((setting) => match.test(setting.label))?.value;
const shortName = (title: string) => String(title).split(':')[0].trim();
const pct = (value: number | undefined) => (value != null ? `${value}%` : 'N/A');

const rows = products
  .map((product) => ({ product, perf: getPerformance(product.data.slug) }))
  .sort((a, b) => (b.perf?.totalGainPct ?? -Infinity) - (a.perf?.totalGainPct ?? -Infinity))
  .map((entry, index) => ({ ...entry, rank: index + 1 }));

const rankClass = (rank: number) =>
  rank === 1
    ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-400/30'
    : rank === 2
      ? 'bg-teal-500/20 text-teal-300 border border-teal-400/30'
      : rank === 3
        ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-400/30'
        : 'bg-white/5 text-slate-400 border border-white/5';

const TH = 'px-5 py-4 text-xs font-semibold uppercase tracking-wider text-slate-400';
---

<div
  class="table-shell w-full overflow-x-auto"
  role="region"
  tabindex="0"
  aria-label="Ranked comparison of expert advisors by verified gain"
>
  <table class="w-full min-w-[800px] border-collapse text-left text-sm">
    <caption class="sr-only">Ranked expert advisors: platform, gain, monthly return, drawdown and strategy</caption>
    <thead>
      <tr class="border-b border-white/10 text-slate-300" style="background: rgba(0, 193, 144, 0.05);">
        <th scope="col" class={TH}>Rank</th>
        <th scope="col" class={TH}>Robot Name</th>
        <th scope="col" class={TH}>Pair</th>
        <th scope="col" class={TH}>Platform</th>
        <th scope="col" class:list={[TH, 'text-center']}>Gain</th>
        <th scope="col" class:list={[TH, 'text-center']}>Monthly ROI</th>
        <th scope="col" class:list={[TH, 'text-center']}>Max Drawdown</th>
        <th scope="col" class={TH}>Strategy</th>
        <th scope="col" class:list={[TH, 'text-right']}>Action</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map(({ product, perf, rank }) => {
          const slug = product.data.slug;
          const href = url(`/product/${slug}`);
          // `platform: none` means "not stated" — fall back to the product's own
          // brands before assuming both terminals (mirrors ProductLayout).
          const platform =
            product.data.platform !== 'none'
              ? product.data.platform
              : product.data.brands?.length
                ? product.data.brands.join(' / ')
                : 'MT4 / MT5';
          const pair = settingValue(slug, /pair/i) ?? '—';
          const strategy = perf?.strategy ?? settingValue(slug, /strategy/i) ?? '—';
          const gain = perf?.totalGainPct;
          const tracked = perf?.verified
            ? perf.accountType === 'demo'
              ? 'MyFxBook Tracked · Demo'
              : 'MyFxBook Tracked'
            : 'No public track record';

          return (
            <tr class="border-b border-white/10 transition-colors duration-200 last:border-b-0 hover:bg-white/[0.02]">
              {/* Rank */}
              <td class="px-5 py-5 text-base font-semibold">
                <div class="flex items-center gap-2">
                  <span class:list={['flex h-7 w-7 items-center justify-center rounded-full text-xs font-bold', rankClass(rank)]}>
                    #{rank}
                  </span>
                </div>
              </td>

              {/* Robot Name */}
              <td class="px-5 py-5 font-medium text-white">
                <a href={href} class="flex flex-col gap-0.5 transition-colors duration-200 hover:text-emerald-400">
                  <span class="font-heading flex items-center gap-1.5 text-sm font-bold sm:text-base">
                    {shortName(product.data.title)}
                    {rank === 1 && (
                      <span class="inline-flex items-center gap-1 rounded-full border border-emerald-400/20 bg-emerald-500/10 px-2 py-0.5 text-[10px] font-medium text-emerald-400">
                        <svg
                          viewBox="0 0 24 24"
                          class="h-2.5 w-2.5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z" />
                          <path d="M20 3v4" />
                          <path d="M22 5h-4" />
                          <path d="M4 17v2" />
                          <path d="M5 18H3" />
                        </svg>
                        Best Choice
                      </span>
                    )}
                  </span>
                  <span class="text-xs font-normal text-slate-500">{tracked}</span>
                </a>
              </td>

              {/* Pair */}
              <td class="px-5 py-5 font-semibold text-slate-300">{pair}</td>

              {/* Platform */}
              <td class="px-5 py-5">
                <span class="rounded border border-white/5 bg-white/5 px-2.5 py-1 text-xs font-semibold text-slate-300">
                  {platform}
                </span>
              </td>

              {/* Gain */}
              <td class="px-5 py-5 text-center font-bold text-emerald-400">
                {gain != null ? `${gain >= 0 ? '+' : ''}${gain}%` : 'N/A'}
              </td>

              {/* Monthly ROI */}
              <td class="px-5 py-5 text-center font-bold text-emerald-400">{pct(perf?.monthlyGainPct)}</td>

              {/* Max Drawdown */}
              <td class="px-5 py-5 text-center text-slate-300">
                <span class="rounded border border-red-500/10 bg-red-500/10 px-2 py-0.5 text-xs font-semibold text-red-400">
                  {pct(perf?.maxDrawdownPct)}
                </span>
              </td>

              {/* Strategy */}
              <td class="px-5 py-5 font-medium text-slate-300">{strategy}</td>

              {/* Action */}
              <td class="px-5 py-5 text-right">
                <div class="flex items-center justify-end">
                  <a
                    href={`${href}#acquire`}
                    class="group inline-flex shrink-0 items-center justify-center gap-1 whitespace-nowrap rounded-lg px-3 py-1.5 text-xs font-semibold text-black transition-all duration-300 hover:scale-105"
                    style="background: linear-gradient(135deg, #34D399 0%, #10B981 100%); min-width: 80px;"
                  >
                    Get License
                    <svg
                      viewBox="0 0 24 24"
                      class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M7 7h10v10" />
                      <path d="M7 17 17 7" />
                    </svg>
                  </a>
                </div>
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
