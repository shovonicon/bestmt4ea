---
/**
 * Answer-first summary block.
 *
 * This is the single highest-leverage element for AI/GEO visibility: AI
 * answer engines lift a self-contained 40-75 word answer that directly
 * resolves the page's question. It sits immediately after the H1, before any
 * ad or table of contents, so it is the first thing parsed.
 */
export interface Props {
  answer: string;
  label?: string;
}

const { answer, label = 'Quick answer' } = Astro.props;
---

<section class="panel-flat border-l-2 border-l-[--color-accent] p-5" data-answer-box>
  <p class="eyebrow">{label}</p>
  <p class="mt-2 text-base leading-7 text-[--color-ink]">{answer}</p>
</section>
