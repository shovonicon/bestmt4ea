---
/**
 * Post card — the shared listing unit for the blog index and category archives.
 *
 * One component so the two listings cannot drift apart: category chip, reading
 * time, title, three-line summary, author and a read cue.
 */
import { url } from '../lib/urls';

export interface Props {
  post: any;
}

const { post } = Astro.props;

/* Estimated reading time from the post body, at roughly 230 words a minute. */
const readTime = (body: string) =>
  `${Math.max(1, Math.round(body.split(/\s+/).filter(Boolean).length / 230))} min read`;

const href = url(`/${post.data.slug}/`);
const author = post.data.author ?? 'BestMT4EA';
---

<article class="group flex flex-col justify-between rounded-2xl border border-white/10 bg-zinc-950/40 p-6 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-accent)]/30 hover:bg-zinc-950/70">
  <div>
    <div class="mb-4 flex items-center justify-between gap-4">
      {post.data.categories?.[0] ? (
        <span class="rounded-full border border-[var(--color-accent)]/20 bg-[var(--color-accent)]/10 px-2.5 py-1 text-[11px] font-bold uppercase tracking-widest text-[var(--color-accent)]">
          {post.data.categories[0]}
        </span>
      ) : (
        <span />
      )}
      <span class="flex items-center gap-1 text-[12px] font-medium text-[var(--color-ink-dim)]">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7v5l3 2" />
        </svg>
        {readTime(post.body ?? '')}
      </span>
    </div>
    <h2 class="mb-3 text-xl font-bold leading-6 text-white transition-colors group-hover:text-[var(--color-accent)]">
      <a href={href}>{post.data.title}</a>
    </h2>
    <p class="mb-6 line-clamp-3 text-sm leading-6 text-[var(--color-ink-dim)]">{post.data.description}</p>
  </div>
  <div class="mt-auto flex items-center justify-between border-t border-white/5 pt-4">
    <div class="flex items-center gap-2">
      <div class="flex h-6 w-6 items-center justify-center rounded-full border border-[var(--color-accent)]/20 bg-[var(--color-accent)]/10 text-[11px] font-bold uppercase text-[var(--color-accent)]">
        {author.charAt(0)}
      </div>
      <span class="text-xs font-medium text-[var(--color-ink-dim)]">{author}</span>
    </div>
    <a href={href} class="flex items-center gap-1.5 text-xs font-bold text-white transition-colors group-hover:text-[var(--color-accent)]">
      Read Post
      <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>
  </div>
</article>
