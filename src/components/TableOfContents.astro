---
import type { Heading } from '../lib/reading';

/**
 * Table of contents.
 *
 * `variant="inline"` renders the open list used in the desktop reading column.
 * `variant="collapsible"` wraps the same links in a `<details>` for mobile, so
 * a long outline never pushes the narrative below the fold on a small screen.
 */
export interface Props {
  headings: Heading[];
  title?: string;
  class?: string;
  variant?: 'inline' | 'collapsible';
}

const { headings, title = 'On this page', class: className = '', variant = 'inline' } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{
  items.length >= 3 &&
    (variant === 'collapsible' ? (
      <details class:list={['panel-flat p-5', className]} data-toc="collapsible">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
          <span class="metric-label">{title}</span>
          <span aria-hidden="true" class="text-xs text-[var(--color-accent]">{items.length} sections</span>
        </summary>
        <ol class="mt-3 space-y-2 text-sm">
          {items.map((item) => (
            <li>
              <a href={`#${item.id}`} class="text-[var(--color-ink-dim] transition-colors hover:text-[var(--color-accent]">
                {item.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    ) : (
      <nav class:list={['panel-flat p-5', className]} aria-label="Table of contents" data-toc="inline">
        <p class="metric-label">{title}</p>
        <ol class="mt-3 space-y-2 text-sm">
          {items.map((item) => (
            <li>
              <a href={`#${item.id}`} class="text-[var(--color-ink-dim] transition-colors hover:text-[var(--color-accent]">
                {item.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    ))
}
