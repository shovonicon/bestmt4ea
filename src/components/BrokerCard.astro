---
/**
 * Broker comparison card — used for the two "top pick" brokers.
 *
 * The label, affiliate URL and logo come from `src/lib/affiliates.ts` via
 * `key` — this component never holds a tracking URL. The link carries
 * `rel="sponsored nofollow noopener"`, and the page is responsible for showing
 * the affiliate disclosure before the first card.
 */
import { getAffiliate, AFFILIATE_REL } from '../lib/affiliates';

export interface Props {
  broker: {
    key: string;
    regulation: string;
    minDeposit: string;
    platforms: string;
    accountTypes: string;
    offer?: string;
    recommended?: boolean;
  };
  /** 1-based position — drives the numeral badge. */
  rank?: number;
}

const { broker, rank } = Astro.props;
const affiliate = getAffiliate(broker.key);
if (!affiliate) return null;
---

<article data-broker-pick={broker.key} class:list={['hover-brand-card flex flex-col p-6', broker.recommended && 'shadow-glow', rank === 1 && broker.recommended && 'premium-pick']}>
  <div class="flex items-center justify-between gap-3">
    {
      rank != null ? (
        <span class:list={['rank-badge', broker.recommended && 'rank-badge--top']}>{rank}</span>
      ) : (
        <span />
      )
    }
    {broker.recommended && <span class="partner-chip">{rank != null && rank <= 2 ? 'Top choice' : 'Recommended'}</span>}
  </div>

  <span class="partner-logo-plate mt-5 w-fit">
    {
      affiliate.logo ? (
        <img src={affiliate.logo} alt={affiliate.label} loading="lazy" decoding="async" />
      ) : (
        <span class="text-sm font-bold text-[#04140f]">{affiliate.label}</span>
      )
    }
  </span>

  <h3 class="mt-4 text-lg font-bold text-[var(--color-ink)]">{affiliate.label}</h3>
  <span data-country-badge hidden class="broker-badge mt-2 w-fit"></span>

  <dl class="mt-4 flex-1 space-y-2 text-sm">
    <div class="flex justify-between gap-3">
      <dt class="text-[var(--color-ink-dim)]">Min deposit</dt>
      <dd class="metric-value text-[var(--color-ink)]">{broker.minDeposit}</dd>
    </div>
    <div class="flex justify-between gap-3">
      <dt class="text-[var(--color-ink-dim)]">Regulation</dt>
      <dd class="text-right font-medium text-[var(--color-ink)]">{broker.regulation}</dd>
    </div>
    <div class="flex justify-between gap-3">
      <dt class="text-[var(--color-ink-dim)]">Platforms</dt>
      <dd class="text-right font-medium text-[var(--color-ink)]">{broker.platforms}</dd>
    </div>
  </dl>

  {
    broker.offer && (
      <p class="mt-4 rounded-lg border border-[var(--color-accent)]/25 bg-[var(--color-accent)]/[0.06] px-3 py-2 text-xs leading-5 text-[var(--color-ink-soft)]">
        <span class="metric-label">Offer</span>{' · '}
        <span class="font-semibold text-[var(--color-accent-soft)]">{broker.offer}</span>
      </p>
    )
  }

  <a href={affiliate.url} rel={AFFILIATE_REL} class="btn btn-primary mt-5 w-full">Open account</a>
</article>

<style>
  /* Premium highlight for the top choice (rank 1 in the picks section). */
  .premium-pick {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.6);
    background:
      radial-gradient(120% 90% at 0% 0%, rgba(212, 175, 55, 0.16), transparent 60%),
      linear-gradient(160deg, rgba(24, 19, 6, 0.94), rgba(0, 0, 0, 0.88) 60%);
    box-shadow:
      inset 0 1px 0 rgba(255, 236, 170, 0.2),
      0 0 0 1px rgba(212, 175, 55, 0.14),
      0 30px 80px -30px rgba(212, 175, 55, 0.6);
  }
  .premium-pick::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(110deg, transparent 35%, rgba(255, 236, 170, 0.14) 50%, transparent 65%);
    transform: translateX(-100%);
    animation: premium-sheen 6s ease-in-out infinite;
  }
  @keyframes premium-sheen {
    0%, 60% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  .premium-pick h3 {
    font-size: 1.5rem;
    background: linear-gradient(90deg, #fff4c7, #e9c25b 55%, #fff4c7);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .premium-pick .partner-chip {
    background: linear-gradient(135deg, #f5d77a, #b8891c);
    color: #1a1204;
    border: 0;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: 0 6px 20px -6px rgba(212, 175, 55, 0.7);
  }
  .premium-pick .rank-badge {
    background: linear-gradient(135deg, #f5d77a, #b8891c);
    color: #1a1204;
  }
  @media (prefers-reduced-motion: reduce) {
    .premium-pick::after { animation: none; }
  }
</style>
