---
/**
 * Product decision chart.
 *
 * Plots every system that has a real published figure for **total gain** against
 * **maximum drawdown**, and highlights the one being viewed. That is the trade-off
 * a buyer is actually weighing, and it is the only comparison this catalogue can
 * honestly draw: the data we hold is aggregate (return, drawdown, profit factor,
 * trade count), not a time series.
 *
 * Deliberate constraint: this component renders **only** figures that exist. It
 * never draws an equity curve, a sparkline or an interpolated series, because we
 * do not have one — an invented chart is a false claim, not a design choice
 * (docs/CONTENT-STANDARD.md §3b). If the system being viewed has no published
 * third-party record, the chart says so instead of plotting a guess.
 */
import { getPerformance } from '../lib/performance';
import { getPublicProducts } from '../lib/content';
import { formatDate } from '../lib/format';

export interface Props {
  /** Slug of the product currently being viewed. */
  slug: string;
}

const { slug } = Astro.props;
const products = await getPublicProducts();

const current = getPerformance(slug);

const rows = products
  .map((product) => ({ product, perf: getPerformance(product.data.slug) }))
  .filter((row) => row.perf?.hasData && row.perf.totalGainPct != null && row.perf.maxDrawdownPct != null)
  .map((row) => ({
    slug: row.product.data.slug,
    title: row.product.data.title,
    gain: row.perf!.totalGainPct as number,
    drawdown: row.perf!.maxDrawdownPct as number,
    live: Boolean(row.perf!.isLiveAccount),
  }));

const W = 640;
const H = 340;
const PAD = { top: 24, right: 28, bottom: 52, left: 64 };
const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

const maxGain = Math.max(...rows.map((r) => r.gain), 10);
const maxDrawdown = Math.max(...rows.map((r) => r.drawdown), 10);
const gainTop = Math.ceil((maxGain * 1.1) / 25) * 25;
const ddRight = Math.ceil((maxDrawdown * 1.1) / 25) * 25;

const x = (dd: number) => PAD.left + (dd / ddRight) * plotW;
const y = (gain: number) => PAD.top + plotH - (gain / gainTop) * plotH;

const ticks = (max: number) => [0, 25, 50, 75, 100].map((pct) => (max * pct) / 100);
const gainTicks = ticks(gainTop);
const ddTicks = ticks(ddRight);

const currentPlotted = rows.some((r) => r.slug === slug);
const checkedOn = current?.lastVerified ? formatDate(current.lastVerified) : undefined;
---

{
  rows.length >= 2 ? (
    <section class="panel p-6" data-product-chart>
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-base">Return against drawdown</h2>
        <p class="metric-label">
          {rows.length} system{rows.length === 1 ? '' : 's'} with a published record
        </p>
      </div>

      <p class="mt-2 text-xs leading-6 text-[--color-ink-dim]">
        Each point is one system in the catalogue: total gain up the side, maximum equity drawdown
        across the bottom. Further left and higher up is a better trade-off. Filled points are live
        accounts; hollow points are demo records.
      </p>

      <!--
        The chart scrolls horizontally on narrow screens, which makes it a scroll
        container: without tabindex it cannot be reached by keyboard (axe
        `scrollable-region-focusable`, WCAG 2.1.1). A div can carry a role and a
        name, so it announces itself rather than being an anonymous tab stop.
      -->
      <div
        class="mt-5 overflow-x-auto"
        tabindex="0"
        role="region"
        aria-label="Return against drawdown chart, scrollable horizontally"
      >
        <svg
          viewBox={`0 0 ${W} ${H}`}
          width={W}
          height={H}
          role="img"
          aria-label="Scatter chart comparing each expert advisor's total gain against its maximum drawdown"
          class="h-auto w-full min-w-[36rem]"
        >
          <g stroke="rgba(255,255,255,0.08)" stroke-width="1">
            {gainTicks.map((tick) => <line x1={PAD.left} x2={W - PAD.right} y1={y(tick)} y2={y(tick)} />)}
            {ddTicks.map((tick) => <line x1={x(tick)} x2={x(tick)} y1={PAD.top} y2={H - PAD.bottom} />)}
          </g>

          <line
            x1={PAD.left}
            x2={W - PAD.right}
            y1={H - PAD.bottom}
            y2={H - PAD.bottom}
            stroke="rgba(255,255,255,0.25)"
          />
          <line x1={PAD.left} x2={PAD.left} y1={PAD.top} y2={H - PAD.bottom} stroke="rgba(255,255,255,0.25)" />

          <g fill="var(--color-ink-dim)" font-size="11" font-family="var(--font-mono, monospace)">
            {gainTicks.map((tick) => (
              <text x={PAD.left - 10} y={y(tick) + 4} text-anchor="end">{tick}%</text>
            ))}
            {ddTicks.map((tick) => (
              <text x={x(tick)} y={H - PAD.bottom + 20} text-anchor="middle">{tick}%</text>
            ))}
          </g>

          <text
            x={PAD.left + plotW / 2}
            y={H - 8}
            fill="var(--color-ink-dim)"
            font-size="11"
            text-anchor="middle"
          >
            Maximum drawdown
          </text>
          <text
            x={16}
            y={PAD.top + plotH / 2}
            fill="var(--color-ink-dim)"
            font-size="11"
            text-anchor="middle"
            transform={`rotate(-90 16 ${PAD.top + plotH / 2})`}
          >
            Total gain
          </text>

          {
            rows.map((row) => {
              const isCurrent = row.slug === slug;
              return (
                <g>
                  <circle
                    cx={x(row.drawdown)}
                    cy={y(row.gain)}
                    r={isCurrent ? 8 : 5.5}
                    fill={isCurrent ? 'var(--color-accent)' : row.live ? 'rgba(0,193,144,0.45)' : 'none'}
                    stroke={isCurrent ? 'var(--color-accent-soft)' : 'rgba(0,193,144,0.7)'}
                    stroke-width={isCurrent ? 2.5 : 1.5}
                  >
                    <title>{`${row.title} — ${row.gain}% gain, ${row.drawdown}% max drawdown${row.live ? ' (live account)' : ' (demo account)'}`}</title>
                  </circle>
                  {isCurrent && (
                    <text
                      x={x(row.drawdown) + 12}
                      y={y(row.gain) + 4}
                      fill="var(--color-ink)"
                      font-size="11"
                      font-weight="600"
                    >
                      This system
                    </text>
                  )}
                </g>
              );
            })
          }
        </svg>
      </div>

      <p class="mt-4 text-xs leading-6 text-[--color-ink-dim]">
        {
          currentPlotted ? (
            <>
              Figures come from each system's published third-party record
              {checkedOn ? `, checked ${checkedOn}` : ''}. Past performance does not indicate future
              results, and a point's position says nothing about how it reached it — a small drawdown
              from a short sample is not the same evidence as a small drawdown over hundreds of trades.
            </>
          ) : (
            <>
              This system is not plotted because no third-party account has been published for it, so
              there is nothing to verify. Treat that as the finding: without a record there is no
              evidence to compare, and the absence is more informative than a figure would be.
            </>
          )
        }
      </p>
    </section>
  ) : (
    <section class="panel p-6" data-product-chart>
      <h2 class="text-base">Return against drawdown</h2>
      <p class="mt-3 text-sm leading-7 text-[--color-ink-soft]">
        A comparison chart needs at least two systems with a published third-party record. We do not
        draw a chart from figures we do not have.
      </p>
    </section>
  )
}
