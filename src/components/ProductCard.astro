---
import type { CollectionEntry } from 'astro:content';
import { getPerformance } from '../lib/performance';
import { url } from '../lib/urls';

export interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const perf = getPerformance(product.data.slug);

const platform = product.data.platform;
const gain = perf?.totalGainPct;
const monthly = perf?.monthlyGainPct;
const minCap = perf?.minCapitalUsd;
const href = url(`/product/${product.data.slug}`);
---

<article class="hover-brand-card group flex flex-col overflow-hidden">
  <a href={href} class="block aspect-square overflow-hidden bg-black/40">
    {
      product.data.featuredImage ? (
        <img
          src={product.data.featuredImage}
          alt={product.data.title}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="flex h-full items-center justify-center text-xs text-[--color-ink-dim]">No image</div>
      )
    }
  </a>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center gap-2">
      <span class="badge">{platform === 'none' ? 'EA' : platform}</span>
      {perf?.verified && <span class="badge badge-accent">Myfxbook verified</span>}
    </div>

    <h3 class="mt-3 text-lg leading-snug">
      <a href={href} class="hover:text-[--color-accent]">{product.data.title}</a>
    </h3>

    <p class="mt-2 line-clamp-3 text-sm leading-6 text-[--color-ink-dim]">{product.data.description}</p>

    <dl class="mt-5 grid grid-cols-3 gap-3 border-t border-[--color-line-soft] pt-4">
      <div>
        <dt class="metric-label">Gain</dt>
        <dd class="metric-value mt-1 text-base">
          {gain != null ? `+${gain}%` : '—'}
        </dd>
      </div>
      <div>
        <dt class="metric-label">Monthly</dt>
        <dd class="metric-value mt-1 text-base">
          {monthly != null ? `${monthly}%` : '—'}
        </dd>
      </div>
      <div>
        <dt class="metric-label">Min bal</dt>
        <dd class="metric-value mt-1 text-base">
          {minCap != null ? `$${minCap.toLocaleString('en-US')}` : '—'}
        </dd>
      </div>
    </dl>

    <div class="mt-5 flex gap-2">
      <a href={href} class="btn btn-ghost flex-1">Read review</a>
      <a href={`${href}#acquire`} class="btn btn-primary flex-1">Get license</a>
    </div>
  </div>
</article>
