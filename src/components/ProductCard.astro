---
/**
 * Product card — the EA listing unit.
 *
 * Kept deliberately minimal: one badge, the name, the two figures that actually
 * inform a decision (total gain and max drawdown), the price and a single call
 * to action. The description, licence tiers and specs live on the product page,
 * which is where the buying decision is meant to happen.
 */
import type { CollectionEntry } from 'astro:content';
import { getPerformance } from '../lib/performance';
import { priceFrom, compareAtFrom } from '../lib/pricing';
import { formatMoney, formatSignedPercent } from '../lib/format';
import { url } from '../lib/urls';

export interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const perf = getPerformance(product.data.slug);

const href = url(`/product/${product.data.slug}`);
const currency = product.data.currency || 'USD';
const from = priceFrom(product.data.slug);
const compareAt = compareAtFrom(product.data.slug);

const platform = product.data.platform;
const gain = perf?.totalGainPct;
const drawdown = perf?.maxDrawdownPct;

// A product that publishes no third-party record says so, rather than showing a
// row of dashes under a "verified" badge it has not earned.
const hasRecord = gain != null || drawdown != null;
---

<article class="hover-brand-card group flex flex-col overflow-hidden">
  <div class="px-5 pt-5">
    <a
      href={href}
      class="relative block aspect-square overflow-hidden rounded-2xl border border-white/10 bg-black/40 transition-colors duration-300 group-hover:border-[var(--color-accent]/40"
    >
      {
        product.data.featuredImage ? (
          <img
            src={product.data.featuredImage}
            alt={product.data.title}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          />
        ) : (
          <div class="flex h-full items-center justify-center text-xs text-[var(--color-ink-dim]">No image</div>
        )
      }
      {
        perf?.verified && (
          <span class="badge badge-accent absolute right-3 top-3 shadow-[0_0_20px_-6px_rgba(0,193,144,0.9)]">
            Myfxbook verified
          </span>
        )
      }
    </a>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center gap-2">
      <span class="badge">{platform === 'none' ? 'EA' : platform}</span>
    </div>

    <h3 class="mt-3 line-clamp-2 text-[1.2rem] leading-snug">
      <a href={href} class="font-semibold text-[var(--color-ink] hover:text-[var(--color-accent]">{product.data.title}</a>
    </h3>

    {
      hasRecord ? (
        <dl class="mt-4 grid grid-cols-2 gap-4">
          <div>
            <dt class="metric-label">Total gain</dt>
            <dd class="metric-value mt-1 text-lg text-[var(--color-accent]">
              {gain != null ? formatSignedPercent(gain) : '—'}
            </dd>
          </div>
          <div>
            <dt class="metric-label">Max drawdown</dt>
            <dd class="metric-value mt-1 text-lg" style="color: var(--color-danger);">
              {drawdown != null ? `${drawdown}%` : '—'}
            </dd>
          </div>
        </dl>
      ) : (
        <p class="mt-4 flex-1 text-xs leading-6 text-[var(--color-ink-dim]">
          No third-party track record is published for this system — judge it on its own documentation.
        </p>
      )
    }

    <div class="mt-5 flex items-center justify-between gap-3 border-t border-[var(--color-line-soft] pt-4">
      <p class="flex items-baseline gap-2">
        <span class="metric-label">From</span>
        <span class="display-stat text-2xl">{from != null ? formatMoney(from, currency) : 'Free'}</span>
        {compareAt != null && <span class="strike text-sm">{formatMoney(compareAt, currency)}</span>}
      </p>
      <a href={`${href}#acquire`} class="btn btn-primary whitespace-nowrap">Get licence</a>
    </div>
  </div>
</article>
