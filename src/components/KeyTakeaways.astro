---
export interface Props {
  items: string[];
  title?: string;
}

const { items, title = 'Key takeaways' } = Astro.props;
---

{
  items.length > 0 && (
    <section class="panel p-6">
      <h2 class="text-base">{title}</h2>
      <ul class="mt-4 space-y-3">
        {items.map((item) => (
          <li class="flex gap-3 text-sm leading-7 text-[var(--color-ink-soft]">
            <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-accent]" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}
