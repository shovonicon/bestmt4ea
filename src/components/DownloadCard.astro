---
import { isHosted, publicUrl } from '../lib/files';
import { url } from '../lib/urls';

/**
 * Free-download card.
 *
 * AdSense policy note: an ad placed next to this block can be mistaken for the
 * download link, which is a violation. Layouts must keep every `AdSlot` at
 * least one full content section away from this component.
 *
 * Open-source items always show the original author and a link to the source,
 * which is both the licence obligation and the E-E-A-T signal.
 */
export interface Props {
  download: {
    origin: 'own' | 'opensource' | 'shared';
    /** What the file actually is. Shown verbatim; never the article's title. */
    name?: string;
    license: string;
    licenseUrl?: string;
    author?: string;
    sourceUrl?: string;
    version?: string;
    platform?: string;
    fileSize?: string;
    fileKey?: string;
    externalUrl?: string;
    updatedAt?: Date;
  };
  title: string;
  /**
   * How the card describes the file. `external` is for a third-party archive we
   * link to but do not publish or verify — the frontmatter schema has no such
   * origin on purpose, so only a layout-level fallback passes it in.
   */
  kind?: 'own' | 'opensource' | 'external';
  /**
   * True when the file is a companion resource for the article (a worksheet,
   * checklist or shared library) rather than the article's subject. Corpus
   * audit, 2026-10-23: every post download on this site is a companion, so
   * layouts pass this for all post downloads; the card must never read as
   * "download the thing this article is about".
   */
  companion?: boolean;
}

const { download, title, kind, companion = false } = Astro.props;

const hosted = isHosted(download);
const href = download.fileKey ? publicUrl(download.fileKey) : download.externalUrl!;
const isOwn = download.origin === 'own';
const isShared = download.origin === 'shared';
const isExternal = kind === 'external' || isShared;

const fmt = (d?: Date) =>
  d
    ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(d)
    : undefined;
---

<section id="download" class="panel border-[var(--color-accent)]/30 p-6" data-download-card>
  <div class="flex flex-wrap items-center gap-2">
    <span class="badge badge-accent">{companion && isOwn ? 'Free companion resource' : isShared ? 'Shared bundle' : isExternal ? 'Third-party' : isOwn ? 'Our own build' : 'Open source'}</span>
    {download.platform && <span class="badge">{download.platform}</span>}
    {download.version && <span class="badge">v{download.version}</span>}
    {(!isExternal || isShared) && <span class="badge">{download.license}</span>}
  </div>

  <h2 class="mt-4 text-xl">{companion ? (download.name ?? 'Free companion resource') : `Download ${title}`}</h2>
  {
    !companion && download.name && (
      <p class="mt-2 text-sm text-[var(--color-ink)]">
        <span class="text-[var(--color-ink-soft)]">File:</span> {download.name}
        {download.fileSize ? ` — ${download.fileSize}` : ''}
      </p>
    )
  }
  {
    companion && download.fileSize && (
      <p class="mt-2 text-sm text-[var(--color-ink)]">
        <span class="text-[var(--color-ink-soft)]">Size:</span> {download.fileSize}
      </p>
    )
  }
  <p class="mt-2 text-sm leading-7 text-[var(--color-ink-soft)]">
    {
      isShared
        ? 'This link does not download a single file for the tool in this article. It opens a shared Google Drive library of 2,000+ third-party EAs and indicators in three ZIP parts (about 577 MB in total); the tool is inside the bundle under its own file name, if it is there at all. We did not make these files and have not verified their licences, so scan everything, test on a demo account first, and use it entirely at your own risk.'
        : isExternal
        ? 'A third-party community EA bundle with no stated license; use for educational/demo testing only and entirely at your own risk.'
        : isOwn && companion
          ? 'A free companion resource for this article, built in-house: a practical worksheet or checklist to use alongside what you have just read. It is not the product, EA or indicator this article discusses, and nothing in it installs on your terminal.'
          : isOwn
            ? 'Built in-house and released free. Use it on a demo account first, then decide whether it earns a place on your live terminal.'
            : 'Distributed here under its original licence, with full credit to the author. The licence terms below govern how you may use and share it.'
    }
  </p>

  {
    !isExternal && (
      <dl class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {(
          [
            ['Platform', download.platform],
            ['Version', download.version],
            ['File size', download.fileSize],
            ['Licence', download.license],
          ] as const
        )
          // A row with no value is worse than no row: "Platform —" reads as a
          // missing field rather than a field that does not apply.
          .filter(([, value]) => Boolean(value))
          .map(([label, value]) => (
            <div>
              <dt class="metric-label">{label}</dt>
              <dd class="mt-1 text-sm text-[var(--color-ink)]">{value}</dd>
            </div>
          ))}
      </dl>
    )
  }

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <a
      href={href}
      class="btn btn-primary"
      rel={hosted ? undefined : 'noopener nofollow'}
      data-download-link
    >
      {hosted ? 'Download file' : isShared ? 'Open the shared library (Google Drive)' : isExternal ? 'Open the download link' : 'Download from source'}
    </a>
    {
      download.licenseUrl && (
        <a href={download.licenseUrl} rel="noopener nofollow" class="btn btn-ghost">
          Read the licence
        </a>
      )
    }
  </div>

  {
    isShared && download.author && download.sourceUrl && (
      <p class="mt-4 text-xs leading-6 text-[var(--color-ink-dim)]">
        <span class="text-[var(--color-ink-soft)]">Related open-source project:</span>{' '}
        <a href={download.sourceUrl} rel="noopener nofollow" class="text-emerald-300 hover:text-emerald-200">
          {download.author} on GitHub
        </a>
      </p>
    )
  }

  {
    isShared && (
      <p class="mt-4 text-xs leading-6 text-[var(--color-ink-dim)]">
        Own the rights to this file?{' '}
        <a href={url('/dmca-policy')} class="text-emerald-300 hover:text-emerald-200">
          Request its removal under our DMCA policy
        </a>
        .
      </p>
    )
  }

  {
    /*
     * Skipped for an external card: "Licence: <a sentence>" under a Download
     * heading reads as a missing value, and the author/source line duplicates
     * the button that already opens the archive.
     */
    !isExternal && (
      <div class="mt-5 space-y-1 border-t border-[var(--color-line-soft)] pt-4 text-xs text-[var(--color-ink-dim)]">
        <p>
          <span class="text-[var(--color-ink-soft)]">Licence:</span>
          {download.license}{download.updatedAt ? ` · updated ${fmt(download.updatedAt)}` : ''}
        </p>
        {download.author && (
          <p>
            <span class="text-[var(--color-ink-soft)]">Original author:</span> {download.author}
            {download.sourceUrl && (
              <>
                {' · '}
                <a href={download.sourceUrl} rel="noopener nofollow" class="text-[var(--color-accent)]">
                  view source
                </a>
              </>
            )}
          </p>
        )}
      </div>
    )
  }
</section>
