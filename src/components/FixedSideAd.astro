---
/**
 * Fixed 300x600 skyscraper pinned to a viewport edge.
 *
 * From the reference build (TBK), which shows one either side of the reading
 * column. They only appear on very wide screens so they never overlap the
 * article, and they sit outside the container rather than inside it.
 *
 * `rel` is passed in rather than assumed: the broker creative is an affiliate
 * link and must carry `AFFILIATE_REL`, while our own copy-trading creative is an
 * internal link and must not.
 */
export interface Props {
  side: 'left' | 'right';
  href: string;
  image: string;
  alt: string;
  rel?: string;
  width?: number;
  height?: number;
}

const { side, href, image, alt, rel, width = 300, height = 600 } = Astro.props;
---

<div class:list={['fixed-side-ad', `fixed-side-ad--${side}`]}>
  <span class="fixed-side-ad__label">Advertisement</span>
  <a href={href} target="_blank" rel={rel ?? 'noopener'}>
    <img src={image} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
  </a>
</div>

<style>
  .fixed-side-ad {
    display: none;
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    z-index: 80;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .fixed-side-ad--left {
    left: 12px;
  }

  .fixed-side-ad--right {
    right: 12px;
  }

  .fixed-side-ad__label {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ink-dim);
  }

  .fixed-side-ad img {
    border-radius: 0.75rem;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
  }

  /* Same breakpoint as the reference: below this the skyscrapers would collide
     with the reading column, so they stay out of the way entirely. */
  @media (min-width: 1700px) {
    .fixed-side-ad {
      display: flex;
    }
  }

  @media print {
    .fixed-side-ad {
      display: none;
    }
  }
</style>
