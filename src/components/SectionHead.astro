---
export interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  /** Centred by default; pass `left` for a heading that sits beside other content. */
  align?: 'left' | 'center';
  /** The accent the kicker and its rule are painted in. Emerald when omitted. */
  tone?: 'emerald' | 'gold' | 'violet' | 'sky';
  id?: string;
}

const { kicker, title, lead, align = 'center', tone, id } = Astro.props;
---

<div class:list={['max-w-3xl', tone && `tone-${tone}`, align === 'center' && 'mx-auto text-center']}>
  {
    kicker && (
      <p class:list={['section-mark eyebrow', align === 'center' && 'justify-center']}>
        <span>{kicker}</span>
      </p>
    )
  }
  <h2 id={id} class="mt-3 text-3xl leading-tight md:text-4xl">{title}</h2>
  {lead && <p class="mt-3 text-base leading-7 text-[var(--color-ink-soft)]">{lead}</p>}
</div>
