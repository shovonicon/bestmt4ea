---
export interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  id?: string;
}

const { kicker, title, lead, align = 'left', id } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  {
    kicker && (
      <p class:list={['section-mark eyebrow', align === 'center' && 'justify-center']}>
        <span>{kicker}</span>
      </p>
    )
  }
  <h2 id={id} class="mt-3 text-3xl leading-tight md:text-4xl">{title}</h2>
  {lead && <p class="mt-3 text-base leading-7 text-[--color-ink-soft]">{lead}</p>}
</div>
