---
/**
 * Affiliate leaderboard banner, scaled to the reading column.
 *
 * The creative is the broker's own asset on their CDN, so it stays current. The
 * link goes through the affiliate registry — never a hard-coded tracking URL —
 * and carries the required `rel` plus the disclosure, because it can be the
 * first affiliate link on the page.
 *
 * It is labelled "Advertisement" so it can never be read as part of the
 * article. Note the placement asked for here is *above* the answer box, which
 * §6 advises against for ad units — it is a banner rather than a unit, but it
 * does push the answer down the page, so it is worth watching the fold. */
import { AFFILIATE_DISCLOSURE, AFFILIATE_REL } from '../lib/affiliates';

export interface Props {
  href: string;
  image: string;
  alt: string;
}

const { href, image, alt } = Astro.props;
---

<div class="banner-ad">
  <span class="banner-ad__label">Advertisement</span>

  <a href={href} rel={AFFILIATE_REL} target="_blank" class="banner-ad__link">
    <img src={image} width="728" height="90" alt={alt} loading="lazy" decoding="async" />
  </a>

  <p class="banner-ad__note">{AFFILIATE_DISCLOSURE}</p>
</div>

<style>
  .banner-ad {
    margin-top: 1.5rem;
    padding: 0.85rem 0.9rem 0.7rem;
    border: 1px solid rgba(0, 193, 144, 0.3);
    border-radius: 0.9rem;
    background-image: linear-gradient(150deg, rgba(0, 193, 144, 0.1), rgba(0, 0, 0, 0.35) 65%);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.34);
    text-align: center;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .banner-ad:hover {
    border-color: rgba(0, 193, 144, 0.55);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.45);
  }

  .banner-ad__label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-soft);
  }

  .banner-ad__link {
    display: block;
    width: 100%;
  }

  /* 728x90 is wider than the reading column, so it scales down rather than
     overflowing. height:auto keeps the 8.1:1 ratio intact. */
  .banner-ad img {
    display: block;
    width: 100%;
    max-width: 728px;
    height: auto;
    margin-inline: auto;
    border-radius: 0.5rem;
  }

  .banner-ad__note {
    margin-top: 0.5rem;
    font-size: 0.625rem;
    line-height: 1.5;
    color: var(--color-ink-dim);
  }
</style>
