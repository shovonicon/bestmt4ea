---
/**
 * AdSense unit, with an optional fallback.
 *
 * Placement rules this component is built around (see docs/CONTENT-STANDARD.md):
 *   1. Never render next to a download button or a purchase CTA — AdSense
 *      treats an ad that can be mistaken for the download link as a violation.
 *   2. Never place inside the "answer box" or the first paragraph, so the
 *      primary answer is never pushed below the fold.
 *   3. Maximum of one unit per 500 words of body content.
 *   4. Renders nothing at all when PUBLIC_ADSENSE_CLIENT is unset, so local
 *      development and preview builds contain no ad code.
 *
 * `fallback` slot: shown when AdSense reports the unit unfilled (or never
 * reports at all — a blocked script), so reserved space is not wasted. Anything
 * passed in is the caller's responsibility to keep policy-safe, including the
 * `rel` and any affiliate disclosure.
 */
export interface Props {
  slot: string;
  format?: string;
  layoutKey?: string;
  /** A fixed unit size (e.g. 300x600). Omit for a responsive unit. */
  fixedSize?: { width: number; height: number };
  class?: string;
  /** Set false when the unit sits in the sidebar to avoid stacking labels. */
  showLabel?: boolean;
}

const { slot, format = 'auto', layoutKey, class: className = '', showLabel = true, fixedSize } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const enabled = Boolean(client && slot);
const hasFallback = Astro.slots.has('fallback');
---

{
  enabled && (
    <aside class:list={['ad-unit not-prose my-8', className]} aria-label="Advertisement" data-ad-unit>
      {showLabel && (
        <p class="mb-1 text-[10px] font-medium uppercase tracking-[0.16em] text-[var(--color-ink-dim]">
          Advertisement
        </p>
      )}
      <ins
        class="adsbygoogle block"
        style={fixedSize ? `display:inline-block;width:${fixedSize.width}px;height:${fixedSize.height}px` : 'display:block'}
        data-ad-client={client}
        data-ad-slot={slot}
        data-ad-format={fixedSize ? undefined : format}
        data-ad-layout-key={layoutKey}
        data-full-width-responsive={fixedSize ? undefined : 'true'}
      />
      {hasFallback && (
        <div data-ad-fallback hidden>
          <slot name="fallback" />
        </div>
      )}
      <script is:inline define:vars={{ client }}>
        /*
         * Load the AdSense library on the first unit on the page, and only then.
         * Pages with no unit — the homepage, product pages, the dashboard — load
         * nothing. The push below queues this unit until the library arrives, which
         * is how the standard snippet behaves, so order does not matter.
         */
        if (!window.__adsenseRequested) {
          window.__adsenseRequested = true;
          const script = document.createElement('script');
          script.async = true;
          script.crossOrigin = 'anonymous';
          script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + client;
          document.head.appendChild(script);
        }
        /*
         * Request the ad only once the unit has a width. AdSense sizes a unit from
         * its container and throws "No slot size for availableWidth=0" when asked
         * while it is hidden or not laid out yet — the side rails are display:none
         * below 1320px, and this script runs during parsing. Wait for a width
         * instead; a unit that never becomes visible never asks, and never errors.
         */
        (() => {
          const unit = document.currentScript?.closest('[data-ad-unit]');
          const ins = unit?.querySelector('ins.adsbygoogle');
          if (!ins) return;
          const request = () => {
            ins.dataset.adRequested = '1';
            try {
              (window.adsbygoogle = window.adsbygoogle || []).push({});
            } catch {
              /* a blocked or failed library must never break the page */
            }
          };
          if (ins.offsetWidth > 0) return request();
          if (typeof ResizeObserver === 'undefined') return request();
          const watcher = new ResizeObserver(() => {
            if (ins.offsetWidth > 0) {
              watcher.disconnect();
              request();
            }
          });
          watcher.observe(ins);
        })();
      </script>
      {hasFallback && (
        <script is:inline>
          /*
           * Swap an unfilled ad for its fallback. AdSense marks the <ins> with
           * `data-ad-status="unfilled"` when it has nothing to serve; if the
           * script never loads (blocked, or no fill) the status stays absent, so
           * a timeout covers that case too. A late fill flips it back.
           */
          (() => {
            const REVEAL_AFTER_MS = 4000;
            /*
             * Bind this unit only. An inline script runs while the document is
             * still parsing, so a document-wide `querySelectorAll` here would
             * miss every unit that appears later on the page.
             */
            const unit = document.currentScript?.closest('[data-ad-unit]');
            if (!unit) return;
            const fallback = unit.querySelector('[data-ad-fallback]');
            if (!fallback) return;

            const ad = unit.querySelector('ins.adsbygoogle');
            if (!ad) {
              fallback.hidden = false;
              return;
            }

            /*
             * An unfilled unit still leaves AdSense's own reserved box in the
             * layout, which would push the fallback below it — so the ad is
             * taken out of flow while the fallback stands in for it.
             */
            const sync = () => {
              const status = ad.getAttribute('data-ad-status');
              if (status === 'filled') {
                fallback.hidden = true;
                ad.style.display = '';
              } else if (status === 'unfilled') {
                fallback.hidden = false;
                ad.style.display = 'none';
              }
            };
            new MutationObserver(sync).observe(ad, {
              attributes: true,
              attributeFilter: ['data-ad-status'],
            });
            window.setTimeout(() => {
              // A unit that never became visible never asked, so it is not "unfilled".
              if (ad.dataset.adRequested !== '1') return;
              if (ad.getAttribute('data-ad-status') !== 'filled') {
                fallback.hidden = false;
                ad.style.display = 'none';
              }
            }, REVEAL_AFTER_MS);
          })();
        </script>
      )}
    </aside>
  )
}
