---
/**
 * Trading toolkit index — ported from the reference `app/tools/page.tsx`
 * (Strive Algo). Lists every available tool with its category and links to the
 * per-tool page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAvailableTools } from '../../data/tools';
import { url } from '../../lib/urls';

const tools = getAvailableTools();

/** Inline lucide-style icons (the reference uses lucide-react). */
const ICONS: Record<string, string> = {
  activity:
    '<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>',
  candlestick:
    '<path d="M3 3v18h18"/><path d="M9 5v4"/><rect width="4" height="6" x="7" y="9" rx="1"/><path d="M9 15v3"/><path d="M17 3v3"/><rect width="4" height="8" x="15" y="6" rx="1"/><path d="M17 14v3"/>',
  calendar:
    '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  hash: '<line x1="4" x2="20" y1="9" y2="9"/><line x1="4" x2="20" y1="15" y2="15"/><line x1="10" x2="8" y1="3" y2="21"/><line x1="16" x2="14" y1="3" y2="21"/>',
  target: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>',
  'trending-up': '<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>',
  'bar-chart': '<line x1="12" x2="12" y1="20" y2="10"/><line x1="18" x2="18" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="16"/>',
  layers:
    '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
  shield:
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
  scale:
    '<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>',
  'trending-down': '<polyline points="22 17 13.5 8.5 8.5 13.5 2 7"/><polyline points="16 17 22 17 22 11"/>',
  repeat:
    '<path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>',
};
const ARROW_RIGHT = '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>';
---

<BaseLayout
  title="Free Forex Trading Tools & Calculators"
  description="Free forex trading calculators, live charts, real-time rates, and an economic calendar. Pip value, position size, margin, risk/reward and compounding calculators — no sign-up required."
>
  <section class="relative overflow-hidden">
    <div class="glow-orb animate-aurora left-1/2 top-[-14rem] h-[24rem] w-[36rem] -translate-x-1/2 bg-emerald-500/25"
    ></div>
    <div class="grid-overlay pointer-events-none absolute inset-0"></div>

    <div class="container-x relative py-20 text-center lg:py-24">
      <span class="eyebrow animate-fade-in-up inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-4 py-2">
        <span class="live-dot"></span>Trading toolkit
      </span>
      <h1
        class="animate-fade-in-up-delay-1 mx-auto mt-6 max-w-3xl text-4xl font-bold leading-[1.08] tracking-tight sm:text-5xl"
      >
        Free forex tools &amp; <span class="text-gradient-brand">calculators</span>
      </h1>
      <p class="animate-fade-in-up-delay-2 mx-auto mt-6 max-w-2xl text-base leading-8 text-[--color-ink-soft]">
        Professional-grade trading calculators and live market data. No sign-up required — every tool runs instantly in
        your browser.
      </p>
    </div>
  </section>

  <section class="container-x pb-24" aria-label="Trading tools">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        tools.map((tool) => (
          <a
            href={url(`/tools/${tool.slug}`)}
            class="hover-brand-card group flex flex-col p-6"
          >
            <div class="mb-4 flex items-center gap-3">
              <span class="icon-tile">
                <svg
                  viewBox="0 0 24 24"
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={ICONS[tool.icon] ?? ICONS.activity}
                />
              </span>
              <span class="metric-label">{tool.category === 'live-data' ? 'Live data' : 'Calculator'}</span>
            </div>

            <h2 class="text-lg font-bold text-[--color-ink] transition-colors group-hover:text-emerald-300">
              {tool.name}
            </h2>
            <p class="mt-2 flex-1 text-sm leading-6 text-[--color-ink-dim]">{tool.description}</p>

            <span class="mt-4 inline-flex items-center gap-1 text-xs font-bold text-emerald-400 transition-all group-hover:gap-2">
              Open tool
              <svg
                viewBox="0 0 24 24"
                class="h-3.5 w-3.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={ARROW_RIGHT}
              />
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
