---
export const prerender = false;

import { getCollection } from 'astro:content';
import ProductLayout from '../../layouts/ProductLayout.astro';
import { getDb } from '../../db/client';
import { getLatestSnapshot } from '../../server/performance';

const slug = Astro.params.slug ?? '';
const products = await getCollection('products');
const product = products.find((entry) => entry.data.slug === slug);
if (!product) return new Response(null, { status: 404 });

const related = products
  .filter(
    (entry) =>
      entry.data.slug !== product.data.slug &&
      entry.data.productCategories.some((category) => product.data.productCategories.includes(category)),
  )
  .slice(0, 3);

// Live MyFxBook figures when the collector has written some; the layout falls
// back to the transcribed editorial record when it has not.
let live = null;
try {
  live = await getLatestSnapshot(getDb(), product.data.slug);
} catch (error) {
  console.error('product_live_performance_failed', error);
}

Astro.response.headers.set('cache-control', 'public, s-maxage=300, stale-while-revalidate=600');
---

<ProductLayout product={product} related={related} live={live} />
