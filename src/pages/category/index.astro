---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RInfinityRail from '../../components/RInfinityRail.astro';
import ToolRailAds from '../../components/ToolRailAds.astro';
import { getPublicPosts } from '../../lib/content';
import { url } from '../../lib/urls';
import taxonomies from '../../data/taxonomies.json';

/**
 * Category index.
 *
 * The archives themselves are built by `[...path].astro` from the exported
 * WordPress taxonomy, which only generates a route for a category that actually
 * has posts. This page is the one place that lists them all, so a reader (and a
 * crawler) can reach every archive without walking the blog.
 */
const posts = await getPublicPosts();

const used = new Set(posts.flatMap((p) => p.data.categories ?? []));

const relPath = (path: string) =>
  String(path)
    .replace(/^https?:\/\/[^/]+/, '')
    .replace(/^\/category\//, '')
    .replace(/\/+$/, '');

const categories = (((taxonomies as any).blogCategories ?? []) as {
  name: string;
  slug: string;
  path: string;
}[])
  .filter((cat) => used.has(cat.name))
  .map((cat) => ({
    name: cat.name,
    href: url(`/category/${relPath(cat.path) || cat.slug}/`),
    count: posts.filter((p) => (p.data.categories ?? []).includes(cat.name)).length,
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const totalPosts = posts.length;
---

<BaseLayout
  title="Forex Trading Categories — Every Guide and Review by Topic"
  description="Browse every article on the site by topic: EA reviews, indicators, brokers and platforms, risk management and trading strategies."
>
  <div class="category-layout relative">
    <div class="rf-rail-slot">
      <div class="rf-rail-sticky">
        <RInfinityRail />
      </div>
    </div>

    <div class="tool-rail-slot">
      <div class="tool-rail-sticky">
        <ToolRailAds />
      </div>
    </div>

    <div class="container-x py-14">
      <nav aria-label="Breadcrumb" class="text-center text-xs text-[var(--color-ink-dim)]">
        <a href="/" class="hover:text-[var(--color-accent)]">Home</a>
        <span class="mx-2">/</span>
        <a href="/blog/" class="hover:text-[var(--color-accent)]">Blog</a>
        <span class="mx-2">/</span>
        <span class="text-[var(--color-ink-soft)]">Categories</span>
      </nav>

      <h1 class="mt-6 text-center text-3xl md:text-5xl">
        Browse by <span class="text-gradient-violet">category</span>
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-center text-sm leading-7 text-[var(--color-ink-dim)]">
        {totalPosts} articles across {categories.length} topics — every guide and review filed where you would look for it.
      </p>

      <div class="rf-inline-slot mt-10">
        <RInfinityRail variant="inline" />
      </div>

      <div class="category-grid mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {
          categories.map((cat) => (
            <a href={cat.href} class="panel group p-5 transition-colors hover:border-[var(--color-accent)]">
              <h2 class="text-base leading-snug group-hover:text-[var(--color-accent)]">{cat.name}</h2>
              <p class="mt-2 text-xs text-[var(--color-ink-dim)]">
                {cat.count} article{cat.count === 1 ? '' : 's'}
              </p>
              <p class="mt-3 text-sm text-[var(--color-accent)]">View archive →</p>
            </a>
          ))
        }
      </div>
    </div>

    <div class="tool-inline-slot">
      <ToolRailAds variant="inline" />
    </div>
  </div>
</BaseLayout>

<style>
  /*
   * Same three-column treatment as the archives: above the rail breakpoint the
   * wrapper takes the container geometry, the column is padded to 896px, and the
   * cards drop to two per row.
   */
  @media (min-width: 1740px) {
    .category-layout {
      max-width: 82rem;
      margin-inline: auto;
    }

    .category-layout > .container-x {
      max-width: none;
      padding-inline: 208px;
    }

    .category-layout .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
