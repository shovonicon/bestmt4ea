---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RInfinityRail from '../../components/RInfinityRail.astro';
import ToolRailAds from '../../components/ToolRailAds.astro';
import { getPublicPosts } from '../../lib/content';
import { url } from '../../lib/urls';
import taxonomies from '../../data/taxonomies.json';
import categoryCopy from '../../data/category-copy.json';
import { breadcrumbSchema, itemListSchema } from '../../lib/seo';
import { absoluteUrl } from '../../lib/urls';

/**
 * Blog category archives.
 *
 * WordPress categories are hierarchical (/category/parent/child/), so this
 * catch-all rebuilds the exact same paths from the exported taxonomy map
 * rather than flattening them to the category slug.
 *
 * Everything getStaticPaths needs is declared inside it, because Astro hoists
 * that function out of the component scope.
 */

export async function getStaticPaths() {
  const cats = ((taxonomies as any).blogCategories ?? []) as {
    name: string;
    slug: string;
    path: string;
  }[];

  const relPath = (path: string) =>
    String(path)
      .replace(/^https?:\/\/[^/]+/, '')
      .replace(/^\/category\//, '')
      .replace(/\/+$/, '');

  const posts = await getPublicPosts();
  const used = new Set(posts.flatMap((p) => p.data.categories ?? []));

  const usedCats = cats.filter((cat) => used.has(cat.name));

  return usedCats
    .map((cat) => ({
      params: { path: relPath(cat.path) || cat.slug },
      props: {
        catName: cat.name,
        catSlug: cat.slug,
        catPath: `/category/${relPath(cat.path) || cat.slug}/`,
        siblings: usedCats
          .filter((other) => other.slug !== cat.slug)
          .map((other) => ({ name: other.name, href: `/category/${relPath(other.path) || other.slug}/` })),
        posts: posts.filter((p) => (p.data.categories ?? []).includes(cat.name)),
      },
    }));
}

const { catName, catSlug, catPath, siblings, posts } = Astro.props;
const copy = (categoryCopy as Record<string, { description: string; intro: string }>)[catSlug];

const sorted = [...posts].sort(
  (a: any, b: any) =>
    (b.data.updatedAt ?? b.data.publishedAt).valueOf() - (a.data.updatedAt ?? a.data.publishedAt).valueOf(),
);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(d);
---

<BaseLayout
  title={`${catName} — ${sorted.length} Guides`}
  description={copy?.description ?? `Every article filed under ${catName}: practical guides and reviews on automated forex trading.`}
  jsonLd={[
    breadcrumbSchema([
      { name: "Home", url: "/" },
      { name: "Blog", url: "/blog/" },
      { name: catName, url: catPath },
    ]),
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: catName,
      description: copy?.description,
      url: absoluteUrl(catPath),
    },
    itemListSchema(
      catName,
      sorted.slice(0, 50).map((post: any) => ({ name: post.data.title, url: `/${post.data.slug}/` })),
    ),
  ]}
>
  <div class="category-layout relative">
    <div class="rf-rail-slot">
      <div class="rf-rail-sticky">
        <RInfinityRail />
      </div>
    </div>

    <div class="tool-rail-slot">
      <div class="tool-rail-sticky">
        <ToolRailAds />
      </div>
    </div>

    <div class="container-x py-14">
    <nav aria-label="Breadcrumb" class="text-center text-xs text-[var(--color-ink-dim)]">
      <a href="/" class="hover:text-[var(--color-accent)]">Home</a>
      <span class="mx-2">/</span>
      <a href="/blog/" class="hover:text-[var(--color-accent)]">Blog</a>
      <span class="mx-2">/</span>
      <span class="text-[var(--color-ink-soft)]">{catName}</span>
    </nav>

    <h1 class="mt-6 text-center text-3xl md:text-5xl"><span class="text-gradient-violet">{catName}</span></h1>
    <p class="mx-auto mt-4 max-w-2xl text-center text-sm leading-7 text-[var(--color-ink-dim)]">
      {copy?.intro ?? `${sorted.length} article${sorted.length === 1 ? '' : 's'} in this category.`}
    </p>
    <p class="mt-2 text-center text-xs text-[var(--color-ink-dim)]">
      {sorted.length} article{sorted.length === 1 ? '' : 's'} in this category.
    </p>

    <div class="rf-inline-slot mt-10">
      <RInfinityRail variant="inline" />
    </div>

    <div class="category-grid mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {
        sorted.map((post: any) => (
          <article class="panel p-5">
            <h2 class="text-base leading-snug">
              <a href={url(`/${post.data.slug}/`)} class="hover:text-[var(--color-accent)]">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-2 line-clamp-3 text-sm leading-6 text-[var(--color-ink-dim)]">{post.data.description}</p>
            <p class="mt-4 text-xs text-[var(--color-ink-dim)]">{fmt(post.data.updatedAt ?? post.data.publishedAt)}</p>
          </article>
        ))
      }
    </div>

    <nav aria-label="Other categories" class="mt-14">
      <h2 class="text-center text-lg">More categories</h2>
      <div class="mt-4 flex flex-wrap justify-center gap-2">
        {siblings.map((other: any) => (
          <a href={url(other.href)} class="badge transition-colors hover:border-[var(--color-accent)] hover:text-white">{other.name}</a>
        ))}
      </div>
    </nav>
    </div>

    <div class="tool-inline-slot">
      <ToolRailAds variant="inline" />
    </div>
  </div>
</BaseLayout>

<style>
  /*
   * Above the rail breakpoint this archive uses the blog/tools layout: the
   * wrapper takes the container geometry so the shared rail offsets land in the
   * same place, the reading column is padded in to 896px, and the cards drop to
   * two per row to make room.
   */
  @media (min-width: 1740px) {
    .category-layout {
      max-width: 82rem;
      margin-inline: auto;
    }

    .category-layout > .container-x {
      max-width: none;
      padding-inline: 208px;
    }

    .category-layout .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
