---
export const prerender = false;

import { eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDb } from '../../../db/client';
import { orders } from '../../../db/schema';
import { reconcileStripeSession } from '../../../server/payments';
import { url } from '../../../lib/urls';

/**
 * Where the buyer lands after paying.
 *
 * The Stripe webhook is the authoritative settle path, but it can arrive after
 * the customer is already back — so this re-verifies the session with Stripe
 * and settles here too. Settlement is idempotent, so whichever runs second is a
 * no-op. The free-trial path has no session and arrives with `?order=`.
 */
const session = Astro.locals.session;
if (!session || session.subjectType !== 'customer') return Astro.redirect('/login/', 303);

const db = getDb();
const sessionId = Astro.url.searchParams.get('session_id');
const requestedOrder = Astro.url.searchParams.get('order');

let paid = false;
let orderNumber: string | null = requestedOrder;

if (sessionId && env.STRIPE_SECRET_KEY) {
  const outcome = await reconcileStripeSession(db, env.STRIPE_SECRET_KEY, sessionId);
  paid = outcome.result === 'settled' || outcome.result === 'already_settled';
  if (outcome.orderId) {
    const row = await db
      .select({ orderNumber: orders.orderNumber, customerId: orders.customerId })
      .from(orders)
      .where(eq(orders.id, outcome.orderId))
      .get();
    if (row && row.customerId === session.subjectId) orderNumber = row.orderNumber;
  }
} else if (requestedOrder) {
  const row = await db.select().from(orders).where(eq(orders.orderNumber, requestedOrder)).get();
  if (row && row.customerId === session.subjectId) {
    paid = row.status === 'paid';
  } else {
    orderNumber = null;
  }
}
---

<BaseLayout title="Order status" description="Your BestMT4EA order status." noindex>
  <section class="container-x mx-auto flex min-h-[70vh] max-w-xl flex-col justify-center py-24">
    {
      paid ? (
        <>
          <p class="eyebrow">Payment received</p>
          <h1 class="mt-3 text-3xl font-bold sm:text-4xl">Thank you — your order is confirmed</h1>
          <p class="mt-4 text-base leading-7 text-[--color-ink-soft]">
            {orderNumber ? <>Order <span class="metric-value">{orderNumber}</span> is paid. </> : null}
            A receipt is on its way to your inbox.
          </p>

          <ol class="mt-8 space-y-3 text-sm leading-7 text-[--color-ink-soft]">
            <li>
              <span class="font-semibold text-[--color-ink]">1.</span> Open
              <a href={url('/dashboard/licenses')} class="text-[--color-accent]">Licences</a> in your dashboard.
            </li>
            <li>
              <span class="font-semibold text-[--color-ink]">2.</span> If you bought an expert advisor,
              activate the licence with the MT4/MT5 account number you will run it on.
            </li>
            <li>
              <span class="font-semibold text-[--color-ink]">3.</span> Download your file from
              <a href={url('/dashboard/downloads')} class="text-[--color-accent]">Downloads</a>.
            </li>
          </ol>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href={url('/dashboard/licenses')} class="btn btn-primary">Activate your licence</a>
            <a href={url('/dashboard/downloads')} class="btn btn-ghost">Go to downloads</a>
          </div>
        </>
      ) : (
        <>
          <p class="eyebrow">Order status</p>
          <h1 class="mt-3 text-3xl font-bold sm:text-4xl">We are still confirming your payment</h1>
          <p class="mt-4 text-base leading-7 text-[--color-ink-soft]">
            {orderNumber ? <>We have your order <span class="metric-value">{orderNumber}</span>, but the payment is not confirmed yet. </> : null}
            If you were charged, it will appear on your account shortly — no need to pay again.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={url('/dashboard/orders')} class="btn btn-primary">Check your orders</a>
            <a href={url('/contact')} class="btn btn-ghost">Contact support</a>
          </div>
        </>
      )
    }
  </section>
</BaseLayout>
