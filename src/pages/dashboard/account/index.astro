---
export const prerender = false;

import { eq } from 'drizzle-orm';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDb } from '../../../db/client';
import { customers } from '../../../db/schema';
import { url } from '../../../lib/urls';

const session = Astro.locals.session;
if (!session || session.subjectType !== 'customer') return Astro.redirect('/login/');

const customer = await getDb()
  .select()
  .from(customers)
  .where(eq(customers.id, session.subjectId))
  .get();
---

<BaseLayout title="Account" description="Your BestMT4EA account." noindex>
  <section class="container-x py-16">
    <p class="section-kicker">Dashboard</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">Account</h1>

    <dl class="mt-8 grid max-w-lg gap-4 text-sm">
      <div>
        <dt class="text-[--color-ink-soft]">Email</dt>
        <dd class="mt-1 text-[--color-ink]">{customer?.email ?? '—'}</dd>
      </div>
      <div>
        <dt class="text-[--color-ink-soft]">Name</dt>
        <dd class="mt-1 text-[--color-ink]">{customer?.name ?? '—'}</dd>
      </div>
      <div>
        <dt class="text-[--color-ink-soft]">Signed in since</dt>
        <dd class="mt-1 text-[--color-ink]">
          {customer?.createdAt ? customer.createdAt.toISOString().slice(0, 10) : '—'}
        </dd>
      </div>
    </dl>

    <p class="mt-8 text-sm text-[--color-ink-soft]">
      Sign-in is passwordless — you receive a one-time link by email, so there is no
      password to change here.
    </p>

    <div class="mt-8 flex gap-3 text-sm">
      <a class="rounded-lg border border-white/10 px-3 py-2" href={url('/dashboard/support')}>Support</a>
      <a class="rounded-lg border border-white/10 px-3 py-2" href="/logout/">Sign out</a>
    </div>
  </section>
</BaseLayout>
