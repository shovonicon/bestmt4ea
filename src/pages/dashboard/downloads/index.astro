---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDb } from '../../../db/client';
import { listCustomerDownloads } from '../../../server/portal';
import { url } from '../../../lib/urls';

const session = Astro.locals.session;
if (!session || session.subjectType !== 'customer') return Astro.redirect('/login/');

const downloads = await listCustomerDownloads(getDb(), session.subjectId);
const free = downloads.filter((d) => d.kind === 'free');
const licensed = downloads.filter((d) => d.kind === 'licensed');
---

<BaseLayout title="My downloads" description="Your BestMT4EA downloads." noindex>
  <section class="container-x py-16">
    <p class="section-kicker">Dashboard</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">My downloads</h1>

    <h2 class="mt-10 text-lg font-semibold">Your licensed files</h2>
    {licensed.length === 0 ? (
      <p class="mt-2 text-sm text-[--color-ink-soft]">
        Nothing here yet. Your licensed EA files appear once a licence is active.
      </p>
    ) : (
      <ul class="mt-4 flex flex-col gap-2">
        {licensed.map((d) => (
          <li class="brand-card flex items-center justify-between gap-4 rounded-xl p-4">
            <span>
              <span class="font-medium">{d.productTitle}</span>
              <span class="block text-xs text-[--color-ink-soft]">{d.filename}</span>
            </span>
            <a class="rounded-lg bg-[--color-brand] px-3 py-2 text-sm font-semibold text-black" href={`/api/download/${d.fileId}/`}>
              Download
            </a>
          </li>
        ))}
      </ul>
    )}

    <h2 class="mt-10 text-lg font-semibold">Free library</h2>
    {free.length === 0 ? (
      <p class="mt-2 text-sm text-[--color-ink-soft]">No free files available.</p>
    ) : (
      <ul class="mt-4 flex flex-col gap-2">
        {free.map((d) => (
          <li class="flex items-center justify-between gap-4 border-b border-white/5 py-3">
            <span>
              <span class="font-medium">{d.productTitle}</span>
              <span class="block text-xs text-[--color-ink-soft]">{d.filename}</span>
            </span>
            <a class="text-sm underline" href={`/api/download/${d.fileId}/`}>Download</a>
          </li>
        ))}
      </ul>
    )}

    <p class="mt-10 text-sm text-[--color-ink-soft]">
      <a class="underline" href={url('/dashboard/licenses')}>My licenses</a> ·
      <a class="underline" href={url('/dashboard')}>Dashboard</a>
    </p>
  </section>
</BaseLayout>
