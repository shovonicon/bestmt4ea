---
export const prerender = false;

import { eq } from 'drizzle-orm';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../db/client';
import { customers } from '../../db/schema';
import { listLicensesForCustomer } from '../../server/licenses';
import { listCustomerDownloads, listOrdersForCustomer } from '../../server/portal';
import { url } from '../../lib/urls';

const session = Astro.locals.session;
if (!session || session.subjectType !== 'customer') return Astro.redirect('/login/');

const db = getDb();
const customer = await db.select().from(customers).where(eq(customers.id, session.subjectId)).get();
const [licenses, downloads, orders] = await Promise.all([
  listLicensesForCustomer(db, session.subjectId),
  listCustomerDownloads(db, session.subjectId),
  listOrdersForCustomer(db, session.subjectId),
]);

const cards = [
  { label: 'Licenses', value: licenses.length, href: url('/dashboard/licenses') },
  { label: 'Downloads', value: downloads.length, href: url('/dashboard/downloads') },
  { label: 'Orders', value: orders.length, href: url('/dashboard/orders') },
];
---

<BaseLayout title="Dashboard" description="Your BestMT4EA account." noindex>
  <section class="container-x py-16">
    <p class="section-kicker">Dashboard</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">
      Welcome{customer?.name ? `, ${customer.name}` : ''}
    </h1>
    <p class="mt-3 text-base text-[--color-ink-soft]">
      Signed in as {customer?.email ?? 'your account'}.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      {cards.map((card) => (
        <a href={card.href} class="brand-card rounded-2xl p-5">
          <p class="text-3xl font-bold">{card.value}</p>
          <p class="mt-1 text-sm text-[--color-ink-soft]">{card.label}</p>
        </a>
      ))}
    </div>

    <nav class="mt-10 flex flex-wrap gap-3 text-sm">
      <a class="rounded-lg border border-white/10 px-3 py-2" href={url('/dashboard/licenses')}>My licenses</a>
      <a class="rounded-lg border border-white/10 px-3 py-2" href={url('/dashboard/downloads')}>Downloads</a>
      <a class="rounded-lg border border-white/10 px-3 py-2" href={url('/dashboard/orders')}>Orders</a>
      <a class="rounded-lg border border-white/10 px-3 py-2" href={url('/dashboard/account')}>Account</a>
      <a class="rounded-lg border border-white/10 px-3 py-2" href={url('/dashboard/support')}>Support</a>
      <a class="rounded-lg border border-white/10 px-3 py-2" href="/logout/">Sign out</a>
    </nav>
  </section>
</BaseLayout>
