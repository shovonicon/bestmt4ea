---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../lib/site';
import { url } from '../../../lib/urls';

const session = Astro.locals.session;
if (!session || session.subjectType !== 'customer') return Astro.redirect('/login/');
---

<BaseLayout title="Support" description="Get help with your BestMT4EA account." noindex>
  <section class="container-x py-16">
    <p class="section-kicker">Dashboard</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">Support</h1>
    <p class="mt-4 max-w-xl text-[--color-ink-soft]">
      Telegram is our communication channel — for a quick question, a licence issue, or an
      account change. Licensing itself stays on your account; nothing is delivered over chat.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        class="rounded-lg bg-[--color-brand] px-4 py-2 text-sm font-semibold text-black"
        href={site.telegram.support}
        rel="noopener"
        >Message us on Telegram</a
      >
      <a class="rounded-lg border border-white/10 px-4 py-2 text-sm" href="mailto:admin@bestmt4ea.com"
        >admin@bestmt4ea.com</a
      >
    </div>

    <p class="mt-10 text-sm text-[--color-ink-soft]">
      <a class="underline" href={url('/dashboard')}>Dashboard</a>
    </p>
  </section>
</BaseLayout>
