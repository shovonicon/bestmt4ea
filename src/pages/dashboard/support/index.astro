---
export const prerender = false;

import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { site } from '../../../lib/site';
import { url } from '../../../lib/urls';

const session = Astro.locals.session;
if (!session || session.subjectType !== 'customer') return Astro.redirect('/login/');

/** What we need to answer fast — support without the usual three round-trips. */
const include = [
  'Your order number (it starts with BMT-) or the licence key',
  'The MT4/MT5 account number involved, if it is about a licence',
  'What you expected and what happened instead',
  'A screenshot of the terminal, if the message is on screen',
];
---

<DashboardLayout
  active="support"
  title="Support"
  heading="Support"
  lead="Telegram is where we actually answer. Licensing and downloads stay on your account, never in a chat."
>
  <div class="grid gap-5 lg:grid-cols-[1.15fr_1fr]">
    <div class="brand-card p-6 sm:p-7">
      <p class="eyebrow">Fastest</p>
      <h2 class="mt-3 text-xl">Telegram</h2>
      <p class="mt-3 text-sm leading-7 text-[var(--color-ink-soft)]">
        Message us with your order or licence details and we will pick it up. This is also how the VPS is arranged and
        how licence changes are handled.
      </p>
      <a href={site.telegram.support} rel="noopener" class="btn btn-primary mt-6 !text-sm">
        Message us on Telegram
      </a>
      <p class="metric-value mt-4 text-xs text-[var(--color-ink-dim)]">{site.telegram.support}</p>
    </div>

    <div class="panel p-6 sm:p-7">
      <h2 class="text-lg">Email</h2>
      <p class="mt-3 text-sm leading-7 text-[var(--color-ink-soft)]">
        Better for anything with an attachment, or if you would rather not use Telegram. Expect a slower reply than
        Telegram.
      </p>
      <a href={`mailto:${site.contactEmail}`} class="btn btn-ghost mt-6 !px-5 !py-2.5 !text-sm">
        {site.contactEmail}
      </a>
    </div>
  </div>

  <div class="panel mt-5 p-6 sm:p-7">
    <h2 class="text-lg">What to include</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {
        include.map((item) => (
          <li class="flex gap-3 text-sm leading-7 text-[var(--color-ink-soft)]">
            <span
              class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-[var(--color-accent)]"
              aria-hidden="true"
            />
            {item}
          </li>
        ))
      }
    </ul>
    <p class="mt-5 border-t border-white/5 pt-5 text-sm leading-7 text-[var(--color-ink-soft)]">
      Moving a licence to a different MT5 account? Do that from{' '}
      <a href={url('/dashboard/licenses')} class="text-emerald-300 hover:text-emerald-200">
        Licences
      </a>{' '}
      and we will review it, because account changes are limited rather than unlimited.
    </p>
  </div>
</DashboardLayout>
