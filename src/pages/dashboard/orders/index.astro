---
export const prerender = false;

import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { getDb } from '../../../db/client';
import { listOrdersForCustomer } from '../../../server/portal';
import { formatUsd } from '../../../lib/money';
import { url } from '../../../lib/urls';

const session = Astro.locals.session;
if (!session || session.subjectType !== 'customer') return Astro.redirect('/login/');

const orders = await listOrdersForCustomer(getDb(), session.subjectId);
const paid = orders.filter((order) => order.status === 'paid');
const paidTotal = paid.reduce((sum, order) => sum + order.totalCents, 0);

const badgeTone = (status: string) =>
  status === 'paid'
    ? 'badge badge-accent'
    : status === 'pending'
      ? 'badge border-amber-400/30 bg-amber-400/10 text-amber-200'
      : 'badge border-red-500/40 bg-red-500/10 text-red-200';
---

<DashboardLayout
  active="orders"
  title="My orders"
  heading="Orders"
  lead="Every purchase with its receipt, so you never have to dig through email for one."
>
  {
    orders.length === 0 ? (
      <div class="panel p-7 text-center">
        <h2 class="text-lg">No orders yet</h2>
        <p class="mx-auto mt-3 max-w-lg text-sm leading-7 text-[var(--color-ink-soft)]">
          When you buy a system, its receipt and its licence land here straight away.
        </p>
        <a href={url('/shop')} class="btn btn-primary mt-6 !text-sm">
          Browse the EA library
        </a>
      </div>
    ) : (
      <>
        <p class="mb-4 text-sm text-[var(--color-ink-soft)]">
          <span class="metric-value">{paid.length}</span> paid
          {orders.length > paid.length ? ` · ${orders.length - paid.length} not completed` : ''} ·{' '}
          <span class="metric-value">{formatUsd(paidTotal)}</span> total
        </p>

        <div class="table-shell">
          <table class="data-table">
            <caption class="sr-only">Your orders, newest first</caption>
            <thead>
              <tr>
                <th scope="col">Order</th>
                <th scope="col">Placed</th>
                <th scope="col">Items</th>
                <th scope="col">Status</th>
                <th scope="col" class="text-right">Total</th>
              </tr>
            </thead>
            <tbody>
              {orders.map((order) => (
                <tr>
                  <td class="metric-value whitespace-nowrap text-xs">{order.orderNumber}</td>
                  <td class="whitespace-nowrap text-[var(--color-ink-soft)]">
                    {order.createdAt.toISOString().slice(0, 10)}
                  </td>
                  <td>
                    <ul class="flex flex-col gap-0.5">
                      {order.items.map((item) => (
                        <li class="text-[var(--color-ink-soft)]">
                          {item.quantity} × {item.title}
                        </li>
                      ))}
                    </ul>
                  </td>
                  <td>
                    <span class={badgeTone(order.status)}>{order.status}</span>
                  </td>
                  <td class="metric-value whitespace-nowrap text-right">{formatUsd(order.totalCents)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-5 text-xs leading-6 text-[var(--color-ink-dim)]">
          Something wrong with a charge? Message us from{' '}
          <a href={url('/dashboard/support')} class="text-emerald-300 hover:text-emerald-200">
            support
          </a>{' '}
          with the order number and we will sort it out.
        </p>
      </>
    )
  }
</DashboardLayout>
