---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDb } from '../../../db/client';
import { listOrdersForCustomer } from '../../../server/portal';
import { formatUsd } from '../../../lib/money';
import { url } from '../../../lib/urls';

const session = Astro.locals.session;
if (!session || session.subjectType !== 'customer') return Astro.redirect('/login/');

const orders = await listOrdersForCustomer(getDb(), session.subjectId);
---

<BaseLayout title="My orders" description="Your BestMT4EA order history." noindex>
  <section class="container-x py-16">
    <p class="section-kicker">Dashboard</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">My orders</h1>

    {orders.length === 0 ? (
      <p class="mt-6 text-[--color-ink-soft]">
        No orders yet. <a class="underline" href={url('/shop')}>Browse the shop</a>.
      </p>
    ) : (
      <div class="mt-8 flex flex-col gap-4">
        {orders.map((order) => (
          <div class="brand-card rounded-2xl p-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="font-mono text-sm">{order.orderNumber}</span>
              <span class="text-sm font-semibold">{order.status}</span>
            </div>
            <ul class="mt-3 text-sm text-[--color-ink-soft]">
              {order.items.map((item) => (
                <li>{item.quantity} × {item.title} — {formatUsd(item.unitPriceCents)}</li>
              ))}
            </ul>
            <p class="mt-2 text-sm text-[--color-ink]">
              Total {formatUsd(order.totalCents)} · {order.createdAt.toISOString().slice(0, 10)}
            </p>
          </div>
        ))}
      </div>
    )}

    <p class="mt-10 text-sm text-[--color-ink-soft]">
      <a class="underline" href={url('/dashboard')}>Dashboard</a>
    </p>
  </section>
</BaseLayout>
