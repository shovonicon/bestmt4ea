---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RISK_DISCLAIMER } from '../../lib/site';
import { getDownloadPosts } from '../../lib/content';
import { url } from '../../lib/urls';

/**
 * Free download library hub.
 *
 * Replaces the thin WordPress listing page. Reads every post carrying a
 * `download:` block, so the library maintains itself — adding an entry to
 * src/content/posts is the only step needed to publish it here.
 *
 * Filtering runs client-side over data attributes so the page stays static.
 * With no JavaScript every entry is still visible, just unfiltered.
 */
const items = await getDownloadPosts();

const kindOf = (categories: string[]) =>
  categories.some((c) => /indicator/i.test(c)) ? 'indicator' : 'ea';

const platforms = [...new Set(items.map((i) => i.data.download!.platform).filter(Boolean))] as string[];
const licences = [...new Set(items.map((i) => i.data.download!.license))];
const kinds = ['ea', 'indicator'].filter((k) => items.some((i) => kindOf(i.data.categories) === k));
const ownCount = items.filter((i) => i.data.download!.origin === 'own').length;
const osCount = items.length - ownCount;
---

<BaseLayout
  title="Free EA & Indicator Downloads — Licence-Verified Library"
  description="Download free expert advisors and indicators for MT4 and MT5. Every file lists its licence, credits the original author, and links to the source so you can verify it yourself."
>
  <section class="border-b border-[--color-line] bg-[--color-bg-soft]">
    <div class="container-x py-14">
      <p class="eyebrow">Free library</p>
      <h1 class="mt-2 text-3xl md:text-4xl">Free downloads, with the licence attached</h1>
      <p class="mt-5 max-w-3xl text-base leading-7 text-[--color-ink-soft]">
        Every tool here is either our own build or genuinely open-source software, and each entry names its licence,
        credits the original author, and links to the source. Nothing on this page is a cracked copy of someone's paid
        product — which is why you can trust what is in the file.
      </p>

      <dl class="mt-10 grid grid-cols-2 gap-6 border-t border-[--color-line] pt-8 md:grid-cols-4">
        <div>
          <dt class="metric-label">Free downloads</dt>
          <dd class="metric-value mt-2 text-3xl">{items.length}</dd>
        </div>
        <div>
          <dt class="metric-label">Open source</dt>
          <dd class="metric-value mt-2 text-3xl">{osCount}</dd>
        </div>
        <div>
          <dt class="metric-label">Our own builds</dt>
          <dd class="metric-value mt-2 text-3xl">{ownCount}</dd>
        </div>
        <div>
          <dt class="metric-label">Licences used</dt>
          <dd class="metric-value mt-2 text-3xl">{licences.length}</dd>
        </div>
      </dl>
    </div>
  </section>

  <div class="container-x py-12">
    {
      items.length === 0 ? (
        <p class="text-sm text-[--color-ink-dim]">No downloads published yet.</p>
      ) : (
        <>
          <div class="flex flex-wrap items-center gap-2" data-filters>
            <button type="button" class="badge badge-accent" data-filter="all" aria-pressed="true">
              All ({items.length})
            </button>
            {kinds.map((kind) => (
              <button type="button" class="badge" data-filter={`kind:${kind}`} aria-pressed="false">
                {kind === 'ea' ? 'Expert advisors' : 'Indicators'}
              </button>
            ))}
            {platforms.map((platform) => (
              <button type="button" class="badge" data-filter={`platform:${platform}`} aria-pressed="false">
                {platform}
              </button>
            ))}
            {licences.map((licence) => (
              <button type="button" class="badge" data-filter={`licence:${licence}`} aria-pressed="false">
                {licence}
              </button>
            ))}
          </div>

          <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3" data-items>
            {items.map((item) => {
              const download = item.data.download!;
              const kind = kindOf(item.data.categories);
              return (
                <article
                  class="panel flex flex-col p-5"
                  data-platform={download.platform ?? ''}
                  data-kind={kind}
                  data-licence={download.license}
                >
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="badge badge-accent">
                      {download.origin === 'own' ? 'Our build' : 'Open source'}
                    </span>
                    {download.platform && <span class="badge">{download.platform}</span>}
                    <span class="badge">{download.license}</span>
                  </div>

                  <h2 class="mt-4 text-base leading-snug">
                    <a href={url(`/${item.data.slug}/`)} class="hover:text-[--color-accent]">
                      {item.data.title}
                    </a>
                  </h2>

                  <p class="mt-2 flex-1 text-sm leading-6 text-[--color-ink-dim]">{item.data.description}</p>

                  <dl class="mt-5 space-y-2 border-t border-[--color-line-soft] pt-4 text-xs">
                    {download.author && (
                      <div class="flex justify-between gap-3">
                        <dt class="text-[--color-ink-dim]">Author</dt>
                        <dd class="text-right text-[--color-ink-soft]">{download.author}</dd>
                      </div>
                    )}
                    {download.version && (
                      <div class="flex justify-between gap-3">
                        <dt class="text-[--color-ink-dim]">Version</dt>
                        <dd class="metric-value text-[--color-ink-soft]">{download.version}</dd>
                      </div>
                    )}
                  </dl>

                  <a href={url(`/${item.data.slug}/#download`)} class="btn btn-primary mt-5 w-full">
                    Download
                  </a>
                </article>
              );
            })}
          </div>
        </>
      )
    }

    <section class="panel mt-12 p-6">
      <h2 class="text-lg">What we will and will not host</h2>
      <div class="mt-4 grid gap-6 md:grid-cols-2">
        <div>
          <p class="text-sm font-semibold text-[--color-ink]">We publish</p>
          <ul class="mt-3 space-y-2 text-sm leading-6 text-[--color-ink-soft]">
            <li>Our own expert advisors and indicators.</li>
            <li>Open-source tools whose licence permits redistribution, with the author credited and the source linked.</li>
            <li>Public-domain educational material.</li>
          </ul>
        </div>
        <div>
          <p class="text-sm font-semibold text-[--color-ink]">We do not publish</p>
          <ul class="mt-3 space-y-2 text-sm leading-6 text-[--color-ink-soft]">
            <li>Cracked or licence-bypassed copies of commercial products.</li>
            <li>Paid software redistributed without the developer's permission.</li>
            <li>Anything whose licence we cannot verify.</li>
          </ul>
        </div>
      </div>
      <p class="mt-5 text-xs leading-6 text-[--color-ink-dim]">
        If you own the rights to something here and believe it is listed in error, contact us and we will remove it
        promptly — see our <a href={url('/terms-conditions')} class="text-[--color-accent]">terms and takedown process</a>. A
        full licence record for every download is published on the
        <a href={url('/licences')} class="text-[--color-accent]">licence registry</a>.
      </p>
    </section>

    <p class="mt-8 text-xs leading-6 text-[--color-ink-dim]">{RISK_DISCLAIMER}</p>
  </div>

  <script is:inline>
    (() => {
      const buttons = Array.from(document.querySelectorAll('[data-filters] [data-filter]'));
      const items = Array.from(document.querySelectorAll('[data-items] > article'));
      if (!buttons.length || !items.length) return;

      const matches = (el, filter) => {
        if (filter === 'all') return true;
        const [key, value] = filter.split(':');
        if (key === 'kind') return el.dataset.kind === value;
        if (key === 'platform') return (el.dataset.platform || '') === value;
        if (key === 'licence') return el.dataset.licence === value;
        return true;
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const filter = button.dataset.filter;
          const active = button.getAttribute('aria-pressed') === 'true' && filter !== 'all';

          buttons.forEach((b) => {
            b.setAttribute('aria-pressed', 'false');
            b.classList.remove('badge-accent');
          });

          if (active) {
            const all = buttons.find((b) => b.dataset.filter === 'all');
            all.setAttribute('aria-pressed', 'true');
            all.classList.add('badge-accent');
            items.forEach((el) => (el.hidden = false));
            return;
          }

          button.setAttribute('aria-pressed', 'true');
          button.classList.add('badge-accent');
          items.forEach((el) => (el.hidden = !matches(el, filter)));
        });
      });
    })();
  </script>
</BaseLayout>
