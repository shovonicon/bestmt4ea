---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDownloadPosts } from '../../lib/content';
import { url } from '../../lib/urls';

/**
 * Licence registry.
 *
 * One page listing every downloadable item, its licence, its original author
 * and the source it was verified against. This is the strongest single trust
 * signal on the site: it proves the legal basis for everything hosted, and it
 * satisfies the attribution obligation for MIT and GPL licensed work in one
 * crawlable place.
 */
const entries = (await getDownloadPosts())
  .map((post) => ({ post, download: post.data.download! }))
  .sort((a, b) => a.post.data.title.localeCompare(b.post.data.title));

const fmt = (d?: Date) =>
  d
    ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(d)
    : '—';
---

<BaseLayout
  title="Licence Registry — Every Free Download and Its Licence"
  description="A complete record of every file available for download from this site, with its licence, original author and verification source. Nothing is hosted without a verifiable licence."
>
  <div class="container-x py-14">
    <p class="eyebrow">Compliance</p>
    <h1 class="mt-2 text-3xl md:text-4xl">Licence registry</h1>
    <p class="mt-5 max-w-3xl text-base leading-7 text-[--color-ink-soft]">
      Every item available for download from this site is listed below with its licence, its original author, and the
      source it was verified against. If a licence cannot be established, the item is not published. This page exists so
      that anyone — a reader, a developer, or a rights holder — can check the basis on which something is offered here
      without having to ask us.
    </p>

    {entries.length === 0 ? (
      <p class="mt-10 text-sm text-[--color-ink-dim]">No downloadable items are published yet.</p>
    ) : (
      <>
        <div class="mt-10 overflow-x-auto panel">
          <table class="data-table min-w-[56rem]">
            <caption class="sr-only">Licences for downloadable items</caption>
            <thead>
              <tr>
                <th scope="col">Item</th>
                <th scope="col">Type</th>
                <th scope="col">Platform</th>
                <th scope="col">Licence</th>
                <th scope="col">Original author</th>
                <th scope="col">Verified</th>
                <th scope="col">Source</th>
              </tr>
            </thead>
            <tbody>
              {entries.map(({ post, download }) => (
                <tr>
                  <td>
                    <a href={url(`/${post.data.slug}/`)} class="font-semibold text-[--color-ink] hover:text-[--color-accent]">
                      {post.data.title}
                    </a>
                  </td>
                  <td class="text-sm">{download.origin === 'own' ? 'Our own build' : 'Open source'}</td>
                  <td class="text-sm">{download.platform ?? '—'}</td>
                  <td>
                    {download.licenseUrl ? (
                      <a href={download.licenseUrl} rel="noopener nofollow" class="text-[--color-accent]">
                        {download.license}
                      </a>
                    ) : (
                      <span>{download.license}</span>
                    )}
                  </td>
                  <td class="text-sm text-[--color-ink-soft]">{download.author ?? 'BESTMT4EA'}</td>
                  <td class="text-xs text-[--color-ink-dim]">{fmt(download.updatedAt)}</td>
                  <td>
                    {download.sourceUrl ? (
                      <a href={download.sourceUrl} rel="noopener nofollow" class="text-[--color-accent] text-sm">
                        View
                      </a>
                    ) : (
                      <span class="text-xs text-[--color-ink-dim]">—</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <section class="panel mt-12 p-6">
          <h2 class="text-lg">How licences are handled here</h2>
          <dl class="mt-5 space-y-5 text-sm leading-7 text-[--color-ink-soft]">
            <div>
              <dt class="font-semibold text-[--color-ink]">MIT</dt>
              <dd class="mt-1">
                Redistribution is permitted, including commercially, provided the original copyright notice and licence
                travel with the work. We credit the author and link to the source on every entry.
              </dd>
            </div>
            <div>
              <dt class="font-semibold text-[--color-ink]">GPL-3.0</dt>
              <dd class="mt-1">
                Redistribution is permitted provided derivative works remain free under the same licence. We do not
                re-license GPL software, and we link to the project's own distribution point rather than shipping a
                modified build.
              </dd>
            </div>
            <div>
              <dt class="font-semibold text-[--color-ink]">Our own builds</dt>
              <dd class="mt-1">
                Items marked "our own build" are written and owned by us. We grant them free for personal use. They are
                not covered by a third-party licence because there is no third party.
              </dd>
            </div>
            <div>
              <dt class="font-semibold text-[--color-ink]">Not listed means not hosted</dt>
              <dd class="mt-1">
                We do not redistribute cracked, licence-bypassed, or otherwise unauthorised copies of commercial
                software. Where a product is paid, we link to the developer's own page instead of offering a file.
              </dd>
            </div>
          </dl>
        </section>

        <section class="mt-8 rounded-xl border border-[--color-line-soft] bg-[--color-bg-soft] p-6">
          <h2 class="text-base">Rights holders</h2>
          <p class="mt-2 text-sm leading-7 text-[--color-ink-soft]">
            If you own the rights to any item listed and believe it is offered here in error, contact us and we will
            remove it promptly while we review. Our takedown process is set out in our
            <a href={url('/terms-conditions')} class="text-[--color-accent]">terms</a>.
          </p>
        </section>
      </>
    )}
  </div>
</BaseLayout>
