---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { monthYear } from '../../lib/dates';
import { getPublicPosts } from '../../lib/content';
import { url, absoluteUrl } from '../../lib/urls';
import { breadcrumbSchema, itemListSchema } from '../../lib/seo';
import taxonomies from '../../data/taxonomies.json';
import RInfinityRail from '../../components/RInfinityRail.astro';
import ToolRailAds from '../../components/ToolRailAds.astro';
import PostCard from '../../components/PostCard.astro';

const posts = await getPublicPosts();

const categories = [...new Set(posts.flatMap((p) => p.data.categories ?? []))].sort();

/* Each category name links to its archive page, built from the same taxonomy map as /category/. */
const categoryHref = new Map<string, string>(
  ((taxonomies as any).blogCategories ?? []).map((c: any): [string, string] => [
    c.name,
    url(`/${String(c.path).replace(/^https?:\/\/[^/]+/, '').replace(/^\/+/, '').replace(/\/+$/, '')}/`),
  ]),
);

/* Estimated reading time from the post body, at roughly 230 words a minute. */
const readTime = (body: string) =>
  `${Math.max(1, Math.round(body.split(/\s+/).filter(Boolean).length / 230))} min read`;

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(d);
---

<BaseLayout
  title={`Forex Trading Blog ${monthYear}: MT4/MT5 Guides`}
  description="Practical guides on automated forex trading: how EAs work, how to test them on demo, how to read a drawdown and how to avoid costly traps."
  jsonLd={[
    breadcrumbSchema([
      { name: 'Home', url: '/' },
      { name: 'Blog', url: '/blog/' },
    ]),
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Forex Trading Blog',
      url: absoluteUrl('/blog/'),
    },
    itemListSchema(
      'Forex Trading Blog',
      posts.slice(0, 50).map((post) => ({ name: post.data.title, url: `/${post.data.slug}/` })),
    ),
  ]}
>
  <div class="blog-layout relative">
    <div class="rf-rail-slot">
      <div class="rf-rail-sticky">
        <RInfinityRail />
      </div>
    </div>

    <div class="tool-rail-slot">
      <div class="tool-rail-sticky">
        <ToolRailAds />
      </div>
    </div>

    <div class="container-x py-14">
      <p class="eyebrow tone-violet text-center">Learn</p>
      <h1 class="mt-2 text-center text-3xl md:text-5xl">Forex trading <span class="text-gradient-violet">blog</span></h1>
      <p class="mx-auto mt-4 max-w-2xl text-center text-sm leading-7 text-[var(--color-ink-dim)]">
        Everything here is written to solve a specific problem — testing a robot properly, reading a drawdown, sizing a
        position, or spotting a system that will not survive a real account.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-2">
        {categories.slice(0, 12).map((cat) => (
          <a href={categoryHref.get(cat) ?? url('/blog/')} class="badge transition-colors hover:border-[var(--color-accent)] hover:text-white">{cat}</a>
        ))}
      </div>

      <div class="mt-4 text-center">
        <a
          href={url('/category/')}
          class="text-xs text-[var(--color-ink-dim)] underline-offset-4 transition-colors hover:text-[var(--color-accent)] hover:underline"
        >
          Browse all {categories.length} categories &rarr;
        </a>
      </div>

      <div class="rf-inline-slot mt-10">
        <RInfinityRail variant="inline" />
      </div>

      <div class="blog-grid mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {
          posts.map((post) => <PostCard post={post} />)
        }
      </div>
    </div>

    <div class="tool-inline-slot">
      <ToolRailAds variant="inline" />
    </div>
  </div>
</BaseLayout>

<style>
  /* In the flow, both ad slots keep the page gutter instead of running edge to edge. */
  .blog-layout > .tool-inline-slot {
    width: 100%;
    max-width: 82rem;
    margin-inline: auto;
    padding-inline: 1rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .blog-layout > .tool-inline-slot {
      padding-inline: 2rem;
    }
  }

  /*
   * Above the rail breakpoint this page uses the tool-page pattern: wrapper at the
   * container geometry so the rail offsets are the same arithmetic, absolute rails
   * stretched to the wrapper height, and 208px of section padding either side so
   * the column is the same 896px the tool pages use.
   */
  @media (min-width: 1740px) {
    .blog-layout {
      max-width: 82rem;
      margin-inline: auto;
    }

    .blog-layout > .rf-rail-slot {
      position: absolute;
      top: 0;
      bottom: 0;
      display: block;
      width: 320px;
      left: calc(272px - 25vw);
    }

    .blog-layout > .tool-rail-slot {
      position: absolute;
      top: 0;
      bottom: 0;
      display: block;
      width: 320px;
      right: calc(272px - 25vw);
    }

    .blog-layout > .rf-rail-slot > .rf-rail-sticky,
    .blog-layout > .tool-rail-slot > .tool-rail-sticky {
      position: sticky;
      top: var(--rail-top);
    }

    .blog-layout > .container-x {
      max-width: none;
      padding-inline: 208px;
    }

    /* Two posts per row once the rails take their space. */
    .blog-layout .blog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
