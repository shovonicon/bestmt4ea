---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { monthYear } from '../../lib/dates';
import { getPublicPosts } from '../../lib/content';
import { url } from '../../lib/urls';

const posts = await getPublicPosts();

const categories = [...new Set(posts.flatMap((p) => p.data.categories ?? []))].sort();

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(d);
---

<BaseLayout
  title={`Forex Trading Blog ${monthYear} — Guides, Reviews and MT4/MT5 Tutorials`}
  description="Practical guides on automated forex trading: how expert advisors work, how to test them on demo, how to read a drawdown, and how to avoid the traps that cost retail traders money."
>
  <div class="container-x py-14">
    <p class="eyebrow tone-violet text-center">Learn</p>
    <h1 class="mt-2 text-center text-3xl md:text-5xl">Forex trading <span class="text-gradient-violet">blog</span></h1>
    <p class="mx-auto mt-4 max-w-2xl text-center text-sm leading-7 text-[var(--color-ink-dim]">
      Everything here is written to solve a specific problem — testing a robot properly, reading a drawdown, sizing a
      position, or spotting a system that will not survive a real account.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-2">
      {categories.slice(0, 12).map((cat) => <span class="badge">{cat}</span>)}
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {
        posts.map((post) => (
          <article class="panel p-5">
            {post.data.categories?.[0] && <p class="eyebrow">{post.data.categories[0]}</p>}
            <h2 class="mt-2 text-base leading-snug">
              <a href={url(`/${post.data.slug}/`)} class="hover:text-[var(--color-accent]">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-2 line-clamp-3 text-sm leading-6 text-[var(--color-ink-dim]">{post.data.description}</p>
            <p class="mt-4 text-xs text-[var(--color-ink-dim]">{fmt(post.data.updatedAt ?? post.data.publishedAt)}</p>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>
