---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparisonRegistry from '../../components/ComparisonRegistry.astro';
import { RISK_DISCLAIMER } from '../../lib/site';
import { getPublicProducts } from '../../lib/content';
import { url } from '../../lib/urls';

/**
 * Platform hub (/brand/mt4, /brand/mt5).
 *
 * Rebuilds the WooCommerce `product_brand` taxonomy archive, which is a live
 * indexed URL on the current site.
 */

export async function getStaticPaths() {
  const brands = ['mt4', 'mt5'];
  return brands.map((brand) => ({ params: { brand } }));
}

const { brand } = Astro.params;
const label = brand!.toUpperCase();

const all = await getPublicProducts();
const products = all.filter((p) => p.data.brands.some((b) => b.toLowerCase() === label.toLowerCase()));
---

<BaseLayout
  title={`${label} Expert Advisors — Verified MT${label === 'MT4' ? '4' : '5'} Robots`}
  description={`Every MetaTrader ${label === 'MT4' ? '4' : '5'} expert advisor in our library, ranked by verified monthly return with maximum drawdown shown alongside.`}
>
  <div class="container-x py-14">
    <nav aria-label="Breadcrumb" class="text-center text-xs text-[var(--color-ink-dim]">
      <a href="/" class="hover:text-[var(--color-accent]">Home</a>
      <span class="mx-2">/</span>
      <a href={url('/shop')} class="hover:text-[var(--color-accent]">Shop</a>
      <span class="mx-2">/</span>
      <span class="text-[var(--color-ink-soft]">{label}</span>
    </nav>

    <p class="eyebrow tone-sky mt-6 text-center">Platform</p>
    <h1 class="mt-2 text-center text-3xl md:text-5xl">
      <span class="text-gradient-aurora">{label}</span> expert advisors
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-center text-sm leading-7 text-[var(--color-ink-dim]">
      {products.length} system{products.length === 1 ? '' : 's'} built for MetaTrader {label === 'MT4' ? '4' : '5'}.
    </p>

    <div class="mt-10">
      {
        products.length > 0 ? (
          <ComparisonRegistry products={products} />
        ) : (
          <p class="text-sm text-[var(--color-ink-dim]">No systems listed yet.</p>
        )
      }
    </div>

    <p class="mt-6 text-xs leading-6 text-[var(--color-ink-dim]">{RISK_DISCLAIMER}</p>
  </div>
</BaseLayout>
