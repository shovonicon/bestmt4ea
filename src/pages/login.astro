---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';

const sent = Astro.url.searchParams.get('sent') === '1';
const error = Astro.url.searchParams.get('error');
const errorText =
  error === 'csrf'
    ? 'That request could not be verified. Please try again.'
    : error === 'rate'
      ? 'Too many sign-in attempts. Please wait a few minutes and try again.'
      : error === 'email'
        ? 'Please enter a valid email address.'
        : error === 'link'
          ? 'That sign-in link is invalid or has expired. Request a new one.'
          : null;
---

<BaseLayout title="Sign in" description="Sign in to your BestMT4EA account." noindex>
  <section class="container-x mx-auto flex min-h-[70vh] max-w-xl flex-col justify-center py-24">
    <p class="section-kicker">Account</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">Sign in to BestMT4EA</h1>
    <p class="mt-4 text-base leading-7 text-[--color-ink-soft]">
      Enter your email and we&rsquo;ll send a one-time sign-in link. No password to remember.
    </p>

    {sent && (
      <p class="mt-6 rounded-xl border border-[--color-brand]/40 bg-[--color-brand]/10 px-4 py-3 text-sm text-[--color-ink]">
        Check your inbox — if that address has an account, a sign-in link is on its way.
      </p>
    )}
    {errorText && (
      <p class="mt-6 rounded-xl border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200">
        {errorText}
      </p>
    )}

    <form method="post" action="/auth/request/" class="mt-8 flex flex-col gap-3">
      <input type="hidden" name="csrf" value={Astro.locals.csrfToken} />
      <label class="text-sm font-medium text-[--color-ink-soft]" for="email">Email address</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
        class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-base text-[--color-ink] outline-none focus:border-[--color-brand]"
      />
      <button
        type="submit"
        class="btn-brand mt-2 rounded-xl bg-[--color-brand] px-5 py-3 font-semibold text-black transition hover:brightness-110"
      >
        Email me a sign-in link
      </button>
    </form>

    <p class="mt-6 text-sm text-[--color-ink-soft]">
      New here? The same form creates your account on first sign-in.
    </p>
  </section>
</BaseLayout>
