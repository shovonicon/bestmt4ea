---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/urls';
import { site } from '../lib/site';
import { env } from 'cloudflare:workers';

/**
 * The sign-in gate.
 *
 * One field and one action: enter an email, get a one-time link. The left column
 * exists to answer "what does signing in actually get me", because a bare email
 * box gives a first-time visitor no reason to hand over an address.
 */
const sent = Astro.url.searchParams.get('sent') === '1';
const signedOut = Astro.url.searchParams.get('signedout') === '1';
const error = Astro.url.searchParams.get('error');

const errorText: Record<string, string> = {
  csrf: 'That request could not be verified. Please try again.',
  rate: 'Too many sign-in attempts. Please wait a few minutes and try again.',
  email: 'That email address does not look right. Check it and try again.',
  link: 'That sign-in link has expired or was already used. Request a new one below.',
  google: 'Google sign-in did not complete. Try again, or use the email link below.',
  turnstile: 'The security check did not pass. Please try again.',
};
const message = error ? (errorText[error] ?? null) : null;

// Only offer Google when the Worker actually holds credentials — a button that
// cannot work is worse than no button.
const googleEnabled = Boolean(env.GOOGLE_CLIENT_ID && env.GOOGLE_CLIENT_SECRET);

const included = [
  {
    title: 'Your licensed downloads',
    body: 'A paid EA appears once its licence is active and your build — compiled for your account number and expiry — is attached.',
  },
  {
    title: 'Licences and bound accounts',
    body: 'See each licence, the MT4/MT5 account it is bound to, and when it runs out.',
  },
  {
    title: 'Orders in one place',
    body: 'Every purchase with its receipt, so you never dig through email for it.',
  },
];
---

<BaseLayout
  title="Sign in"
  description="Sign in to your BestMT4EA account with a one-time email link — no password to remember."
  noindex
>
  <section class="relative overflow-hidden border-b border-white/5">
    <div
      class="glow-orb animate-aurora left-1/2 top-[-16rem] h-[26rem] w-[38rem] -translate-x-1/2 bg-emerald-500/25"
    >
    </div>
    <div class="grid-overlay pointer-events-none absolute inset-0"></div>

    <div class="container-x relative z-10 flex min-h-[68vh] items-center py-16 lg:py-24">
      <div class="mx-auto grid w-full max-w-5xl gap-12 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-20">
        <!-- The pitch: what signing in actually gets you. -->
        <div class="animate-fade-in-up text-center lg:text-left">
          <span
            class="eyebrow inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-4 py-2"
          >
            <span class="live-dot"></span>Account access
          </span>

          <h1 class="mt-6 text-balance text-4xl font-bold leading-[1.08] tracking-tight sm:text-5xl">
            Your licences and downloads, <span class="text-gradient-brand">in one place</span>
          </h1>

          <p class="mx-auto mt-6 max-w-xl text-base leading-8 text-[var(--color-ink-soft)] lg:mx-0">
            No password to remember. Enter your email and we send a one-time sign-in link — the same form creates your
            account the first time you use it.
          </p>

          <dl class="mx-auto mt-10 grid max-w-xl gap-5 lg:mx-0">
            {
              included.map((item, index) => (
                <div class="flex gap-4 text-left">
                  <span
                    class="metric-value mt-0.5 flex h-7 w-7 flex-none items-center justify-center rounded-full border border-emerald-400/25 bg-emerald-400/10 text-xs text-[var(--color-accent-soft)]"
                    aria-hidden="true"
                  >
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <dt class="text-sm font-semibold text-[var(--color-ink)]">{item.title}</dt>
                    <dd class="mt-1 text-sm leading-7 text-[var(--color-ink-dim)]">{item.body}</dd>
                  </div>
                </div>
              ))
            }
          </dl>
        </div>

        <!-- The gate: one field, one action. -->
        <div class="animate-fade-in-up-delay-2">
          <div class="brand-card p-6 shadow-glow sm:p-8">
            {
              sent ? (
                <div class="text-center">
                  <span
                    class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-emerald-400/30 bg-emerald-400/10"
                    aria-hidden="true"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      class="h-6 w-6 stroke-[var(--color-accent-soft)]"
                      stroke-width="2"
                    >
                      <path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round" />
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                    </svg>
                  </span>
                  <h2 class="mt-5 text-xl">Check your inbox</h2>
                  <p class="mt-3 text-sm leading-7 text-[var(--color-ink-soft)]">
                    If that address has an account, a sign-in link is on its way. It works once and expires within the
                    hour.
                  </p>
                  <p class="mt-2 text-xs leading-6 text-[var(--color-ink-dim)]">
                    Nothing after a few minutes? Check the spam folder, then request another link.
                  </p>
                  <a href={url('/login')} class="btn btn-ghost mt-7 w-full">Use a different email</a>
                </div>
              ) : (
                <>
                  <p class="section-kicker">{signedOut ? 'Signed out' : 'Sign in'}</p>
                  <h2 class="mt-2 text-2xl">{signedOut ? 'You are signed out' : 'Welcome back'}</h2>
                  <p class="mt-2 text-sm leading-7 text-[var(--color-ink-soft)]">
                    {signedOut
                      ? 'That session is closed and its link is dead. Sign in again whenever you need your licences, or pick up where you left off in the library.'
                      : 'We\u2019ll email you a one-time link. No password, nothing to remember.'}
                  </p>

                  {signedOut && (
                    <div class="mt-6 flex flex-wrap gap-3">
                      <a href={url('/dashboard')} class="btn btn-ghost !px-5 !py-2.5 !text-xs">
                        Account dashboard
                      </a>
                      <a href={url('/shop')} class="btn btn-ghost !px-5 !py-2.5 !text-xs">
                        Browse the library
                      </a>
                    </div>
                  )}

                  {message && (
                    <p
                      role="alert"
                      class="mt-6 rounded-xl border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm leading-6 text-red-200"
                    >
                      {message}
                    </p>
                  )}

                  {
                    googleEnabled && (
                      <>
                        <a href="/auth/google/" class="btn btn-ghost mt-6 w-full !py-3.5">
                          <svg viewBox="0 0 48 48" class="h-[18px] w-[18px]" aria-hidden="true">
                            <path
                              fill="#EA4335"
                              d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
                            />
                            <path
                              fill="#4285F4"
                              d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
                            />
                            <path
                              fill="#FBBC05"
                              d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
                            />
                            <path
                              fill="#34A853"
                              d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
                            />
                          </svg>
                          Continue with Google
                        </a>
                        <p
                          class="mt-5 flex items-center gap-3 text-[0.6875rem] uppercase tracking-[0.18em] text-[var(--color-ink-dim)]"
                        >
                          <span class="h-px flex-1 bg-white/10"></span>
                          or
                          <span class="h-px flex-1 bg-white/10"></span>
                        </p>
                      </>
                    )
                  }

                  {
                    site.turnstileSiteKey && (
                      <script
                        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
                        async
                        defer
                      >
                      </script>
                    )
                  }

                  <form method="post" action="/auth/request/" class="mt-5 flex flex-col gap-5">
                    <input type="hidden" name="csrf" value={Astro.locals.csrfToken} />

                    <div>
                      <label for="email" class="metric-label">Email address</label>
                      <input
                        id="email"
                        name="email"
                        type="email"
                        required
                        autocomplete="email"
                        inputmode="email"
                        spellcheck="false"
                        placeholder="you@example.com"
                        aria-describedby="email-hint"
                        class="mt-2 w-full rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-base text-[var(--color-ink)] placeholder:text-[var(--color-ink-dim)] transition-colors focus:border-[var(--color-accent)] focus:bg-white/[0.06]"
                      />
                      <p id="email-hint" class="mt-2 text-xs leading-6 text-[var(--color-ink-dim)]">
                        Used only to sign you in and to reach you about your licences.
                      </p>
                    </div>

                    {
                      site.turnstileSiteKey && (
                        <div
                          class="cf-turnstile"
                          data-sitekey={site.turnstileSiteKey}
                          data-theme="dark"
                        >
                        </div>
                      )
                    }

                    <button type="submit" class="btn btn-primary w-full !py-3.5 !text-base">
                      Email me a sign-in link
                    </button>
                  </form>

                  <p class="mt-6 border-t border-white/5 pt-5 text-center text-xs leading-6 text-[var(--color-ink-dim)]">
                    New here? The same form creates your account. By continuing you agree to the{' '}
                    <a href={url('/terms-conditions')} class="text-[var(--color-ink-soft)] underline decoration-white/20">
                      terms
                    </a>{' '}
                    and{' '}
                    <a href={url('/privacy-policy')} class="text-[var(--color-ink-soft)] underline decoration-white/20">
                      privacy policy
                    </a>.
                  </p>
                </>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
