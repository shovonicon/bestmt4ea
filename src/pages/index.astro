---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import ComparisonRegistry from '../components/ComparisonRegistry.astro';
import Faq from '../components/Faq.astro';
import SectionHead from '../components/SectionHead.astro';
import CountUp from '../components/CountUp.astro';
import { getPerformance } from '../lib/performance';
import { site, RISK_DISCLAIMER } from '../lib/site';
import { organizationSchema, websiteSchema, faqSchema } from '../lib/seo';
import { monthYear, performanceVerifiedAt } from '../lib/dates';
import { formatDate } from '../lib/format';
import { getPublicProducts } from '../lib/content';
import { url } from '../lib/urls';
import siteStats from '../data/site-stats.json';

const products = await getPublicProducts();

const withPerf = products.map((product) => ({ product, perf: getPerformance(product.data.slug) }));

const ranked = [...withPerf].sort(
  (a, b) => (b.perf?.totalGainPct ?? -Infinity) - (a.perf?.totalGainPct ?? -Infinity),
);

const featured = ranked.slice(0, 6).map((r) => r.product);

// Real counts only — never a counter we cannot source.
const trackedCount = withPerf.filter((r) => r.perf?.verified).length;
const liveCount = withPerf.filter((r) => r.perf?.accountType === 'real').length;

const stats = [
  { label: 'Expert advisors', value: String(products.length), count: true },
  { label: 'Third-party tracked', value: String(trackedCount), count: true },
  { label: 'Live-traded', value: String(liveCount), count: true },
  { label: 'Operating since', value: String(siteStats.since), count: false },
];

const pillars = [
  {
    title: 'Transparency first',
    body: 'Every performance figure links to the third-party account behind it. If a system runs on demo funds, the page says so plainly instead of calling it live.',
  },
  {
    title: 'Risk shown with return',
    body: 'Drawdown, profit factor and trade counts sit next to gain percentages. A system that returns 80% at 80% drawdown is described as one — not marketed as 80%.',
  },
  {
    title: 'Support that answers',
    body: 'Installation, preset configuration and troubleshooting run through the community Telegram, so you are never left alone with a compiled file.',
  },
];

const payments = [
  { src: '/media/payments/visa.svg', label: 'Visa' },
  { src: '/media/payments/mastercard.svg', label: 'Mastercard' },
  { src: '/media/payments/stripe.svg', label: 'Stripe' },
  { src: '/media/payments/tether.svg', label: 'USDT (TRC20)' },
];

const faqs = [
  {
    question: 'Are the trading results on this site real?',
    answer:
      'Every performance figure links to the third-party tracking account it came from, so you can verify it yourself. Where an account is a demo rather than live funds, the page says so. Past performance does not guarantee future results.',
  },
  {
    question: 'What do I receive after I buy a licence?',
    answer:
      'The compiled expert advisor, a setup guide, the recommended broker and account configuration, and the default risk settings. Everything is delivered to your BestMT4EA dashboard after checkout, with Telegram support if you get stuck.',
  },
  {
    question: 'Can I test a system before buying a license?',
    answer:
      'Yes. Most products include a free 30-day trial tier so you can run the system on a demo account and compare its behaviour with the published track record before committing.',
  },
  {
    question: 'Do I need a VPS to run an expert advisor?',
    answer:
      'A VPS is strongly recommended. Automated systems need the MetaTrader terminal running continuously, so hosting it near your broker\u2019s server avoids downtime and reduces execution latency.',
  },
  {
    question: 'Which brokers do your systems run on?',
    answer:
      'They run on any MetaTrader 4 or MetaTrader 5 broker. Low-spread ECN accounts perform best because the strategies are sensitive to execution cost. We publish the two brokers our own systems are tested on.',
  },
  {
    question: 'Can I use these systems on a prop firm account?',
    answer:
      'Several systems include presets with drawdown cut-offs and news filters suited to funded-account rules. Always check your firm\u2019s policy on automated trading before you start a challenge.',
  },
];
---

<BaseLayout
  title={`Best MT4 & MT5 Expert Advisors ${monthYear} — Myfxbook Verified`}
  description={site.description}
  ogImage="/media/products/forex-windows-vps.png"
  jsonLd={[organizationSchema(), websiteSchema(), faqSchema(faqs)]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="glow-orb animate-aurora left-1/2 top-[-12rem] h-[26rem] w-[38rem] -translate-x-1/2 bg-emerald-500/25"
    ></div>
    <div class="glow-orb animate-float right-[-6rem] top-[6rem] h-[18rem] w-[18rem] bg-teal-400/10"></div>
    <div class="grid-overlay pointer-events-none absolute inset-0"></div>
    <div class="container-x relative flex min-h-[62vh] flex-col items-center justify-center py-20 text-center lg:py-28">
      <span
        class="eyebrow animate-fade-in-up inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-4 py-2"
      >
        <span class="live-dot"></span>Verified performance · checked {formatDate(performanceVerifiedAt)}
      </span>

      <h1
        class="animate-fade-in-up-delay-1 mt-6 max-w-5xl text-4xl font-bold leading-[1.08] tracking-tight sm:text-5xl lg:text-7xl"
      >
        Forex expert advisors, with the <span class="text-gradient-brand">track record</span> attached
      </h1>

      <p
        class="animate-fade-in-up-delay-2 mt-6 max-w-3xl text-base leading-8 text-[var(--color-ink-soft] sm:text-lg"
      >
        Every system here links to its live third-party account, so you can check the drawdown as easily as the returns
        before you spend anything. No hidden curves, no cherry-picked months.
      </p>

      <div class="animate-fade-in-up-delay-3 mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href={url('/shop')} class="btn btn-primary !px-7 !py-3.5 !text-base">Browse the EA library</a>
        <a href={url('/top-ranking')} class="btn btn-ghost !px-6 !py-3.5 !text-base">See the full ranking</a>
        <a href={site.telegram.community} rel="noopener" class="btn btn-ghost !px-6 !py-3.5 !text-base">
          Join the community
        </a>
      </div>

      <div
        class="animate-fade-in-up-delay-3 mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-[var(--color-ink-dim]"
      >
        <span class="inline-flex items-center gap-2">
          <span>{siteStats.customers} customers</span>
        </span>
        <span>{products.length} systems</span>
        <span>{trackedCount} third-party tracked</span>
        <span>Since {siteStats.since}</span>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="container-x pb-20">
    <div class="stats-panel reveal">
      {
        stats.map((stat) => (
          <div class="stats-panel-item">
            <div class="mb-3 flex items-center justify-center gap-2">
              <span class="live-dot" />
              <span class="metric-label">{stat.label}</span>
            </div>
            <div class="display-stat text-2xl sm:text-3xl">
              {stat.count ? <CountUp value={stat.value} /> : stat.value}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Pillars -->
  <section class="border-t border-white/5" aria-labelledby="pillars-heading">
    <div class="container-x py-20 lg:py-28">
      <SectionHead
        align="center"
        kicker="Why this library"
        title="Built and traded by the person who writes the code"
        lead="No outsourced reviews and no affiliate-only rankings. Every system is developed, forward-tested and supported in-house before it is listed here."
        id="pillars-heading"
      />

      <div class="mt-14 grid gap-6 lg:grid-cols-3">
        {
          pillars.map((pillar) => (
            <div class="hover-brand-card reveal p-8">
              <h3 class="text-lg font-bold text-emerald-400">{pillar.title}</h3>
              <p class="mt-3 text-sm leading-7 text-[var(--color-ink-dim]">{pillar.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Ranking -->
  <section class="border-t border-white/5" aria-labelledby="ranking-heading">
    <div class="container-x py-20 lg:py-28">
      <SectionHead
        align="center"
        kicker="Comparison registry"
        title="Top systems by verified gain"
        lead="Ranked on third-party tracked performance, with the pair, platform, monthly return and drawdown shown for every system and the check date stated."
        id="ranking-heading"
      />

      <div class="reveal mt-10">
        <ComparisonRegistry products={ranked.slice(0, 10).map((entry) => entry.product)} />
      </div>

      <p class="mt-4 text-center text-xs text-[var(--color-ink-dim]">
        Third-party figures checked {formatDate(performanceVerifiedAt)} · a demo account is labelled as a demo on every
        row.
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-center text-xs leading-6 text-[var(--color-ink-dim]">{RISK_DISCLAIMER}</p>
      <div class="mt-8 flex justify-center">
        <a href={url('/top-ranking')} class="btn btn-primary">See the full ranking</a>
      </div>
    </div>
  </section>

  <!-- Store -->
  <section class="border-t border-white/5 bg-zinc-950/20" aria-labelledby="store-heading">
    <div class="container-x py-20 lg:py-28">
      <SectionHead
        align="center"
        kicker="The EA directory"
        title="Choose the system that fits your account"
        lead="Ten systems publish their licence price up front. Each licence includes the compiled expert advisor, a setup guide, the recommended broker and account type, and default risk settings."
        id="store-heading"
      />

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((product) => <ProductCard product={product} />)}
      </div>

      <div class="mt-10 flex justify-center">
        <a href={url('/shop')} class="btn btn-primary">See all {products.length} systems</a>
      </div>
    </div>
  </section>

  <!-- Secure checkout -->
  <section class="border-t border-white/5">
    <div class="container-x py-20 lg:py-28">
      <div class="brand-card reveal overflow-hidden p-8 sm:p-12">
        <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
          <div class="max-w-2xl">
            <span class="eyebrow inline-flex items-center gap-2">
              <span class="live-dot"></span>Checkout
            </span>
            <h2 class="mt-4 text-2xl font-bold sm:text-3xl">Pay once, delivered to your dashboard</h2>
            <p class="mt-3 text-sm leading-7 text-[var(--color-ink-dim]">
              Card and USDT (TRC20) are both accepted. Checkout is handled by Stripe — card details never touch this
              site — and your licence, download and activation land in your BestMT4EA account. Setup help is a Telegram
              message away.
            </p>
            <div class="mt-6 flex flex-wrap items-center gap-2">
              {
                payments.map((method) => (
                  <span class="brand-chip" title={method.label}>
                    <img src={method.src} alt={method.label} width="24" height="24" loading="lazy" decoding="async" />
                  </span>
                ))
              }
            </div>
          </div>
          <div class="shrink-0">
            <a href={url('/shop')} class="btn btn-primary">Browse licences</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="border-t border-white/5 bg-zinc-950/20" aria-labelledby="next-heading">
    <div class="container-x py-20 lg:py-28">
      <SectionHead
        align="center"
        kicker="Next step"
        title="Where do you want to start?"
        lead="Compare every system side by side, pick a licence, or choose the broker to run it on."
        id="next-heading"
      />
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        <a href={url('/top-ranking')} class="hover-brand-card reveal flex flex-col p-8">
          <h3 class="text-lg font-bold text-[var(--color-ink]">Compare all {products.length} systems</h3>
          <p class="mt-3 flex-1 text-sm leading-7 text-[var(--color-ink-dim]">
            Monthly return, drawdown, total gain, account type and licence price in one table.
          </p>
          <span class="mt-6 text-sm font-semibold text-[var(--color-accent]">Open the ranking →</span>
        </a>
        <a href={url('/shop')} class="hover-brand-card reveal flex flex-col p-8">
          <h3 class="text-lg font-bold text-[var(--color-ink]">Browse the EA library</h3>
          <p class="mt-3 flex-1 text-sm leading-7 text-[var(--color-ink-dim]">
            Every licence with its price, specs and tracked record, filterable by platform.
          </p>
          <span class="mt-6 text-sm font-semibold text-[var(--color-accent]">Open the shop →</span>
        </a>
        <a href={url('/best-forex-brokers')} class="hover-brand-card reveal flex flex-col p-8">
          <h3 class="text-lg font-bold text-[var(--color-ink]">Choose a broker</h3>
          <p class="mt-3 flex-1 text-sm leading-7 text-[var(--color-ink-dim]">
            Regulation, minimum deposit, platforms and account types for the brokers we test on.
          </p>
          <span class="mt-6 text-sm font-semibold text-[var(--color-accent]">Compare brokers →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-white/5">
    <div class="container-x py-20">
      <div class="mx-auto max-w-3xl">
        <Faq items={faqs} heading="Frequently asked questions" />
      </div>
    </div>
  </section>
</BaseLayout>
