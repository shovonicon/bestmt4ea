---
export const prerender = false;

import { sql } from 'drizzle-orm';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../db/client';
import { cryptoPayments, customers, licenseBuilds, licenses, orders } from '../../db/schema';
import { requireAdminMfa } from '../../server/admin-auth';
import { formatUsd } from '../../lib/money';
import { url } from '../../lib/urls';

const session = Astro.locals.session;
if (!requireAdminMfa(session)) return Astro.redirect('/admin/login/');

const db = getDb();

const customersN = (await db.select({ n: sql<number>`count(*)` }).from(customers).get())?.n ?? 0;
const activeLicenses =
  (await db.select({ n: sql<number>`count(*)` }).from(licenses).where(sql`status = 'ACTIVE'`).get())?.n ?? 0;
const pendingBuilds =
  (await db.select({ n: sql<number>`count(*)` }).from(licenseBuilds).where(sql`build_status = 'PENDING'`).get())?.n ?? 0;
const waitingUsdt =
  (await db.select({ n: sql<number>`count(*)` }).from(cryptoPayments).where(sql`status = 'WAITING'`).get())?.n ?? 0;
const paidOrders =
  (await db.select({ n: sql<number>`count(*)` }).from(orders).where(sql`status = 'paid'`).get())?.n ?? 0;
const revenueCents =
  (await db.select({ n: sql<number>`coalesce(sum(total_cents), 0)` }).from(orders).where(sql`status = 'paid'`).get())?.n ?? 0;

const kpis = [
  { label: 'Customers', value: String(customersN) },
  { label: 'Active licenses', value: String(activeLicenses) },
  { label: 'Paid orders', value: String(paidOrders) },
  { label: 'Revenue', value: formatUsd(revenueCents) },
  { label: 'Pending builds', value: String(pendingBuilds) },
  { label: 'USDT waiting', value: String(waitingUsdt) },
];

const nav = [
  ['Licenses', '/admin/licenses'],
  ['Orders', '/admin/orders'],
  ['Payments', '/admin/payments'],
  ['Builds', '/admin/builds'],
  ['Customers', '/admin/customers'],
];
---

<BaseLayout title="Admin" description="Admin dashboard." noindex>
  <section class="container-x py-16">
    <p class="section-kicker">Admin</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">Dashboard</h1>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {kpis.map((kpi) => (
        <div class="brand-card rounded-2xl p-5">
          <p class="text-3xl font-bold">{kpi.value}</p>
          <p class="mt-1 text-sm text-[var(--color-ink-soft]">{kpi.label}</p>
        </div>
      ))}
    </div>

    <nav class="mt-10 flex flex-wrap gap-3 text-sm">
      {nav.map(([label, href]) => (
        <a class="rounded-lg border border-white/10 px-3 py-2" href={url(href)}>{label}</a>
      ))}
      <a class="rounded-lg border border-white/10 px-3 py-2" href="/logout/">Sign out</a>
    </nav>
  </section>
</BaseLayout>
