---
export const prerender = false;

import { desc, eq } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../db/client';
import { licenseBuilds, licenses } from '../../../db/schema';
import { requireAdminMfa } from '../../../server/admin-auth';
import { TRIAL_ACCOUNT } from '../../../server/licenses';

const session = Astro.locals.session;
if (!requireAdminMfa(session)) return Astro.redirect('/admin/login/');

/** A trial binds a marker rather than an account, so say what it means. */
const accountLabel = (account: string) => (account === TRIAL_ACCOUNT ? 'any demo account' : account);

const rows = await getDb()
  .select({
    id: licenseBuilds.id,
    status: licenseBuilds.buildStatus,
    account: licenseBuilds.accountNumber,
    requestedAt: licenseBuilds.requestedAt,
    r2Key: licenseBuilds.r2Key,
    key: licenses.licenseKey,
  })
  .from(licenseBuilds)
  .leftJoin(licenses, eq(licenses.id, licenseBuilds.licenseId))
  .orderBy(desc(licenseBuilds.requestedAt))
  .limit(50)
  .all();

const badgeTone = (status: string) => {
  if (status === 'READY') return 'badge-accent';
  if (status === 'PENDING' || status === 'BUILDING') return 'badge-warn';
  if (status === 'FAILED') return 'badge-danger';
  return '';
};
---

<AdminLayout
  active="builds"
  title="EA builds"
  heading="EA builds"
  lead="Each licence needs an EX4/EX5 compiled for the account number it is bound to. Attach the compiled file once the build job finishes."
>
  <div class="admin-panel">
    <div class="admin-panel-head">
      <h2>Build queue</h2>
      <span class="admin-mono muted">{rows.length} shown</span>
    </div>
    {
      rows.length === 0 ? (
        <p class="admin-empty">Nothing in the queue.</p>
      ) : (
        <div style="overflow-x:auto">
          <table class="admin-table">
            <thead>
              <tr>
                <th scope="col">Licence</th>
                <th scope="col">Account</th>
                <th scope="col">Status</th>
                <th scope="col">Requested</th>
                <th scope="col">Attach build</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <td class="admin-mono">{row.key ?? '—'}</td>
                  <td class="admin-mono muted">{accountLabel(row.account)}</td>
                  <td>
                    <span class:list={['badge', badgeTone(row.status)]}>{row.status}</span>
                  </td>
                  <td class="admin-mono muted">
                    {row.requestedAt.toISOString().slice(0, 16).replace('T', ' ')}
                  </td>
                  <td>
                    {row.status === 'READY' ? (
                      <span class="admin-mono muted">{row.r2Key ? 'attached' : 'ready'}</span>
                    ) : (
                      <form
                        method="post"
                        action="/api/admin/build/"
                        enctype="multipart/form-data"
                        style="display:flex;align-items:center;gap:0.5rem"
                      >
                        <input type="hidden" name="buildId" value={row.id} />
                        <input
                          type="file"
                          name="file"
                          accept=".ex4,.ex5,.zip"
                          required
                          aria-label={`Compiled build for ${accountLabel(row.account)}`}
                          style="font-size:0.72rem;max-width:11rem"
                        />
                        <button class="admin-btn admin-btn-primary" type="submit">
                          Attach
                        </button>
                      </form>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</AdminLayout>
