---
export const prerender = false;

import { desc, eq } from 'drizzle-orm';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDb } from '../../../db/client';
import { licenseBuilds, licenses } from '../../../db/schema';
import { requireAdminMfa } from '../../../server/admin-auth';
import { url } from '../../../lib/urls';

const session = Astro.locals.session;
if (!requireAdminMfa(session)) return Astro.redirect('/admin/login/');

const rows = await getDb()
  .select({
    id: licenseBuilds.id,
    status: licenseBuilds.buildStatus,
    account: licenseBuilds.accountNumber,
    requestedAt: licenseBuilds.requestedAt,
    r2Key: licenseBuilds.r2Key,
    key: licenses.licenseKey,
  })
  .from(licenseBuilds)
  .leftJoin(licenses, eq(licenses.id, licenseBuilds.licenseId))
  .orderBy(desc(licenseBuilds.requestedAt))
  .limit(50)
  .all();
---

<BaseLayout title="Admin — builds" description="EX5 build queue." noindex>
  <section class="container-x py-16">
    <p class="section-kicker">Admin</p>
    <h1 class="mt-3 text-3xl font-bold">EA builds</h1>
    <p class="mt-3 text-sm text-[--color-ink-soft]"><a class="underline" href={url('/admin')}>Dashboard</a></p>

    <div class="mt-8 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="text-[--color-ink-soft]">
          <tr><th class="py-2">License</th><th>Account</th><th>Status</th><th>File</th><th>Requested</th><th>Attach compiled build</th></tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-t border-white/5">
              <td class="py-2 font-mono text-xs">{row.key ?? '—'}</td>
              <td>{row.account}</td>
              <td>{row.status}</td>
              <td class="text-xs">{row.r2Key ?? '—'}</td>
              <td>{row.requestedAt.toISOString().slice(0, 16).replace('T', ' ')}</td>
              <td class="py-2">
                {
                  row.status === 'READY' ? (
                    <span class="text-xs text-[--color-ink-soft]">attached</span>
                  ) : (
                    <form method="post" action="/api/admin/build/" enctype="multipart/form-data" class="flex items-center gap-2">
                      <input type="hidden" name="buildId" value={row.id} />
                      <input
                        class="text-xs"
                        type="file"
                        name="file"
                        accept=".ex4,.ex5,.zip"
                        required
                        aria-label={`Compiled build for account ${row.account}`}
                      />
                      <button class="rounded bg-[--color-brand] px-2 py-1 text-xs font-semibold text-black" type="submit">
                        Attach
                      </button>
                    </form>
                  )
                }
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
