---
export const prerender = false;

import { desc, eq } from 'drizzle-orm';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDb } from '../../../db/client';
import { cryptoPayments, orders } from '../../../db/schema';
import { requireAdminMfa } from '../../../server/admin-auth';
import { url } from '../../../lib/urls';

const session = Astro.locals.session;
if (!requireAdminMfa(session)) return Astro.redirect('/admin/login/');

const rows = await getDb()
  .select({
    id: cryptoPayments.id,
    status: cryptoPayments.status,
    expected: cryptoPayments.expectedAmount,
    received: cryptoPayments.receivedAmount,
    txid: cryptoPayments.txid,
    orderNumber: orders.orderNumber,
    createdAt: cryptoPayments.createdAt,
  })
  .from(cryptoPayments)
  .leftJoin(orders, eq(orders.id, cryptoPayments.orderId))
  .orderBy(desc(cryptoPayments.createdAt))
  .limit(50)
  .all();
---

<BaseLayout title="Admin — payments" description="USDT payment monitor." noindex>
  <section class="container-x py-16">
    <p class="section-kicker">Admin</p>
    <h1 class="mt-3 text-3xl font-bold">USDT payments</h1>
    <p class="mt-3 text-sm text-[var(--color-ink-soft]"><a class="underline" href={url('/admin')}>Dashboard</a></p>

    <div class="mt-8 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="text-[var(--color-ink-soft]">
          <tr><th class="py-2">Order</th><th>Status</th><th>Expected</th><th>Received</th><th>TXID</th></tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-t border-white/5">
              <td class="py-2 font-mono">{row.orderNumber ?? '—'}</td>
              <td>{row.status}</td>
              <td>{row.expected} USDT</td>
              <td>{row.received ?? '—'}</td>
              <td class="font-mono text-xs">{row.txid ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
