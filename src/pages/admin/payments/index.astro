---
export const prerender = false;

import { desc, eq } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../db/client';
import { cryptoPayments, orders } from '../../../db/schema';
import { requireAdminMfa } from '../../../server/admin-auth';

const session = Astro.locals.session;
if (!requireAdminMfa(session)) return Astro.redirect('/admin/login/');

const rows = await getDb()
  .select({
    id: cryptoPayments.id,
    status: cryptoPayments.status,
    expected: cryptoPayments.expectedAmount,
    received: cryptoPayments.receivedAmount,
    txid: cryptoPayments.txid,
    orderNumber: orders.orderNumber,
    createdAt: cryptoPayments.createdAt,
  })
  .from(cryptoPayments)
  .leftJoin(orders, eq(orders.id, cryptoPayments.orderId))
  .orderBy(desc(cryptoPayments.createdAt))
  .limit(100)
  .all();

const badgeTone = (status: string) => {
  if (status === 'PAID') return 'badge-accent';
  if (status === 'WAITING' || status === 'DETECTED' || status === 'CONFIRMING') return 'badge-warn';
  if (status === 'FAILED' || status === 'EXPIRED') return 'badge-danger';
  return '';
};
---

<AdminLayout
  active="payments"
  title="USDT payments"
  heading="USDT payments"
  lead="The self-hosted BEP-20 rail. A payment only settles when the sender, the amount and the transaction match the order that is waiting."
>
  <div class="admin-panel">
    <div class="admin-panel-head">
      <h2>Payments</h2>
      <span class="admin-mono muted">{rows.length} shown</span>
    </div>
    {
      rows.length === 0 ? (
        <p class="admin-empty">No USDT payments yet.</p>
      ) : (
        <div style="overflow-x:auto">
          <table class="admin-table">
            <thead>
              <tr>
                <th scope="col">Order</th>
                <th scope="col">Status</th>
                <th scope="col">Expected</th>
                <th scope="col">Received</th>
                <th scope="col">TXID</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <td class="admin-mono">{row.orderNumber ?? '—'}</td>
                  <td>
                    <span class:list={['badge', badgeTone(row.status)]}>{row.status}</span>
                  </td>
                  <td class="admin-mono">{row.expected} USDT</td>
                  <td class="admin-mono muted">{row.received ?? '—'}</td>
                  <td class="admin-mono muted">{row.txid ? `${row.txid.slice(0, 10)}…` : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</AdminLayout>
