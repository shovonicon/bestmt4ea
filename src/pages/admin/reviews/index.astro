---
/**
 * Admin — review drafts (/admin/reviews/).
 *
 * Lists every imported review with its status. Drafts are AI-assisted wording
 * built from real WooCommerce order records and are deliberately NOT public:
 * `src/pages/reviews/index.astro` renders only `status: "approved"`.
 *
 * To publish one, edit `src/data/reviews.json` and change that review's
 * `status` to `"approved"` — after the customer has confirmed the wording.
 */
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireAdminMfa } from '../../../server/admin-auth';
import reviewData from '../../../data/reviews.json';

const session = Astro.locals.session;
if (!requireAdminMfa(session)) return Astro.redirect('/admin/login/');

interface Review {
  id: number;
  status: string;
  provenance?: string;
  rating: number;
  title: string;
  body: string;
  reviewer: string;
  location: string | null;
  month: string | null;
  product: string | null;
}

const all = (reviewData as unknown as { reviews: Review[] }).reviews ?? [];
const drafts = all.filter((review) => review.status !== 'approved');
const approved = all.filter((review) => review.status === 'approved');
---

<AdminLayout
  active="reviews"
  title="Review drafts"
  heading="Review drafts"
  lead="Imported reviews held back from the public page until the customer who wrote them confirms the wording."
>
  <div class="admin-panel" style="border-color:rgba(251,191,36,0.25);background-color:rgba(251,191,36,0.05)">
    <p class="admin-empty" style="color:var(--color-ink-soft);line-height:1.7">
      <strong style="color:var(--color-ink)">{drafts.length} draft{drafts.length === 1 ? '' : 's'}</strong> are not public.
      The customer and order details are genuine; the wording is generated. Publish one only after that customer has
      confirmed it — set its <code>status</code> to <code>approved</code> in <code>src/data/reviews.json</code>.
      {approved.length} published.
    </p>
  </div>

  <div class="admin-panel" style="margin-top:1rem">
    <div class="admin-panel-head">
      <h2>All imported reviews</h2>
      <span class="admin-mono muted">{all.length} rows</span>
    </div>
    <div style="overflow-x:auto">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col">Status</th>
            <th scope="col">Rating</th>
            <th scope="col">Reviewer</th>
            <th scope="col">Product</th>
            <th scope="col">Review</th>
          </tr>
        </thead>
        <tbody>
          {
            all.map((review) => (
              <tr>
                <td class="admin-mono muted">{review.id}</td>
                <td>
                  <span class:list={['badge', review.status === 'approved' ? 'badge-accent' : 'badge-warn']}>
                    {review.status}
                  </span>
                </td>
                <td class="admin-mono">{review.rating}/5</td>
                <td>
                  {review.reviewer}
                  <span class="admin-mono muted" style="display:block;margin-top:0.15rem">
                    {review.location ?? ''}
                    {review.month ? ` · ${review.month}` : ''}
                  </span>
                </td>
                <td class="muted" style="max-width:16rem">{review.product ?? '—'}</td>
                <td class="muted" style="max-width:32rem;line-height:1.6">
                  <strong style="color:var(--color-ink-soft)">{review.title}</strong> — {review.body}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
