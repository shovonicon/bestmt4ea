---
export const prerender = false;

import { desc, eq } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../db/client';
import { customers, licenses, products } from '../../../db/schema';
import { getPendingAccountChangeRequest } from '../../../server/licenses';
import { requireAdminMfa } from '../../../server/admin-auth';

const session = Astro.locals.session;
if (!requireAdminMfa(session)) return Astro.redirect('/admin/login/');

const db = getDb();
const rows = await db
  .select({
    id: licenses.id,
    key: licenses.licenseKey,
    status: licenses.status,
    expiresAt: licenses.expiresAt,
    email: customers.email,
    product: products.title,
  })
  .from(licenses)
  .leftJoin(customers, eq(customers.id, licenses.customerId))
  .leftJoin(products, eq(products.id, licenses.productId))
  .orderBy(desc(licenses.createdAt))
  .limit(50)
  .all();

const withPending = [];
for (const row of rows) {
  withPending.push({ ...row, pending: await getPendingAccountChangeRequest(db, row.id) });
}

const badgeTone = (status: string) => {
  if (status === 'ACTIVE') return 'badge-accent';
  if (status === 'PENDING') return 'badge-warn';
  if (status === 'REVOKED' || status === 'SUSPENDED' || status === 'EXPIRED') return 'badge-danger';
  return '';
};
---

<AdminLayout
  active="licenses"
  title="Licences"
  heading="Licences"
  lead="Each licence binds one MT4/MT5 account. Suspending or revoking stops the compiled build working; extend pushes the expiry out."
>
  {
    withPending.length === 0 ? (
      <p class="admin-empty">No licences yet. One appears the moment an order settles.</p>
    ) : (
      <div style="display:flex;flex-direction:column;gap:0.85rem">
        {withPending.map((license) => (
          <div class="admin-panel">
            <div class="admin-panel-head">
              <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
                <span class="admin-mono">{license.key}</span>
                <span class:list={['badge', badgeTone(license.status)]}>{license.status}</span>
                {license.pending && <span class="badge badge-warn">change requested</span>}
              </div>
              <span class="admin-mono muted">
                {license.expiresAt ? `expires ${license.expiresAt.toISOString().slice(0, 10)}` : 'lifetime'}
              </span>
            </div>

            <p class="admin-empty">
              {license.product ?? '—'} · {license.email ?? '—'}
            </p>

            <div class="admin-actions" style="margin-top:0.9rem">
              {['suspend', 'resume', 'revoke', 'extend', 'rebuild'].map((action) => (
                <form method="post" action="/api/admin/license/">
                  <input type="hidden" name="licenseId" value={license.id} />
                  <input type="hidden" name="action" value={action} />
                  <button class="admin-btn" type="submit">
                    {action}
                  </button>
                </form>
              ))}
              {license.pending && (
                <form method="post" action="/api/admin/license/">
                  <input type="hidden" name="licenseId" value={license.id} />
                  <input type="hidden" name="action" value="approve-account-change" />
                  <button class="admin-btn admin-btn-primary" type="submit">
                    approve account change
                  </button>
                </form>
              )}
            </div>
          </div>
        ))}
      </div>
    )
  }
</AdminLayout>
