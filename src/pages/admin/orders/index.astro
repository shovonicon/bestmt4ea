---
export const prerender = false;

import { desc, eq } from 'drizzle-orm';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDb } from '../../../db/client';
import { customers, orders } from '../../../db/schema';
import { requireAdminMfa } from '../../../server/admin-auth';
import { formatUsd } from '../../../lib/money';
import { url } from '../../../lib/urls';

const session = Astro.locals.session;
if (!requireAdminMfa(session)) return Astro.redirect('/admin/login/');

const rows = await getDb()
  .select({
    number: orders.orderNumber,
    status: orders.status,
    total: orders.totalCents,
    createdAt: orders.createdAt,
    email: customers.email,
  })
  .from(orders)
  .leftJoin(customers, eq(customers.id, orders.customerId))
  .orderBy(desc(orders.createdAt))
  .limit(50)
  .all();
---

<BaseLayout title="Admin — orders" description="Admin orders." noindex>
  <section class="container-x py-16">
    <p class="section-kicker">Admin</p>
    <h1 class="mt-3 text-3xl font-bold">Orders</h1>
    <p class="mt-3 text-sm text-[var(--color-ink-soft]"><a class="underline" href={url('/admin')}>Dashboard</a></p>

    <div class="mt-8 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="text-[var(--color-ink-soft]">
          <tr><th class="py-2">Order</th><th>Customer</th><th>Status</th><th>Total</th><th>Date</th></tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-t border-white/5">
              <td class="py-2 font-mono">{row.number}</td>
              <td>{row.email ?? '—'}</td>
              <td>{row.status}</td>
              <td>{formatUsd(row.total)}</td>
              <td>{row.createdAt.toISOString().slice(0, 10)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
