---
export const prerender = false;

import { eq } from 'drizzle-orm';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../db/client';
import { adminUsers } from '../../db/schema';
import { ADMIN_ISSUER, isPendingAdmin } from '../../server/admin-auth';
import { buildOtpAuthUrl } from '../../lib/totp';

const session = Astro.locals.session;
if (!isPendingAdmin(session)) return Astro.redirect('/admin/login/');

const admin = await getDb()
  .select()
  .from(adminUsers)
  .where(eq(adminUsers.id, session.subjectId))
  .get();

const enrolling = Boolean(admin && !admin.totpEnabledAt && admin.totpSecret);
const otpauth = enrolling && admin ? buildOtpAuthUrl(admin.email, ADMIN_ISSUER, admin.totpSecret ?? '') : null;
---

<BaseLayout title="Admin verification" description="Two-factor verification." noindex>
  <section class="container-x mx-auto flex min-h-[70vh] max-w-md flex-col justify-center py-24">
    <p class="section-kicker">Admin</p>
    <h1 class="mt-3 text-3xl font-bold">Two-factor code</h1>

    {enrolling && admin && (
      <div class="mt-6 rounded-xl border border-white/10 bg-white/5 p-4 text-sm">
        <p class="font-medium">Set up your authenticator</p>
        <p class="mt-2 text-[var(--color-ink-soft]">Add this secret to Google Authenticator / Authy, then enter a code.</p>
        <p class="mt-2 break-all font-mono text-[var(--color-ink]">{admin.totpSecret}</p>
        {otpauth && <p class="mt-2 break-all text-xs text-[var(--color-ink-soft]">{otpauth}</p>}
      </div>
    )}

    <form method="post" action="/api/admin/verify/" class="mt-8 flex flex-col gap-3">
      <input name="code" inputmode="numeric" autocomplete="one-time-code" required maxlength="10" placeholder="123456" class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-center text-2xl tracking-[0.4em] outline-none focus:border-[var(--color-accent]" />
      <button type="submit" class="mt-2 rounded-xl bg-[var(--color-accent)] px-5 py-3 font-semibold text-black">Unlock</button>
    </form>
  </section>
</BaseLayout>
