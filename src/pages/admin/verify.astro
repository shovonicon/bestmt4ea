---
export const prerender = false;

import { eq } from 'drizzle-orm';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../db/client';
import { adminUsers } from '../../db/schema';
import { ADMIN_ISSUER, isPendingAdmin } from '../../server/admin-auth';
import { buildOtpAuthUrl } from '../../lib/totp';

/**
 * Second factor. A first login also enrols TOTP — the secret is shown here once,
 * and confirming a code is what mints the recovery codes shown on the next page.
 */
const session = Astro.locals.session;
if (!isPendingAdmin(session)) return Astro.redirect('/admin/login/');

const admin = await getDb()
  .select()
  .from(adminUsers)
  .where(eq(adminUsers.id, session.subjectId))
  .get();

const enrolling = Boolean(admin && !admin.totpEnabledAt && admin.totpSecret);
const otpauth = enrolling && admin ? buildOtpAuthUrl(admin.email, ADMIN_ISSUER, admin.totpSecret ?? '') : null;
const failed = Astro.url.searchParams.get('error') === 'invalid_code';
---

<BaseLayout title="Admin verification" description="Two-factor verification." noindex>
  <section class="relative overflow-hidden border-b border-white/5">
    <div
      class="glow-orb animate-aurora left-1/2 top-[-14rem] h-[24rem] w-[34rem] -translate-x-1/2 bg-emerald-500/20"
    >
    </div>
    <div class="grid-overlay pointer-events-none absolute inset-0"></div>

    <div class="container-x relative z-10 flex min-h-[78vh] items-center justify-center py-16">
      <div class="w-full max-w-md">
        <div class="brand-card p-7 sm:p-8">
          <p class="section-kicker">Admin</p>
          <h1 class="mt-2 text-2xl font-bold">Two-factor code</h1>
          <p class="mt-2 text-sm leading-7 text-[var(--color-ink-soft)]">
            {enrolling
              ? 'Add the secret below to your authenticator, then enter the 6-digit code it shows.'
              : 'Enter the 6-digit code from your authenticator app.'}
          </p>

          {
            enrolling && admin && (
              <div class="mt-6 rounded-xl border border-white/10 bg-white/[0.03] p-4">
                <p class="metric-label">Secret</p>
                <p class="metric-value mt-2 break-all text-sm text-[var(--color-ink)]">{admin.totpSecret}</p>
                {otpauth && (
                  <>
                    <p class="metric-label mt-4">Setup link</p>
                    <p class="mt-2 break-all text-xs leading-6 text-[var(--color-ink-dim)]">{otpauth}</p>
                  </>
                )}
              </div>
            )
          }

          {
            failed && (
              <p
                role="alert"
                class="mt-5 rounded-xl border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm leading-6 text-red-200"
              >
                That code was not accepted. Enter the current code, or one of your recovery codes.
              </p>
            )
          }

          <form method="post" action="/api/admin/verify/" class="mt-6 flex flex-col gap-4">
            <div>
              <label for="code" class="metric-label">6-digit code or recovery code</label>
              <input
                id="code"
                name="code"
                inputmode="numeric"
                autocomplete="one-time-code"
                autofocus
                required
                maxlength="12"
                placeholder="123456"
                class="metric-value mt-2 w-full rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-center text-2xl tracking-[0.35em] text-[var(--color-ink)] placeholder:tracking-[0.2em] placeholder:text-[var(--color-ink-dim)] transition-colors focus:border-[var(--color-accent)] focus:bg-white/[0.06]"
              />
            </div>
            <button type="submit" class="btn btn-primary w-full !py-3.5 !text-base">Unlock the panel</button>
          </form>

          {enrolling && (
            <p class="mt-6 border-t border-white/5 pt-5 text-xs leading-6 text-[var(--color-ink-dim)]">
              Your recovery codes are shown once, straight after this step. Keep them somewhere offline.
            </p>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
