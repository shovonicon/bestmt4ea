---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/urls';

const failed = Astro.url.searchParams.get('error') === '1';
---

<BaseLayout title="Admin sign in" description="Administrator sign in." noindex>
  <section class="relative overflow-hidden border-b border-white/5">
    <div
      class="glow-orb animate-aurora left-1/2 top-[-14rem] h-[24rem] w-[34rem] -translate-x-1/2 bg-emerald-500/20"
    >
    </div>
    <div class="grid-overlay pointer-events-none absolute inset-0"></div>

    <div class="container-x relative z-10 flex min-h-[78vh] items-center justify-center py-16">
      <div class="w-full max-w-md">
        <div class="brand-card p-7 sm:p-8">
          <div class="flex items-center gap-3">
            <span
              class="metric-value grid h-10 w-10 flex-none place-items-center rounded-xl border border-emerald-400/25 bg-emerald-400/10 text-xs text-[var(--color-accent-soft)]"
              aria-hidden="true"
            >
              M4
            </span>
            <div>
              <p class="section-kicker !mb-0">BestMT4EA</p>
              <p class="text-xs text-[var(--color-ink-dim)]">Administrator access</p>
            </div>
          </div>

          <h1 class="mt-6 text-2xl font-bold">Sign in</h1>
          <p class="mt-2 text-sm leading-7 text-[var(--color-ink-soft)]">
            Email and password, then a 6-digit code from your authenticator app.
          </p>

          {
            failed && (
              <p
                role="alert"
                class="mt-5 rounded-xl border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm leading-6 text-red-200"
              >
                Those credentials were not accepted. Check the email and password and try again.
              </p>
            )
          }

          <form method="post" action="/api/admin/login/" class="mt-6 flex flex-col gap-4">
            <div>
              <label for="email" class="metric-label">Email address</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="username"
                spellcheck="false"
                placeholder="you@bestmt4ea.com"
                class="mt-2 w-full rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-base text-[var(--color-ink)] placeholder:text-[var(--color-ink-dim)] transition-colors focus:border-[var(--color-accent)] focus:bg-white/[0.06]"
              />
            </div>
            <div>
              <label for="password" class="metric-label">Password</label>
              <input
                id="password"
                name="password"
                type="password"
                required
                autocomplete="current-password"
                class="mt-2 w-full rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-base text-[var(--color-ink)] transition-colors focus:border-[var(--color-accent)] focus:bg-white/[0.06]"
              />
            </div>
            <button type="submit" class="btn btn-primary mt-1 w-full !py-3.5 !text-base">Continue</button>
          </form>

          <p class="mt-6 border-t border-white/5 pt-5 text-xs leading-6 text-[var(--color-ink-dim)]">
            Admin sessions are short-lived, and every privileged action is recorded in the audit log.
          </p>
        </div>

        <p class="mt-5 text-center text-xs">
          <a class="text-[var(--color-ink-dim)] underline decoration-white/20 hover:text-[var(--color-ink-soft)]" href={url('/')}>
            Back to the site
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
