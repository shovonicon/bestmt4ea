---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';

const error = Astro.url.searchParams.get('error') === '1';
---

<BaseLayout title="Admin sign in" description="Admin sign in." noindex>
  <section class="container-x mx-auto flex min-h-[70vh] max-w-md flex-col justify-center py-24">
    <p class="section-kicker">Admin</p>
    <h1 class="mt-3 text-3xl font-bold">Sign in</h1>
    <p class="mt-3 text-sm text-[var(--color-ink-soft]">Password, then a 6-digit code from your authenticator.</p>

    {error && (
      <p class="mt-6 rounded-xl border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200">
        Incorrect email or password.
      </p>
    )}

    <form method="post" action="/api/admin/login/" class="mt-8 flex flex-col gap-3">
      <input name="email" type="email" required autocomplete="username" placeholder="Admin email" class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-base outline-none focus:border-[var(--color-accent]" />
      <input name="password" type="password" required autocomplete="current-password" placeholder="Password" class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-base outline-none focus:border-[var(--color-accent]" />
      <button type="submit" class="mt-2 rounded-xl bg-[var(--color-accent)] px-5 py-3 font-semibold text-black">Continue</button>
    </form>
  </section>
</BaseLayout>
