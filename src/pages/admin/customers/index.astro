---
export const prerender = false;

import { desc } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../db/client';
import { customers } from '../../../db/schema';
import { requireAdminMfa } from '../../../server/admin-auth';

const session = Astro.locals.session;
if (!requireAdminMfa(session)) return Astro.redirect('/admin/login/');

const rows = await getDb()
  .select({
    email: customers.email,
    name: customers.name,
    createdAt: customers.createdAt,
    lastLoginAt: customers.lastLoginAt,
  })
  .from(customers)
  .orderBy(desc(customers.createdAt))
  .limit(100)
  .all();
---

<AdminLayout
  active="customers"
  title="Customers"
  heading="Customers"
  lead="Every account the site has created, newest first. An account appears the first time someone uses the sign-in form."
>
  <div class="admin-panel">
    <div class="admin-panel-head">
      <h2>Accounts</h2>
      <span class="admin-mono muted">{rows.length} shown</span>
    </div>
    {
      rows.length === 0 ? (
        <p class="admin-empty">No accounts yet.</p>
      ) : (
        <div style="overflow-x:auto">
          <table class="admin-table">
            <thead>
              <tr>
                <th scope="col">Email</th>
                <th scope="col">Name</th>
                <th scope="col">Joined</th>
                <th scope="col">Last login</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <td>{row.email}</td>
                  <td class="muted">{row.name ?? '—'}</td>
                  <td class="admin-mono">{row.createdAt.toISOString().slice(0, 10)}</td>
                  <td class="admin-mono muted">{row.lastLoginAt ? row.lastLoginAt.toISOString().slice(0, 10) : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</AdminLayout>
