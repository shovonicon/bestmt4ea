---
export const prerender = false;

import { desc } from 'drizzle-orm';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDb } from '../../../db/client';
import { customers } from '../../../db/schema';
import { requireAdminMfa } from '../../../server/admin-auth';
import { url } from '../../../lib/urls';

const session = Astro.locals.session;
if (!requireAdminMfa(session)) return Astro.redirect('/admin/login/');

const rows = await getDb()
  .select({
    email: customers.email,
    name: customers.name,
    createdAt: customers.createdAt,
    lastLoginAt: customers.lastLoginAt,
  })
  .from(customers)
  .orderBy(desc(customers.createdAt))
  .limit(50)
  .all();
---

<BaseLayout title="Admin — customers" description="Admin customers." noindex>
  <section class="container-x py-16">
    <p class="section-kicker">Admin</p>
    <h1 class="mt-3 text-3xl font-bold">Customers</h1>
    <p class="mt-3 text-sm text-[--color-ink-soft]"><a class="underline" href={url('/admin')}>Dashboard</a></p>

    <div class="mt-8 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="text-[--color-ink-soft]">
          <tr><th class="py-2">Email</th><th>Name</th><th>Joined</th><th>Last login</th></tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-t border-white/5">
              <td class="py-2">{row.email}</td>
              <td>{row.name ?? '—'}</td>
              <td>{row.createdAt.toISOString().slice(0, 10)}</td>
              <td>{row.lastLoginAt ? row.lastLoginAt.toISOString().slice(0, 10) : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
