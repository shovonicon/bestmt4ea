---
/**
 * Unified long-form layout for posts — articles and free-download pages.
 *
 * One renderer, two modes: `entry.data.download` switches on the download
 * order. Everything that comes from frontmatter (quick answer, takeaways,
 * download, install steps, FAQ, sources) renders here and nowhere else; the
 * Markdown body carries narrative only. That is what stops the duplicate
 * FAQ/Sources/Install sections the WordPress imports shipped with.
 *
 * Reading layout: full-width composition with a centered ~44rem prose column
 * (`65–75ch`) and wider breakouts for the download card and other panels.
 * There is no ad sidebar. Ads sit inside the column, and on a download page at
 * least one full content section (the install steps) separates the download
 * action from the first ad unit.
 *
 * Render order — download mode: breadcrumb → H1 → quick answer → download →
 * takeaways → install steps → ad → author/date → TOC → body → ad → FAQ →
 * sources → risk warning → related. Article mode drops download, install steps.
 */
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import AuthorBox from '../components/AuthorBox.astro';
import AnswerBox from '../components/AnswerBox.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AdSlot from '../components/AdSlot.astro';
import PartnerFallback from '../components/PartnerFallback.astro';
import SidebarAd from '../components/SidebarAd.astro';
import FixedSideAd from '../components/FixedSideAd.astro';
import BottomBannerAd from '../components/BottomBannerAd.astro';
import Faq from '../components/Faq.astro';
import DownloadCard from '../components/DownloadCard.astro';
import InstallSteps from '../components/InstallSteps.astro';
import ArticleSources from '../components/ArticleSources.astro';
import { countWords, readingMinutes } from '../lib/reading';
import { site, RISK_DISCLAIMER } from '../lib/site';
import { AFFILIATE_REL, affiliates } from '../lib/affiliates';
import { articleSchema, breadcrumbSchema, faqSchema, howToSchema } from '../lib/seo';
import { url } from '../lib/urls';

export interface Props {
  entry: any;
  headings: { depth: number; text: string; id: string }[];
  body: string;
  related?: any[];
}

const { entry, headings, body, related = [] } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);

const words = countWords(body);
const minutes = readingMinutes(words);
const pageUrl = `/${data.slug}/`;
const download = data.download;
const isDownload = Boolean(download);
const installSteps = data.installSteps ?? [];

/**
 * Fixed-edge skyscrapers, from the reference build. The left creative is the
 * broker's own asset, so it stays on their CDN and stays current; the right one
 * is ours, served from `public/ads`. Both only appear on very wide screens, and
 * the broker link carries the affiliate `rel` (never a hard-coded tracking URL —
 * the URL comes from the registry).
 */
const sideAds: { side: 'left' | 'right'; href: string; image: string; alt: string; rel?: string }[] = [
  {
    side: 'left' as const,
    href: affiliates.exness.url,
    rel: AFFILIATE_REL,
    image:
      'https://d3dpet1g0ty5ed.cloudfront.net/EN_MENA_GOOGLE_C1_BB2_C2_T1_FSECURITY_CONFIDENCE_T2_PERFORMANCE_D-3-13_STATIC_300x600.jpg',
    alt: 'Exness',
  },
  {
    side: 'right' as const,
    href: url('/copy-trading'),
    image: '/ads/bestmt4ea-copy-trading-300x600.webp',
    alt: 'Barakah Account Management — copy trading Gold (XAUUSD) and EURUSD',
  },
];

// Sticky left/right rails. They only exist when ads are configured and the post
// has not opted out — AdSlot itself renders nothing without a client ID.
const showRails = data.showAds !== false && Boolean(import.meta.env.PUBLIC_ADSENSE_CLIENT);

const trail = isDownload
  ? [{ name: 'Home', url: '/' }, { name: data.title, url: pageUrl }]
  : [
      { name: 'Home', url: '/' },
      { name: 'Blog', url: '/blog/' },
      ...(data.categories?.[0]
        ? [{ name: data.categories[0], url: data.categoryPaths?.[0] ?? '/blog/' }]
        : []),
      { name: data.title, url: pageUrl },
    ];
---

<BaseLayout
  title={data.seo.title || data.title}
  description={data.seo.description || data.description}
  canonical={data.seo.canonical}
  ogImage={data.seo.ogImage || data.featuredImage}
  robots={data.seo.robots}
  ogType="article"
  published={data.publishedAt}
  updated={data.updatedAt}
  author={data.author}
  jsonLd={[
    articleSchema({
      title: data.title,
      description: data.seo.description || data.description,
      url: pageUrl,
      published: data.publishedAt,
      updated: data.updatedAt,
      image: data.featuredImage,
      author: data.author,
      keywords: data.tags,
      section: data.categories?.[0],
    }),
    breadcrumbSchema(trail),
    ...(isDownload && installSteps.length ? [howToSchema(data.title, installSteps)] : []),
    ...(data.faqs?.length ? [faqSchema(data.faqs)] : []),
  ]}
>
  <div class="container-x relative pt-8 pb-16">
    {
      /*
       * The rails are siblings of `.longform`, not children: inside the grid
       * `.longform > *` gives them `grid-column: 2`, which makes the READING
       * column their containing block (so `left: 0` started inside the article).
       * Out here they position against the container, exactly like the tools page.
       */
      showRails && (
        <>
          <div class="ad-rail ad-rail-left">
            <div class="ad-rail-inner">
              <AdSlot slot={site.adSlots.railLeft} fixedSize={{ width: 300, height: 600 }} showLabel={false} class="!my-0">
                <div slot="fallback" class="flex flex-col gap-3">
                  <PartnerFallback keys={['exness']} variant="rail" />
                  <SidebarAd />
                </div>
              </AdSlot>
            </div>
          </div>
          <div class="ad-rail ad-rail-right">
            <div class="ad-rail-inner">
              <AdSlot slot={site.adSlots.railRight} fixedSize={{ width: 300, height: 600 }} showLabel={false} class="!my-0">
                <div slot="fallback" class="flex flex-col gap-3">
                  <PartnerFallback keys={['exness']} variant="rail" />
                  <SidebarAd />
                </div>
              </AdSlot>
            </div>
          </div>
        </>
      )
    }

    {
      /* Fixed-edge skyscrapers, from the reference build. CSS keeps them out of the way below 1700px. */
      sideAds.map((ad) => (
        <FixedSideAd side={ad.side} href={ad.href} image={ad.image} alt={ad.alt} rel={ad.rel} />
      ))
    }

    <div class="longform">
      <nav aria-label="Breadcrumb" class="text-xs text-[var(--color-ink-dim]">
        <a href="/" class="hover:text-[var(--color-accent]">Home</a>
        <span class="mx-2">/</span>
        <a href="/blog/" class="hover:text-[var(--color-accent]">Blog</a>
        {
          !isDownload && data.categories?.[0] && (
            <>
              <span class="mx-2">/</span>
              <span class="text-[var(--color-ink-soft]">{data.categories[0]}</span>
            </>
          )
        }
      </nav>

      <header class="mt-6">
        {
          isDownload ? (
            <p class="eyebrow">Free download · {download.platform ?? 'MT4 / MT5'}</p>
          ) : (
            data.categories?.[0] && <p class="eyebrow">{data.categories[0]}</p>
          )
        }
        <h1 class="mt-2 text-3xl leading-tight md:text-4xl">{data.title}</h1>
        {
          data.description && (
            <p class="mt-4 text-lg leading-8 text-[var(--color-ink-soft]">{data.description}</p>
          )
        }
      </header>

      {data.quickAnswer && <div class="mt-7"><AnswerBox answer={data.quickAnswer} /></div>}

      {
        isDownload && (
          <div class="longform-breakout mt-6">
            <DownloadCard download={download} title={data.title} />
          </div>
        )
      }

      {
        data.keyTakeaways?.length > 0 && (
          <div class="mt-6">
            <KeyTakeaways items={data.keyTakeaways} />
          </div>
        )
      }

      {
        isDownload && installSteps.length > 0 && (
          <div class="mt-6">
            <InstallSteps steps={installSteps} />
          </div>
        )
      }

      <!--
        The in-article units are injected into the body by
        `src/lib/rehype-in-article-ads.mjs` (at 5/35/65/90% depth), so there is
        no layout-level in-article slot here — a post must not carry both.
      -->

      <div class="mt-10">
        <AuthorBox published={data.publishedAt} updated={data.updatedAt} readingMinutes={minutes} />
      </div>

      <div class="mt-8 lg:hidden">
        <TableOfContents headings={headings} variant="collapsible" />
      </div>

      <div class="mt-8 hidden lg:block">
        <TableOfContents headings={headings} />
      </div>

      <div class="prose-article mt-10">
        <Content />
      </div>

      <!-- Second ad: after the body, clear of every download and purchase action. -->
      <AdSlot slot={site.adSlots.belowContent} class="mt-12" />

      {
        data.faqs?.length > 0 && (
          <div class="mt-12">
            <Faq items={data.faqs} heading="Frequently asked questions" />
          </div>
        )
      }

      <ArticleSources sources={data.sources} />

      <section class="mt-12 rounded-xl border border-[var(--color-warn]/30 bg-[var(--color-warn]/5 p-5">
        <h2 class="text-sm font-semibold text-[var(--color-warn]">Risk warning</h2>
        <p class="mt-2 text-xs leading-6 text-[var(--color-ink-soft]">{RISK_DISCLAIMER}</p>
      </section>

      {
        related.length > 0 && (
          <section class="mt-12">
            <h2 class="text-xl">Continue reading</h2>
            <ul class="mt-5 space-y-3">
              {related.map((item) => (
                <li>
                  <a
                    href={url(`/${item.data.slug}/`)}
                    class="text-sm font-semibold text-[var(--color-ink] hover:text-[var(--color-accent]"
                  >
                    {item.data.title}
                  </a>
                  <p class="mt-1 text-xs leading-6 text-[var(--color-ink-dim]">{item.data.description}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <BottomBannerAd />
    </div>
  </div>
</BaseLayout>
