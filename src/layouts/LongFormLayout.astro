---
/**
 * Unified long-form layout for posts — articles and free-download pages.
 *
 * One renderer, two modes: `entry.data.download` switches on the download
 * order. Everything that comes from frontmatter (quick answer, takeaways,
 * download, install steps, FAQ, sources) renders here and nowhere else; the
 * Markdown body carries narrative only. That is what stops the duplicate
 * FAQ/Sources/Install sections the WordPress imports shipped with.
 *
 * Reading layout: full-width composition with a centered ~44rem prose column
 * (`65–75ch`) and wider breakouts for the download card and other panels.
 * There is no ad sidebar. Ads sit inside the column, and on a download page at
 * least one full content section (the install steps) separates the download
 * action from the first ad unit.
 *
 * Render order — download mode: breadcrumb → H1 → quick answer → download →
 * takeaways → install steps → ad → author/date → TOC → body → ad → FAQ →
 * sources → risk warning → related. Article mode drops download, install steps.
 */
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import AuthorBox from '../components/AuthorBox.astro';
import AnswerBox from '../components/AnswerBox.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
import TableOfContents from '../components/TableOfContents.astro';
import RInfinityRail from '../components/RInfinityRail.astro';
import ToolRailAds from '../components/ToolRailAds.astro';
import Faq from '../components/Faq.astro';
import DownloadCard from '../components/DownloadCard.astro';
import InstallSteps from '../components/InstallSteps.astro';
import ArticleSources from '../components/ArticleSources.astro';
import { countWords, readingMinutes } from '../lib/reading';
import { RISK_DISCLAIMER } from '../lib/site';
import { affiliates } from '../lib/affiliates';
import { articleSchema, breadcrumbSchema, faqSchema, howToSchema } from '../lib/seo';
import { url } from '../lib/urls';

export interface Props {
  entry: any;
  headings: { depth: number; text: string; id: string }[];
  body: string;
  related?: any[];
}

const { entry, headings, body, related = [] } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);

const words = countWords(body);
const minutes = readingMinutes(words);
const pageUrl = `/${data.slug}/`;
const download = data.download;
const isDownload = Boolean(download);
const installSteps = data.installSteps ?? [];

/**
 * Fallback download for a post that ships none of its own.
 *
 * It lives here rather than in each post's frontmatter for two reasons: there is
 * nothing to write into 118 files, and `check-downloads` counts fileKey/URL reuse
 * in the frontmatter — a layout default is invisible to that cap, which is the
 * point of a fallback rather than a library.
 *
 * It is an external link, not a hosted file: the archive stays on Google Drive
 * and this site never serves the binaries. Nothing renders until `externalUrl`
 * is set, so an unset value is a no-op rather than a broken link.
 */
const FALLBACK_DOWNLOAD = {
  origin: 'opensource' as const,
  name: '2000+ EA & Indicator Library (shared bundle, 3 ZIP parts, about 577 MB)',
  license: 'No licence stated — third-party files shared as-is, unverified',
  author: 'Various (community bundle)',
  sourceUrl: 'https://drive.google.com/drive/folders/1w99fcnzD_vfU_tSlc4Pz8zOEX81t5-_l?usp=sharing',
  externalUrl: 'https://drive.google.com/drive/folders/1w99fcnzD_vfU_tSlc4Pz8zOEX81t5-_l?usp=sharing',
};
const fallbackDownload = !download && FALLBACK_DOWNLOAD.externalUrl ? FALLBACK_DOWNLOAD : null;

/** Byline dates, in the same format the article header and author box use. */
const fmtDate = (d?: Date) =>
  d
    ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(d)
    : undefined;
const updatedLabel = fmtDate(data.updatedAt ?? data.publishedAt);

// Sticky left/right rails. They only exist when ads are configured and the post
// has not opted out — AdSlot itself renders nothing without a client ID.

// Every post download on this site is a companion resource, never the
// article's subject (corpus audit, 2026-10-23), so posts always use the
// article breadcrumb — a download-style trail would present reviews and
// guides as product download pages.
const trail = [
      { name: 'Home', url: '/' },
      { name: 'Blog', url: '/blog/' },
      ...(data.categories?.[0]
        ? [{ name: data.categories[0], url: data.categoryPaths?.[0] ?? '/blog/' }]
        : []),
      { name: data.title, url: pageUrl },
    ];
---

<BaseLayout
  title={data.seo.title || data.title}
  description={data.seo.description || data.description}
  canonical={data.seo.canonical}
  ogImage={data.seo.ogImage || data.featuredImage}
  robots={data.seo.robots}
  ogType="article"
  published={data.publishedAt}
  updated={data.updatedAt}
  author={data.author}
  jsonLd={[
    articleSchema({
      title: data.title,
      description: data.seo.description || data.description,
      url: pageUrl,
      published: data.publishedAt,
      updated: data.updatedAt,
      image: data.featuredImage,
      author: data.author,
      keywords: data.tags,
      section: data.categories?.[0],
    }),
    breadcrumbSchema(trail),
    ...(isDownload && installSteps.length ? [howToSchema(data.title, installSteps)] : []),
    ...(data.faqs?.length ? [faqSchema(data.faqs)] : []),
  ]}
>
  <div class="container-x relative pt-8 pb-16">
    <div class="rf-rail-slot">
      <div class="rf-rail-sticky">
        <RInfinityRail />
      </div>
    </div>

    <div class="tool-rail-slot">
      <div class="tool-rail-sticky">
        <ToolRailAds />
      </div>
    </div>

    <div class="longform">
      <div class="longform-main">
      <nav aria-label="Breadcrumb" class="text-xs text-[var(--color-ink-dim)]">
        <a href="/" class="hover:text-[var(--color-accent)]">Home</a>
        <span class="mx-2">/</span>
        <a href="/blog/" class="hover:text-[var(--color-accent)]">Blog</a>
        {
          data.categories?.[0] && (
            <>
              <span class="mx-2">/</span>
              <span class="text-[var(--color-ink-soft)]">{data.categories[0]}</span>
            </>
          )
        }
      </nav>

      <header class="mt-6">
        {
          /* Post downloads are companion resources, not the article's subject,
             so the eyebrow always names the category — never "Free download",
             which would present a review or guide as a product download page. */
          data.categories?.[0] && (
            <p class="eyebrow inline-flex items-center rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3.5 py-1.5">
              {data.categories[0]}
            </p>
          )
        }
        <h1 class="mt-5 text-balance text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl">{data.title}</h1>
        {
          data.description && (
            <p class="mt-5 max-w-2xl text-lg leading-8 text-[var(--color-ink-soft)]">{data.description}</p>
          )
        }

        <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-white/5 pt-5">
          <div class="flex items-center gap-3">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full border border-emerald-400/25 bg-emerald-400/10 p-1.5"
              aria-hidden="true"
            >
              <img
                src="/media/brand-mark.png"
                alt=""
                width="26"
                height="26"
                class="h-full w-full object-contain"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span>
              <span class="block text-sm font-semibold text-[var(--color-ink)]">BESTMT4EA Trading Desk</span>
              <time datetime={data.publishedAt.toISOString()} class="block text-xs text-[var(--color-ink-dim)]">
                {fmtDate(data.publishedAt)}
              </time>
            </span>
          </div>

          {
            updatedLabel && (
              <span class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--color-accent-soft)]">
                <svg
                  viewBox="0 0 24 24"
                  class="h-3.5 w-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M21 12a9 9 0 1 1-2.64-6.36" />
                  <path d="M21 3v5h-5" />
                </svg>
                Updated {updatedLabel}
              </span>
            )
          }

          <span class="text-sm text-[var(--color-ink-dim)]">{minutes} min read</span>
        </div>
      </header>

      <!--
        In-flow sponsor card: the rail is hidden below 1740px, so the same card
        renders here — above the article, as on the tools pages. It is a styled
        affiliate card, not an AdSense unit, so it does not trip the rule about
        ad units above the download action.
      -->
      <div class="rf-inline-slot mt-8">
        <RInfinityRail variant="inline" />
      </div>

      {data.quickAnswer && <div class="mt-7"><AnswerBox answer={data.quickAnswer} /></div>}

      {
        data.keyTakeaways?.length > 0 && (
          <div class="mt-6">
            <KeyTakeaways items={data.keyTakeaways} />
          </div>
        )
      }

      {
        (download || fallbackDownload) && (
          <div class="mt-8">
            <DownloadCard
              download={download ?? fallbackDownload!}
              title={data.title}
              kind={download ? undefined : 'external'}
              companion
            />
          </div>
        )
      }

      {
        isDownload && installSteps.length > 0 && (
          <div class="mt-6">
            <InstallSteps steps={installSteps} />
          </div>
        )
      }

      <!--
        The in-article units are injected into the body by
        `src/lib/rehype-in-article-ads.mjs` (at 5/35/65/90% depth), so there is
        no layout-level in-article slot here — a post must not carry both.
      -->

      <div class="mt-10">
        <AuthorBox />
      </div>

      <div class="mt-8 lg:hidden">
        <TableOfContents headings={headings} variant="collapsible" />
      </div>

      <div class="toc-inline-slot mt-8 hidden lg:block">
        <TableOfContents headings={headings} />
      </div>

      <div class="prose-article mt-10">
        <Content />
      </div>

      {
        data.faqs?.length > 0 && (
          <div class="mt-12">
            <Faq items={data.faqs} heading="Frequently asked questions" />
          </div>
        )
      }

      <ArticleSources sources={data.sources} />

      <section class="mt-12 rounded-xl border border-[var(--color-warn)]/30 bg-[var(--color-warn)]/5 p-5">
        <h2 class="text-sm font-semibold text-[var(--color-warn)]">Risk warning</h2>
        <p class="mt-2 text-xs leading-6 text-[var(--color-ink-soft)]">{RISK_DISCLAIMER}</p>
      </section>

      {
        related.length > 0 && (
          <section class="brand-card mt-12 p-6 sm:p-8">
            <h2 class="text-xl text-gradient-aurora">Continue reading</h2>
            <ul class="mt-5 grid gap-4 sm:grid-cols-2">
              {related.map((item) => (
                <li class="rounded-xl border border-emerald-400/20 bg-emerald-400/5 p-4">
                  <a
                    href={url(`/${item.data.slug}/`)}
                    class="text-sm font-semibold text-[var(--color-ink)] hover:text-[var(--color-accent)]"
                  >
                    {item.data.title}
                  </a>
                  <p class="mt-1 text-xs leading-6 text-[var(--color-ink-dim)]">{item.data.description}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      </div>

      <div class="tool-inline-slot mt-12">
        <ToolRailAds variant="inline" />
      </div>

    </div>

    <div class="toc-slot">
      <div class="toc-sticky">
        <TableOfContents headings={headings} variant="rail" minutes={minutes} />
      </div>
    </div>
  </div>
</BaseLayout>
