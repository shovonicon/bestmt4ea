---
/**
 * Broker comparison page (/best-forex-brokers/).
 *
 * The source page is a WordPress import whose body is one raw markdown table
 * carrying affiliate URLs with no `rel` and no disclosure. It is deliberately
 * NOT rendered: the rows come from `src/data/brokers.json`, the links from
 * `src/lib/affiliates.ts`, and every link goes out with the sponsored rel and a
 * visible disclosure above it.
 *
 * Kept deliberately short and scannable: proof, the two platforms we build on,
 * the full ranked list, and one way out. Every figure comes from the comparison
 * data — nothing is scored or invented.
 */
import BaseLayout from './BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import BrokerCard from '../components/BrokerCard.astro';
import BrokerExplorer from '../components/BrokerExplorer.astro';
import Faq from '../components/Faq.astro';
import { getAffiliate, AFFILIATE_DISCLOSURE } from '../lib/affiliates';
import { breadcrumbSchema, breadcrumbTrail, faqSchema, itemListSchema } from '../lib/seo';
import { RISK_DISCLAIMER } from '../lib/site';
import { formatDate } from '../lib/format';
import { monthYear } from '../lib/dates';
import { url } from '../lib/urls';
import brokerData from '../data/brokers.json';
import countryData from '../data/broker-countries.json';
import verification from '../data/site-verification.json';
import { buildStatusTable } from '../lib/brokerCountry';

export interface Props {
  entry: any;
}

const { entry } = Astro.props;
const data = entry.data;

type Row = {
  key: string;
  regulation: string;
  minDeposit: string;
  platforms: string;
  accountTypes: string;
  offer?: string;
  recommended?: boolean;
  bestFor?: string;
  acceptedCountries?: string | null;
  restrictedCountries?: string;
};

const brokers = (brokerData as unknown as { brokers: Row[] }).brokers ?? [];
const faqs = (brokerData as unknown as { faqs: Array<{ question: string; answer: string }> }).faqs ?? [];
const recommended = brokers.filter((broker) => broker.recommended);
/** The 'Where we test' picks: only the two top choices. */
const picks = recommended.slice(0, 2);
/** Table rows: only brokers with an affiliate entry, exactly as the cards below. */
const explorerRows = brokers.flatMap((broker, index) => {
  const affiliate = getAffiliate(broker.key);
  return affiliate
    ? [
        {
          key: broker.key,
          name: affiliate.label,
          url: affiliate.url,
          regulation: broker.regulation,
          minDeposit: broker.minDeposit,
          platforms: broker.platforms,
          accountTypes: broker.accountTypes,
          offer: broker.offer,
          bestFor: broker.bestFor,
          // The same tag the cards below carry: the first two recommended brokers are the top choices.
          tag: broker.recommended ? (index <= 1 ? 'Top choice' : 'Recommended') : undefined,
        },
      ]
    : [];
});
/** Country availability per broker, built from the free text in brokers.json. */
const countryStatuses = buildStatusTable(brokers, countryData.countries);
const countriesVerifiedAt = (verification as { brokerCountriesVerifiedAt?: string | null }).brokerCountriesVerifiedAt ?? null;
/** Short, answer-first guide under the table. Plain statements a reader (or an AI answer engine) can quote. */
const guide = [
  {
    q: 'How do I choose a forex broker?',
    a: "Check regulation first, then total cost, platform and withdrawals. Verify the licence on the regulator's own register, compare spread plus commission on the pair you trade, and confirm the broker offers MT4 or MT5 if you run expert advisors.",
  },
  {
    q: 'How much do I need to start?',
    a: "Many brokers accept $1 to $10, but start with an amount where risking 1 to 2% per trade still gives a usable lot size. Practise on a demo account first and fund only money you can afford to lose.",
  },
  {
    q: 'What does forex trading cost?',
    a: "Four things: the spread, any commission, overnight swap, and funding or withdrawal fees. Raw or ECN accounts usually pair a tight spread with a per-lot commission; standard accounts build the cost into a wider spread.",
  },
  {
    q: 'Which platform is best?',
    a: "MetaTrader 4 and 5 suit expert advisors, indicators and backtesting. cTrader is a common alternative for execution quality and custom bots. Check that the broker lists your platform before you deposit.",
  },
  {
    q: 'Is forex trading risky?',
    a: "Yes. Leverage magnifies losses as well as gains, prices can gap on news, and a weak broker adds counterparty risk. Keep position sizes small, use stops where your strategy allows, and test on a demo account first.",
  },
  {
    q: 'Is forex trading legal?',
    a: "In most countries, yes, but rules differ. Confirm the broker may accept clients from your country. The country picker above hides the brokers that list yours as restricted.",
  },
  {
    q: 'How do I check a broker is regulated?',
    a: "Find the licence number on the broker's site, search it on the regulator's public register, and match the company name and country. Do not rely on a logo or a claim on the broker's own page.",
  },
  {
    q: 'How do I avoid forex scams?',
    a: "Walk away from guaranteed returns, unsolicited offers and pressure to deposit quickly. Verify the licence yourself and request a small withdrawal early, before you add more capital.",
  },
  {
    q: 'Which broker suits my style?',
    a: "Beginners: regulated, with a demo account and a low deposit. Scalpers: raw spreads and fast execution. Algorithmic traders: MT4 or MT5, stable servers and no restrictions on expert advisors.",
  },
];
/** The ranked broker list, in the order the page shows it. */
const brokerList = brokers.map((broker) => ({ name: broker.key }));

// `title` is "Best Forex Brokers 2026 – Trusted, Regulated, …"; the trailing
// clause becomes the gradient half of the headline.
const [h1main, h1sub] = String(data.title).split('–').map((part) => part.trim());
const updated = formatDate(data.updatedAt ?? data.publishedAt);

const trail = breadcrumbTrail([
  { name: 'Home', href: '/' },
  { name: data.title, href: url('/best-forex-brokers') },
]);
---

<BaseLayout
  title={data.seo.title || data.title}
  description={data.seo.description || data.description}
  canonical={data.seo.canonical}
  ogImage={data.seo.ogImage || data.featuredImage}
  jsonLd={[breadcrumbSchema(trail), itemListSchema('Best forex brokers', brokerList), faqSchema(faqs)]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="glow-orb animate-aurora left-1/2 top-[-14rem] h-[26rem] w-[38rem] -translate-x-1/2 bg-emerald-500/25"
    ></div>
    <div class="glow-orb animate-float right-[-6rem] top-[4rem] h-[18rem] w-[18rem] bg-teal-400/10"></div>
    <div class="grid-overlay pointer-events-none absolute inset-0"></div>

    <div class="container-x relative py-20 text-center lg:py-24">
      <span
        class="eyebrow animate-fade-in-up inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-4 py-2"
      >
        <span class="live-dot"></span>Regulation-first · Updated {updated}
      </span>

      <h1
        class="animate-fade-in-up-delay-1 mx-auto mt-6 max-w-4xl text-4xl font-bold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl"
      >
        {h1main}
        {h1sub && <span class="text-gradient-brand"> {h1sub}</span>}
      </h1>

      <p class="animate-fade-in-up-delay-2 mx-auto mt-6 max-w-2xl text-base leading-8 text-[var(--color-ink-soft)] sm:text-lg">
        The platforms we test our own expert advisors on. Compare regulation, minimum deposit and platform support, then
        check the terms at the broker before you fund anything.
      </p>

      <div class="animate-fade-in-up-delay-3 mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href="#picks" class="btn btn-primary !px-7 !py-3.5 !text-base">See the top picks</a>
        <a href={url('/shop')} class="btn btn-ghost !px-6 !py-3.5 !text-base">Browse the EA library</a>
      </div>

      <!-- The full list: first thing under the headline. -->
      <div class="mt-16 text-left">
        <SectionHead
          align="center"
          kicker="The full list"
          title={`Forex brokers rating in ${monthYear}`}
          lead="Sort the table, choose your country, or tick up to three brokers to compare them side by side. Offers are each broker's own promotion."
          id="all-heading"
        />
        <div class="reveal mt-12 w-full">
          <BrokerExplorer rows={explorerRows} countries={countryData.countries} statuses={countryStatuses} verifiedAt={countriesVerifiedAt} />
        </div>
        <!-- Disclosure sits under the table, at the owner's request. -->
        <p class="mx-auto mt-8 max-w-2xl text-center rounded-xl border border-[var(--color-line)] bg-white/[0.02] px-4 py-3 text-xs leading-6 text-[var(--color-ink-dim)]">
          {AFFILIATE_DISCLOSURE}
        </p>
      </div>
    </div>
  </section>

  <!-- Top picks -->
  <section id="picks" class="border-t border-white/5" aria-labelledby="picks-heading">
    <div class="container-x py-20 lg:py-24">
      <SectionHead
        align="center"
        kicker="Where we test"
        title="The two best forex brokers we build on"
        lead="Every expert advisor we sell is developed against these platforms, so they are the ones we can describe in detail."
        id="picks-heading"
      />
      <div class="reveal mx-auto mt-12 grid max-w-4xl gap-5 md:grid-cols-2">
        {picks.map((broker, index) => <BrokerCard broker={broker} rank={index + 1} />)}
      </div>
    </div>
  </section>

  <!-- Short guide: answer-first, so it reads well in search snippets and AI answers -->
  <section class="border-t border-white/5" aria-labelledby="guide-heading">
    <div class="container-x py-20 lg:py-24">
      <SectionHead
        align="center"
        kicker="Quick guide"
        title="How to choose a forex broker"
        lead="Short answers to the questions traders ask before they open an account."
        id="guide-heading"
      />
      <div class="reveal mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          guide.map((item) => (
            <article class="panel p-6">
              <h3 class="text-lg font-bold text-white">{item.q}</h3>
              <p class="mt-2 text-sm leading-7 text-[var(--color-ink-soft)]">{item.a}</p>
            </article>
          ))
        }
      </div>
      <p class="mx-auto mt-8 max-w-3xl text-center text-sm leading-7 text-[var(--color-ink-soft)]">
        See how we compare brokers on our <a href={url('/methodology')} class="text-emerald-300 underline underline-offset-4">methodology page</a>.
        This is general information, not financial advice.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-white/5 bg-zinc-950/20" aria-labelledby="broker-faq-heading">
    <div class="container-x py-20 lg:py-24">
      <SectionHead
        align="center"
        kicker="Questions"
        title="Before you open an account"
        lead="Straight answers on how we choose, what the bonuses mean and which broker suits an automated strategy."
        id="broker-faq-heading"
      />
      <div class="reveal mx-auto mt-12 max-w-3xl">
        <Faq items={faqs} heading="Frequently asked questions" />
      </div>
      <p class="mx-auto mt-8 max-w-3xl text-center text-xs leading-6 text-[var(--color-ink-dim)]">{RISK_DISCLAIMER}</p>
    </div>
  </section>

  <!-- Next step -->
  <section class="border-t border-white/5">
    <div class="container-x py-20 lg:py-24">
      <div class="brand-card reveal overflow-hidden p-8 text-center sm:p-12">
        <h2 class="text-2xl font-bold sm:text-3xl">Ready to pick the system to run?</h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-[var(--color-ink-dim)]">
          Every licence includes the setup guide, presets and the tracked record on its product page.
        </p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href={url('/top-ranking')} class="btn btn-primary !px-7 !py-3.5 !text-base">Compare all systems</a>
          <a href={url('/shop')} class="btn btn-ghost !px-6 !py-3.5 !text-base">Browse the EA library</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Premium highlight for RoboForex in the full ranked list. */
  .premium-row {
    border-color: rgba(212, 175, 55, 0.6) !important;
    background:
      radial-gradient(120% 90% at 0% 0%, rgba(212, 175, 55, 0.16), transparent 60%),
      linear-gradient(160deg, rgba(24, 19, 6, 0.94), rgba(0, 0, 0, 0.88) 60%) !important;
    box-shadow:
      inset 0 1px 0 rgba(255, 236, 170, 0.2),
      0 0 0 1px rgba(212, 175, 55, 0.14),
      0 30px 80px -30px rgba(212, 175, 55, 0.6);
  }
  .premium-row h3 {
    background: linear-gradient(90deg, #fff4c7, #e9c25b 55%, #fff4c7);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .premium-row .premium-row__badge {
    background: linear-gradient(135deg, #f5d77a, #b8891c) !important;
    color: #1a1204 !important;
    box-shadow: 0 6px 20px -6px rgba(212, 175, 55, 0.7);
  }
</style>
