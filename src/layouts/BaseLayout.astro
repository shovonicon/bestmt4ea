---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import BackToTop from '../components/BackToTop.astro';
import TelegramFab from '../components/TelegramFab.astro';
import ParticleField from '../components/ParticleField.astro';
import ObsidianPromo from '../components/ObsidianPromo.astro';
import { site } from '../lib/site';
import { canonicalFor, resolveImage } from '../lib/urls';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  robots?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Open Graph object type — `article` for posts and product/review pages. */
  ogType?: 'website' | 'article';
  published?: Date;
  updated?: Date;
  author?: string;
}

const {
  title,
  description = site.description,
  canonical,
  ogImage = site.ogImage,
  robots,
  jsonLd,
  noindex = false,
  ogType = 'website',
  published,
  updated,
  author,
} = Astro.props;

const pageTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
/** Self-canonical by default; a `seo.canonical` override wins when present. */
const canonicalUrl = canonicalFor(Astro.url.pathname, canonical);
/** OG images from the WordPress export can be relative — social needs absolute. */
const candidateOg = resolveImage(ogImage);
/**
 * The import's `ogImage` values point at the deleted `wp-content` folder, so a
 * broken one falls back to the branded banner rather than shipping a 404 to
 * every social crawler.
 */
const ogImageUrl = candidateOg && !candidateOg.includes('/wp-content/') ? candidateOg : resolveImage(site.ogImage);
const robotsContent = noindex ? 'noindex, nofollow' : robots || 'index, follow, max-image-preview:large';
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:alt" content={pageTitle} />}
    {ogType === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
    {ogType === 'article' && updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {ogType === 'article' && author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="apple-touch-icon" href="/favicon.webp" />

    <!--
      Fonts are self-hosted: see src/styles/fonts.css, generated by
      scripts/fetch-fonts.mjs. There is no third-party font request on page view.
    -->
    <link rel="preload" href="/fonts/manrope-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/sora-700-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!--
      AdSense is loaded by AdSlot itself, on the first unit that actually renders.
      Loading it here meant every page — the homepage, product pages, the dashboard —
      pulled ~180 KB of JavaScript for ads that were never shown.
    -->

    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <ParticleField />
    <ReadingProgress />
    <Header />
    <main class="relative z-10 flex-1 pt-16">
      <slot />
    </main>
    <ObsidianPromo />
    <Footer />
    <BackToTop />
    <TelegramFab />
  </body>
</html>
