                    <tr>
                      <th scope="row">
                        <a
                          href={url(`/product/${item.data.slug}/`)}
                          class="font-semibold text-[var(--color-ink] hover:text-[var(--color-accent]"
                        >
                          {item.data.title}
                        </a>
                      </th>
                      <td class="metric-value text-[var(--color-accent]">
                        {p?.totalGainPct != null ? formatSignedPercent(p.totalGainPct) : '—'}
                      </td>
                      <td class="metric-value text-[var(--color-danger]">
                        {p?.maxDrawdownPct != null ? `${p.maxDrawdownPct}%` : '—'}
                      </td>
                      <td class="metric-value">{p?.profitFactor != null ? String(p.profitFactor) : '—'}</td>
                      <td class="text-[var(--color-ink-soft]">
                        {item.data.platform === 'none' ? 'MT4 / MT5' : item.data.platform}
                      </td>
                      <td class="text-[var(--color-ink-soft]">
                        {p?.accountType === 'real' ? 'Real' : p?.accountType === 'demo' ? 'Demo' : '—'}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              {related.map((item) => (
                <a href={url(`/product/${item.data.slug}/`)} class="hover-brand-card flex items-center gap-4 p-5">
                  {item.data.featuredImage && (
                    <img
                      src={item.data.featuredImage}
                      alt={item.data.title}
                      class="h-24 w-24 flex-shrink-0 rounded-2xl object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <span class="min-w-0">
                    <span class="block text-base font-semibold leading-6 text-[var(--color-ink]">{item.data.title}</span>
                    <span class="mt-1 block text-xs text-[var(--color-ink-dim]">
                      {item.data.platform === 'none' ? 'MT4 / MT5' : item.data.platform} ·{' '}
                      {item.data.productCategories[0] ?? 'Expert Advisor'}
                    </span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <Faq items={faqs} heading="Questions about this system" />

      <section class="rounded-2xl border border-[var(--color-warn]/30 bg-[var(--color-warn]/5 p-5">
        <h2 class="text-sm font-semibold text-[var(--color-warn]">Risk warning</h2>
        <p class="mt-2 text-xs leading-6 text-[var(--color-ink-soft]">{RISK_DISCLAIMER}</p>
      </section>
    </div>

    {/* -------------------------------------------------------------- ASIDE */}
    <aside class="min-w-0">
      <div class="sticky top-24 space-y-4" id="acquire">
        <section class="brand-card p-6">
          {/* A real form: the plan radios below post as `plan`, so checkout works
              with no JavaScript at all. `method` comes from the chosen button. */}
          <form id="checkout-form" method="post" action="/api/checkout/">
            <input type="hidden" name="productId" value={product.data.slug} />
            <div class="flex items-start justify-between gap-3">
            <div>
              <p class="metric-label">Licence</p>
              <p class="display-stat mt-2 text-3xl" data-plan-price>{selectedPriceLabel}</p>
            </div>
            {discountPct > 0 && <span class="ribbon">-{discountPct}%</span>}
          </div>

          {
            plans.length > 0 ? (
              <fieldset class="mt-5" data-plan-group>
                <legend class="sr-only">Choose a licence</legend>
                <div class="space-y-2">
                  {plans.map((plan, index) => (
                    <label class="plan-option flex items-start gap-3 rounded-xl px-3 py-3">
                      <input
                        type="radio"
                        name="plan"
                        value={plan.code}
                        class="mt-1"
                        data-plan-radio
                        data-price-label={planPriceLabel(plan.price)}
                        checked={index === defaultPlanIndex}
                      />
                      <span class="min-w-0 flex-1">
                        <span class="flex items-baseline justify-between gap-2">
                          <span class="text-sm font-semibold text-[var(--color-ink]">
                            {plan.name}
                            {plan.term ? <span class="font-normal text-[var(--color-ink-dim]"> · {plan.term}</span> : null}
                          </span>
                          <span class="metric-value text-sm text-[var(--color-ink]">{planPriceLabel(plan.price)}</span>
                        </span>
                        {plan.badge && (
                          <span class="mt-1 inline-block text-[0.625rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-accent]">
                            {plan.badge}
                          </span>
                        )}
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ) : (
              product.data.variants.length > 0 && (
                <ul class="mt-5 space-y-2">
                  {product.data.variants.map((variant: any) => (
                    <li class="flex items-center justify-between gap-3 rounded-xl border border-[var(--color-line-soft] bg-white/[0.02] px-3 py-2.5">
                      <span class="text-sm text-[var(--color-ink-soft]">{variant.name ?? 'Licence'}</span>
                      <span class="metric-value text-xs text-[var(--color-ink-dim]">
                        {variant.price ? formatMoney(Number(variant.price), currency) : 'included'}
                      </span>
                    </li>
                  ))}
                </ul>
              )
            )
          }

          <ul class="mt-5 space-y-2 text-sm text-[var(--color-ink-soft]">
            <li class="flex gap-2.5">
              <span class="text-[var(--color-accent]" aria-hidden="true">✓</span>Instant access from your dashboard
            </li>
            <li class="flex gap-2.5">
              <span class="text-[var(--color-accent]" aria-hidden="true">✓</span>Setup guide and recommended presets
            </li>
            <li class="flex gap-2.5">
              <span class="text-[var(--color-accent]" aria-hidden="true">✓</span>Telegram support during installation
            </li>
            {
              spec.guarantee && (
                <li class="flex gap-2.5">
                  <span class="text-[var(--color-accent]" aria-hidden="true">✓</span>
                  {spec.guarantee.label}
                </li>
              )
            }
          </ul>

          {
            plans.length > 0 ? (
              <div class="mt-6 grid gap-2">
                <button type="submit" name="method" value="card" data-checkout class="btn btn-primary w-full">
                  Pay by card
                </button>
                <button type="submit" name="method" value="usdt" class="btn btn-ghost w-full">
                  Pay with USDT (TRC20)
                </button>
              </div>
            ) : (
              <a href="/contact/" class="btn btn-ghost mt-6 w-full">Ask about licence options</a>
            )
          }

          <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
            {
              [
                { src: '/media/payments/visa.svg', label: 'Visa' },
                { src: '/media/payments/mastercard.svg', label: 'Mastercard' },
                { src: '/media/payments/stripe.svg', label: 'Stripe' },
                { src: '/media/payments/tether.svg', label: 'USDT (TRC20)' },
              ].map((method) => (
                <span class="brand-chip" title={method.label}>
                  <img
                    src={method.src}
                    alt={method.label}
                    width="24"
                    height="24"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              ))
            }
          </div>

          <p class="mt-3 flex items-center justify-center gap-1.5 text-xs text-[var(--color-ink-dim]">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="h-3.5 w-3.5 text-[var(--color-accent]"
              aria-hidden="true"
            >
              <rect x="4" y="10" width="16" height="10" rx="2"></rect>
              <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
            </svg>
            Secure checkout · Card &amp; USDT (TRC20)
          </p>
          <p class="mt-1 text-center text-xs text-[var(--color-ink-dim]">Checkout is handled by Stripe.</p>
          </form>
        </section>

        <section class="panel p-6">
          <p class="metric-label">Fast specs</p>
          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex justify-between gap-3">
              <dt class="text-[var(--color-ink-dim]">Platform</dt>
              <dd class="text-[var(--color-ink]">{platform}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-[var(--color-ink-dim]">Strategy</dt>
              <dd class="text-right text-[var(--color-ink]">{perf?.strategy ?? '—'}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-[var(--color-ink-dim]">Min capital</dt>
              <dd class="metric-value text-[var(--color-ink]">
                {perf?.minCapitalUsd != null ? formatMoney(perf.minCapitalUsd, 'USD') : '—'}
              </dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-[var(--color-ink-dim]">Max drawdown</dt>
              <dd class="metric-value text-[var(--color-ink]">{drawdown != null ? `${drawdown}%` : '—'}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-[var(--color-ink-dim]">Account</dt>
              <dd class="text-right text-[var(--color-ink]">{isReal ? 'Real' : isDemo ? 'Demo' : 'Not published'}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-[var(--color-ink-dim]">Track record</dt>
              <dd class="text-right text-[var(--color-ink]">
                {live?.sourceUrl || perf?.sourceUrl ? 'Myfxbook-verified' : 'Not published'}
              </dd>
            </div>
          </dl>
        </section>

        {
          raw?.summary && raw.summary.length > 0 && (
            <section class="panel p-6">
              <p class="metric-label">Account snapshot</p>
              <dl class="mt-4 space-y-3 text-sm">
                {raw.summary.slice(0, 4).map(([label, value]) => (
                  <div class="flex justify-between gap-3">
                    <dt class="text-[var(--color-ink-dim]">{label}</dt>
                    <dd class="metric-value text-[var(--color-ink]">{value}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )
        }

        <section class="panel-flat p-5">
          <p class="text-xs leading-6 text-[var(--color-ink-dim]">
            {hasLive
              ? 'Figures are synchronized from the public third-party tracking account on a schedule. Always confirm current results at the source before purchasing.'
              : perf?.verified
                ? 'Figures were transcribed from the public third-party tracking account. Always confirm current results at the source before purchasing.'
                : 'No third-party tracking account is published for this system. The figures on this page come from the published Strategy Tester backtests, not from live trading.'}
          </p>
        </section>
      </div>
    </aside>
  </div>

  {/* Mobile sticky buy bar. The right padding keeps the floating Telegram
      button clear of the checkout CTA. */}
  <div class="fixed inset-x-0 bottom-0 z-40 border-t border-[var(--color-line] bg-black/90 py-3 pl-4 pr-[4.75rem] backdrop-blur lg:hidden">
    <div class="flex items-center justify-between gap-3">
      <div class="min-w-0">
        <p class="metric-label">From</p>
        <p class="metric-value truncate text-lg" data-plan-price>{selectedPriceLabel}</p>
      </div>
      <a href="#acquire" class="btn btn-primary">Get licence</a>
    </div>
  </div>

  <script>
    /*
     * Licence selection.
     *
     * The radios carry the plan code and the pre-formatted price, so a single
     * change handler drives every price on the page (the sidebar figure and the
     * sticky bar) without duplicating pricing logic on the client. The checkout
     * call reads the checked radio's value as the plan code.
     *
     * Selection styling is CSS-only (`:has(input:checked)`), so the panel is
     * correct before this runs and with JS disabled.
     */
    document.querySelectorAll<HTMLElement>('[data-plan-group]').forEach((group) => {
      if (group.dataset.planReady === '1') return;
      group.dataset.planReady = '1';
      const radios = Array.from(group.querySelectorAll<HTMLInputElement>('[data-plan-radio]'));
      if (radios.length === 0) return;

      const paint = () => {
        const chosen = radios.find((radio) => radio.checked);
        if (!chosen) return;
        document.querySelectorAll<HTMLElement>('[data-plan-price]').forEach((out) => {
          out.textContent = chosen.dataset.priceLabel ?? out.textContent;
        });
      };
      radios.forEach((radio) => radio.addEventListener('change', paint));
      paint();

      // "Get lifetime" / "Get 12 months" buttons in the pricing section pick the
      // matching tier and bring the panel into view.
      document.querySelectorAll<HTMLElement>('[data-select-plan]').forEach((button) => {
        button.addEventListener('click', () => {
          const target = radios.find((radio) => radio.value === button.dataset.selectPlan);
          if (target) {
            target.checked = true;
            target.dispatchEvent(new Event('change', { bubbles: true }));
          }
          document.getElementById('acquire')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
    });
  </script>
</BaseLayout>
