---
/**
 * Product page layout (licensed EAs, indicators, tools).
 *
 * A "decide" surface: it exists so someone can decide. Composition:
 * hero pitch -> headline live figures -> tabbed track record -> result gallery ->
 * verification -> requirements -> pros/cons -> parameters -> features -> fit ->
 * installation -> pricing -> guarantee -> reviews -> partners -> recommended VPS -> cross-sell.
 *
 * Account type is never assumed: a demo account renders a "Demo funds" badge, so
 * a tracked demo can never be presented as a live result. Every figure carries
 * the time it was checked.
 *
 * Editorial content comes from src/data/*.json — the markdown bodies are NOT
 * rendered and must not be edited (the changed-content gate treats any edit to a
 * legacy import as a full compliance requirement).
 */
import BaseLayout from './BaseLayout.astro';
import Faq from '../components/Faq.astro';
import CountUp from '../components/CountUp.astro';
import SectionHead from '../components/SectionHead.astro';
import ProductPerformance from '../components/ProductPerformance.astro';
import ResultsSlider from '../components/ResultsSlider.astro';
import { getPerformance } from '../lib/performance';
import type { LatestPerformance } from '../server/performance';
import { formatMoney, formatPriceRange, formatDate, formatSignedPercent } from '../lib/format';
import { site, RISK_DISCLAIMER } from '../lib/site';
import { affiliates, AFFILIATE_REL, AFFILIATE_DISCLOSURE, type AffiliateOffer } from '../lib/affiliates';
import siteStats from '../data/site-stats.json';
import resultSlideData from '../data/result-slides.json';
import planData from '../data/product-plans.json';
import detailData from '../data/product-detail.json';
import { productSchema, breadcrumbSchema, breadcrumbTrail } from '../lib/seo';
import { url } from '../lib/urls';

export interface Props {
  product: any;
  related?: any[];
  live?: LatestPerformance | null;
  series?: Array<{ capturedAt: number; growthPct: string | null; profitCents: number | null }>;
  reviews?: Array<{ rating: number; body: string; name: string; createdAt: number }>;
  systems?: number;
  /** The VPS product to recommend for running the system. */
  vps?: any;
}

const { product, related = [], live = null, series = [], reviews = [], systems = 0, vps = null } = Astro.props;

const base = getPerformance(product.data.slug);
// A live D1 snapshot (from the MyFxBook collector) wins over the transcribed
// figures, and switches the record to a real "synchronized" state.
const perf = live
  ? ({
      ...(base ?? {
        hasData: true,
        verified: true,
        isLiveAccount: live.accountType === 'real',
        stale: false,
        conflicts: [],
      }),
      totalGainPct: live.growthPct != null ? Number(live.growthPct) : base?.totalGainPct,
      maxDrawdownPct: live.drawdownPct != null ? Number(live.drawdownPct) : base?.maxDrawdownPct,
      profitFactor: live.profitFactor != null ? Number(live.profitFactor) : base?.profitFactor,
      accountType: live.accountType ?? base?.accountType,
      sourceUrl: live.sourceUrl ?? base?.sourceUrl,
      lastVerified: live.capturedAt,
      stale: false,
      live: {},
    } as NonNullable<typeof base>)
  : base;

// `platform: none` in the imported frontmatter means "not stated" — fall back to
// the product's own brands before assuming both terminals.
const platform =
  product.data.platform !== 'none'
    ? product.data.platform
    : product.data.brands?.length
      ? product.data.brands.join(' / ')
      : 'MT4 / MT5';
// Hero eyebrow label when the product publishes no strategy of its own.
const productKind = product.data.productCategories?.includes('Indicator') ? 'Indicator' : 'Expert Advisor';
const currency = product.data.currency || 'USD';
const priceLabel = formatPriceRange(product.data.priceMin, product.data.priceMax, currency);
const updatedLabel = product.data.updatedAt ?? product.data.publishedAt;

const hasLive = Boolean(live);
const accountType = (live?.accountType ?? perf?.accountType) ?? null;
const isDemo = accountType === 'demo';
const isReal = accountType === 'real';

// The freshness line is the honesty anchor: a real synchronization time when the
// collector has run, otherwise the date the transcribed record was checked.
const syncedLabel = live
  ? `Synchronized ${new Intl.DateTimeFormat('en-GB', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: 'UTC',
    }).format(live.capturedAt)} UTC from Myfxbook`
  : perf?.lastVerified
    ? `Transcribed from the published account record, checked ${formatDate(perf.lastVerified)}`
    : 'Transcribed from the published account record';

const gain = live?.growthPct != null ? Number(live.growthPct) : perf?.totalGainPct;
const drawdown = live?.drawdownPct != null ? Number(live.drawdownPct) : perf?.maxDrawdownPct;
const profitFactor = live?.profitFactor != null ? Number(live.profitFactor) : perf?.profitFactor;

// The headline figures, rendered as oversized counters.
const headline = [
  {
    label: 'Total gain',
    value: gain != null ? formatSignedPercent(gain) : '—',
    tone: gain != null && gain < 0 ? 'text-[var(--color-danger]' : 'text-[var(--color-accent]',
  },
  { label: 'Max drawdown', value: drawdown != null ? `${drawdown}%` : '—', tone: 'text-[var(--color-danger]' },
  { label: 'Profit factor', value: profitFactor != null ? String(profitFactor) : '—', tone: 'text-[var(--color-ink]' },
  {
    label: live?.winRatePct != null ? 'Win rate' : 'Trades',
    value:
      live?.winRatePct != null
        ? `${live.winRatePct}%`
        : perf?.totalTrades != null
          ? String(perf.totalTrades)
          : '—',
    tone: 'text-[var(--color-ink]',
  },
];

// Headline figures and the track-record terminal only appear when there are real
// figures behind them. A backtest-only or indicator product has none, so both are
// hidden rather than rendered as a row of dashes under a "transcribed" caption.
const hasHeadlineFigures = [gain, drawdown, profitFactor].some((value) => value != null);

// The full Myfxbook metric set, mirrored verbatim from the tracked account.
type StatPair = [string, string];
const raw = (live?.raw ?? null) as null | {
  header?: string;
  chips?: string[];
  updated?: string;
  summary?: StatPair[];
  periods?: Array<{
    label: string;
    gain: string;
    profit: string;
    pips: string;
    win: string;
    trades: string;
    lots: string;
  }>;
  /** Myfxbook's month-by-month breakdown, when the collector captures it. */
  monthly?: Array<{ label?: string; gain?: string; profit?: string }>;
  statistics?: StatPair[];
};

// Real synced growth points, and a month-over-month view derived from them.
// Nothing here is invented: a month appears only when real captures exist for it.
const growthPoints = series.filter((p) => p.growthPct != null);
const byMonth = new Map<
  string,
  {
    label: string;
    first: number;
    last: number;
    captures: number;
    profitFirst: number | null;
    profitLast: number | null;
  }
>();
for (const point of growthPoints) {
  const date = new Date(point.capturedAt);
  const key = `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, '0')}`;
  const label = date.toLocaleString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
  const value = Number(point.growthPct);
  const entry = byMonth.get(key);
  if (!entry) {
    byMonth.set(key, {
      label,
      first: value,
      last: value,
      captures: 1,
      profitFirst: point.profitCents ?? null,
      profitLast: point.profitCents ?? null,
    });
  } else {
    entry.last = value;
    entry.captures += 1;
    if (point.profitCents != null) entry.profitLast = point.profitCents;
  }
}
// A month needs at least two captures before it has a change to report. A single
// capture is a snapshot, not a month's result, and would read as a flat 0.00%.
const derivedMonthly = [...byMonth.entries()]
  .filter(([, m]) => m.captures > 1)
  .sort((a, b) => (a[0] < b[0] ? -1 : 1))
  .map(([, m]) => ({
    label: m.label,
    gain: `${m.last - m.first >= 0 ? '+' : ''}${(m.last - m.first).toFixed(2)}%`,
    value: Number((m.last - m.first).toFixed(2)),
    profit:
      m.profitFirst != null && m.profitLast != null
        ? formatMoney((m.profitLast - m.profitFirst) / 100, currency)
        : '—',
  }));

// Best source first: Myfxbook's own month-by-month breakdown when the collector
// captures it (`raw.monthly`), otherwise the months we can derive from our own
// synced history. Nothing is invented — a month appears only when data backs it.
const rawMonthly = Array.isArray(raw?.monthly) ? raw.monthly : [];
const monthly = rawMonthly.length
  ? rawMonthly.map((m) => {
      const gain = String(m.gain ?? '');
      const parsed = Number(gain.replace(/[^\d.-]/g, ''));
      const value = Number.isFinite(parsed) ? parsed : 0;
      return {
        label: String(m.label ?? ''),
        gain: gain || `${value >= 0 ? '+' : ''}${value.toFixed(2)}%`,
        value,
        profit: m.profit != null ? String(m.profit) : '—',
      };
    })
  : derivedMonthly;

// ---- Data-driven premium blocks -------------------------------------------
type Plan = {
  code: string;
  name: string;
  term?: string;
  price: number;
  compareAt?: number;
  badge?: string;
  cta?: string;
  features?: string[];
};
type ProductDetail = {
  tagline?: string;
  overview?: string;
  settings?: Array<{ label: string; value: string; icon?: string }>;
  /** Feature grid, used when the content frontmatter carries no keyTakeaways. */
  features?: string[];
  /** Overrides the results-gallery wording when the images are not live results. */
  gallery?: { eyebrow?: string; title?: string; note?: string; footnote?: string };
  pros?: string[];
  cons?: string[];
  parameters?: Array<{ variable: string; value: string; description: string }>;
  verification?: {
    backtest?: { rows: string[][]; note?: string };
    live?: { rows: string[][]; note?: string };
    report?: string;
  };
  fit?: { good: string[]; notFit: string[] };
  installation?: Array<{ step: string; text: string }>;
  included?: string[];
  comparison?: { columns: string[]; rows: string[][] };
  guarantee?: { label: string; text: string };
};

const plans = ((planData as unknown as Record<string, Plan[]>)[product.data.slug]) ?? [];
const spec = ((detailData as unknown as Record<string, ProductDetail>)[product.data.slug]) ?? {};
const parameters = spec.parameters ?? [];
// The feature grid reads the content frontmatter first, then the detail entry, so
// a product without keyTakeaways still renders the section.
const features: string[] = product.data.keyTakeaways?.length ? product.data.keyTakeaways : (spec.features ?? []);
// Not every product publishes a backtest; the tab is disabled rather than empty.
const hasBacktest = Boolean(spec.verification?.backtest?.rows?.length);
// The forward-test tab only exists when there is a real tracked account to show.
const hasForwardTest = Boolean(live || perf?.verified);
const firstVerifyTab = hasBacktest ? 'backtest' : hasForwardTest ? 'live' : 'report';

// The sidebar radios are the single source of truth for the licence price shown
// in the panel and the sticky bar (and, once checkout is wired, for what is
// bought). Default to the flagged "most popular" tier so the server renders the
// same price the client shows before any script runs.
const planPriceLabel = (price: number) => (price > 0 ? formatMoney(price, currency) : 'Free');
const defaultPlanIndex = Math.max(0, plans.findIndex((plan) => plan.badge === 'Most popular'));
const defaultPlan = plans[defaultPlanIndex] ?? null;
const selectedPriceLabel = defaultPlan ? planPriceLabel(defaultPlan.price) : priceLabel;
const resultSlides =
  ((resultSlideData as unknown as Record<string, Array<{ src: string; alt?: string }>>)[product.data.slug]) ?? [];
// The two brokers our systems are actually built and tested on, featured as a
// recommendation rather than a full logo wall.
const partners: AffiliateOffer[] = [affiliates.roboforex, affiliates.exness];

// Real discount, straight from the store's own numbers: content fields first,
// then the plan-level compare-at where the store itself shows a saving.
const regularPrice = Number(product.data.regularPrice ?? 0);
const salePrice = Number(product.data.salePrice ?? 0);
const contentDiscount =
  regularPrice > 0 && salePrice > 0 && salePrice < regularPrice
    ? Math.round(((regularPrice - salePrice) / regularPrice) * 100)
    : 0;
const comparePlan = plans.find((plan) => plan.compareAt && plan.compareAt > plan.price);
const planDiscount = comparePlan?.compareAt
  ? Math.round(((comparePlan.compareAt - comparePlan.price) / comparePlan.compareAt) * 100)
  : 0;
const discountPct = contentDiscount || planDiscount;

const reviewCount = reviews.length;
const reviewAverage = reviewCount > 0 ? reviews.reduce((sum, r) => sum + r.rating, 0) / reviewCount : 0;

const [titleMain, titleSub] = String(product.data.title).split(':');

const settingIcons: Record<string, string> = {
  pair: 'M3 12h18M7 8l-4 4 4 4M17 8l4 4-4 4',
  platform: 'M4 5h16v10H4zM9 19h6',
  equity: 'M12 3v18M8 7h6.5a3 3 0 0 1 0 6H8m0 0h7.5',
  timeframe: 'M12 8v4.5l3 2M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z',
  strategy: 'M4 19V5m0 14h16M8 15l3-4 3 3 4-6',
  broker: 'M4 9l8-5 8 5M5 9v10h14V9M9 19v-6h6v6',
  track: 'M12 3l8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3z',
  setup: 'M13 2 3 14h7l-1 8 10-12h-7l1-8z',
};
const featureIcons = [
  'M13 2 3 14h7l-1 8 10-12h-7l1-8z',
  'M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3z',
  'M4 6h16M4 12h10M4 18h16',
  'M4 19V5m0 14h16M8 15l3-4 3 3 4-6',
  'M21 12a9 9 0 1 1-3-6.7M21 3v6h-6',
  'M4 5h16v11H8l-4 4V5z',
];

// Cross-sell rows, each carrying the same real figures as the page above it.
const relatedWithPerf = related.map((item) => ({ item, p: getPerformance(item.data.slug) }));

const trail = breadcrumbTrail([
  { name: 'Home', href: '/' },
  { name: 'Shop', href: url('/shop') },
  { name: product.data.title, href: url(`/product/${product.data.slug}/`) },
]);

// What the gallery actually shows decides its wording — a backtest or an
// indicator example must never be presented as a live trading result.
const galleryCopy = spec.gallery ?? {
  eyebrow: perf?.verified ? 'Results' : hasBacktest ? 'Backtest' : 'Charts',
  title: perf?.verified ? 'Live trading results' : hasBacktest ? 'Backtest reports' : 'Chart examples',
  note: perf?.verified
    ? undefined
    : hasBacktest
      ? 'Strategy Tester reports published with the product. Open any image full size.'
      : 'Example charts published with the product. Open any image full size.',
  footnote: perf?.verified
    ? undefined
    : hasBacktest
      ? 'These are backtests, not live trading results. The verification section above carries the figures and their modelling quality.'
      : 'These images show the product on live charts. They are illustrations of what it does, not a performance record.',
};

// The minimum account size the product itself recommends, when it publishes one.
const minEquity = spec.settings?.find((setting) => /minimum equity|min balance/i.test(setting.label))?.value;

const faqs = [
  {
    question: `What platform does ${product.data.title} run on?`,
    answer: `It runs on ${platform}. Installation steps and the recommended account configuration are included with every licence.`,
  },
  {
    question: 'What is the minimum account balance?',
    answer: perf?.minCapitalUsd
      ? `We recommend a minimum of ${formatMoney(perf.minCapitalUsd, 'USD')}. Smaller balances can still run the system, but position sizing becomes constrained by your broker's minimum lot size.`
      : minEquity
        ? `The recommended minimum for this system is ${minEquity}. Smaller balances can still run it, but position sizing becomes constrained.`
        : 'This product does not publish a minimum account size — trade it within your own risk limits.',
  },
  {
    question: 'Are the results shown here live or backtested?',
    answer: perf?.verified
      ? 'The performance panel links directly to the third-party account it was taken from, so you can verify every figure yourself. Where the account holds demo funds rather than live money, the page states that. Past performance does not predict future results.'
      : hasBacktest
        ? 'The figures on this page come from the published Strategy Tester backtests, not from a live-traded account — no third-party account is published for this system. The backtest tab states the modelling quality, which is what tells you how much to trust a simulation. Past performance does not predict future results.'
        : 'No third-party account and no backtest is published for this product. Judge it on the live charts and its own documentation before buying anything.',
  },
  {
    question: 'How current are the figures on this page?',
    answer: hasLive
      ? 'The figures are synchronized from the public tracking account on a schedule, and the panel states the exact time of the last synchronization. Always confirm current results at the source link before purchasing.'
      : perf?.verified
        ? 'The figures were transcribed from the public tracking account and the panel states the date they were checked. Always confirm current results at the source link before purchasing.'
        : 'There are no third-party figures here to keep current — the numbers published for this system are backtests, which do not update. Treat them as historical simulations.',
  },
  {
    question: 'Do I need a VPS?',
    answer:
      'A VPS is strongly recommended. These systems execute intraday and need the terminal running continuously, independent of your home connection or machine.',
    link: { href: url('/product/vps'), label: 'See our recommended VPS →' },
  },
];
---

<BaseLayout
  title={product.data.seo.title || product.data.title}
  description={product.data.seo.description || product.data.description}
  canonical={product.data.seo.canonical}
  ogImage={product.data.seo.ogImage || product.data.featuredImage}
  jsonLd={[
    productSchema(product, { currency, min: product.data.priceMin, max: product.data.priceMax }),
    breadcrumbSchema(trail),
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ]}
>
  {/* ---------------------------------------------------------------- HERO */}
  <header class="relative overflow-hidden">
    <div class="glow-orb left-[-6rem] top-[-8rem] h-[26rem] w-[26rem] bg-[var(--color-accent]/25" aria-hidden="true"></div>
    <div class="glow-orb right-[-4rem] top-[2rem] h-[20rem] w-[20rem] bg-[var(--color-info]/15" aria-hidden="true"></div>
    <div class="grid-overlay absolute inset-0" aria-hidden="true"></div>

    <div class="container-x relative pb-12 pt-8">
      <nav aria-label="Breadcrumb" class="text-xs text-[var(--color-ink-dim]">
        <a href="/" class="hover:text-[var(--color-accent]">Home</a>
        <span class="mx-2">/</span>
        <a href={url('/shop')} class="hover:text-[var(--color-accent]">Shop</a>
        <span class="mx-2">/</span>
        <span class="text-[var(--color-ink-soft]">{product.data.title}</span>
      </nav>

      <div class="mt-8 grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_25rem]">
        <div class="animate-fade-in-up">
          <p class="section-mark eyebrow">
            <span>{perf?.strategy ?? productKind} · Updated {formatDate(updatedLabel)}</span>
          </p>

          <h1 class="mt-4 text-4xl leading-[1.05] sm:text-5xl lg:text-[3.5rem]">
            {titleMain}
            {
              titleSub && (
                <>
                  <br />
                  <span class="text-gradient-brand">{titleSub}</span>
                </>
              )
            }
          </h1>

          <p class="mt-5 max-w-2xl text-base leading-7 text-[var(--color-ink-soft] sm:text-lg">
            {spec.tagline ?? product.data.description}
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
            <span class="inline-flex items-center gap-2 text-[var(--color-ink-dim]">
              <span class="live-dot" aria-hidden="true"></span>
              {siteStats.customers} customers · {systems} systems
            </span>
          </div>

          <div class="mt-6 flex flex-wrap gap-2">
            {
              raw?.chips && raw.chips.length > 0 ? (
                raw.chips.map((chip) => <span class="badge">{chip}</span>)
              ) : (
                <>
                  <span class="badge">{platform}</span>
                  {perf?.strategy && <span class="badge">{perf.strategy}</span>}
                  {isReal && <span class="badge badge-accent">Real account</span>}
                </>
              )
            }
          </div>

          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a href="#acquire" class="btn btn-primary !px-7 !py-3.5 !text-base">Get licence</a>
            {
              live?.sourceUrl || perf?.sourceUrl ? (
                <a
                  href={live?.sourceUrl || perf?.sourceUrl}
                  rel="sponsored nofollow noopener"
                  class="btn btn-ghost !px-6 !py-3.5 !text-base"
                >
                  Verify on Myfxbook
                </a>
              ) : (
                <a href={site.telegram.support} rel="noopener" class="btn btn-ghost !px-6 !py-3.5 !text-base">
                  Telegram support
                </a>
              )
            }
          </div>

          <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-xs text-[var(--color-ink-dim]">
            {
              spec.guarantee && (
                <li class="inline-flex items-center gap-1.5">
                  <span class="text-[var(--color-accent]" aria-hidden="true">🔒</span>
                  {spec.guarantee.label}
                </li>
              )
            }
            <li class="inline-flex items-center gap-1.5">
              <span class="text-[var(--color-accent]" aria-hidden="true">⚡</span>
              Delivered to your dashboard after checkout
            </li>
            {
              spec.included?.includes('Free lifetime updates') && (
                <li class="inline-flex items-center gap-1.5">
                  <span class="text-[var(--color-accent]" aria-hidden="true">♻</span>
                  Free lifetime updates
                </li>
              )
            }
          </ul>

          <div class="mt-6 flex flex-wrap items-center gap-2.5">
            <span class="metric-label">Recommended broker</span>
            {
              partners.map((partner) => (
                <a
                  href={partner.url}
                  rel={AFFILIATE_REL}
                  class="brand-chip"
                  title={partner.note ? `${partner.label} — ${partner.note}` : partner.label}
                >
                  {partner.logo ? (
                    <img src={partner.logo} alt={partner.label} loading="lazy" decoding="async" />
                  ) : (
                    <span class="text-xs font-bold text-[#04140f]">{partner.label}</span>
                  )}
                </a>
              ))
            }
            <a href="#partners-heading" class="text-xs text-[var(--color-ink-dim] underline decoration-dotted">
              Sponsored
            </a>
          </div>
        </div>

        {/* Hero visual */}
        {
          product.data.featuredImage && (
            <div class="animate-fade-in-up-delay-2 relative">
              <div class="glass shadow-glow relative overflow-hidden p-3">
                <img
                  src={product.data.featuredImage}
                  alt={product.data.title}
                  class="h-full w-full rounded-2xl object-cover"
                  width="800"
                  height="800"
                />
                <span class="absolute left-5 top-5 inline-flex items-center gap-2 rounded-full border border-[var(--color-accent]/40 bg-black/70 px-3 py-1.5 text-xs font-semibold text-[var(--color-accent-soft] backdrop-blur">
                  <span class="live-dot" aria-hidden="true"></span>
                  {hasLive ? 'Live' : 'Verified'} · {platform}
                </span>
                {gain != null && (
                  <div class="absolute bottom-5 left-5 rounded-2xl border border-[var(--color-accent]/30 bg-black/80 px-4 py-3 backdrop-blur">
                    <p class="metric-label">Total gain</p>
                    <p class="display-stat mt-1 text-3xl text-[var(--color-accent]">
                      <CountUp value={formatSignedPercent(gain)} />
                    </p>
                  </div>
                )}
              </div>
            </div>
          )
        }
      </div>

      {/* Headline figures — only when there are real figures to show. */}
      {
        hasHeadlineFigures && (
          <>
            <div class="stats-panel reveal mt-12">
              {headline.map((stat) => (
                <div class="stats-panel-item">
                  <p class="metric-label">{stat.label}</p>
                  <p class:list={['display-stat mt-3 text-4xl', stat.tone]}>
                    <CountUp value={stat.value} />
                  </p>
                </div>
              ))}
            </div>
            <p class="mt-3 text-center text-xs text-[var(--color-ink-dim]">
              {syncedLabel}
              {isDemo ? ' · tracked account holds demo funds' : ''}
            </p>
          </>
        )
      }
    </div>
  </header>

  <div class="container-x grid gap-12 pb-28 pt-12 lg:grid-cols-[minmax(0,1fr)_22rem]">
