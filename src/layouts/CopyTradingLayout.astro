---
/**
 * Copy-trading / account-management page (/copy-trading/).
 *
 * Layout ported from the reference `app/copy-trading/page.tsx` (Strive Algo):
 * hero → performance snapshot → what it is (+ security card) → how it works →
 * compounding → profit-share plans → testimonials → FAQ → closing CTA.
 *
 * The markdown body is deliberately NOT rendered (same as BrokersLayout): the
 * content comes from `src/data/copy-trading.json`, so the numbers live in one
 * editable place and the page can be rebuilt without a content rewrite.
 */
import BaseLayout from './BaseLayout.astro';
import { site, RISK_DISCLAIMER } from '../lib/site';
import data from '../data/copy-trading.json';

export interface Props {
  entry: any;
}

const { entry } = Astro.props;
const meta = entry.data;

const ICONS: Record<string, string> = {
  shield:
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  lock: '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  trend: '<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>',
  percent: '<line x1="19" x2="5" y1="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/>',
  check: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
  arrow: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  star: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
};

const telegram = site.telegram.community;
---

<BaseLayout
  title={meta.seo?.title || meta.title}
  description={meta.seo?.description || meta.description}
  canonical={meta.seo?.canonical}
  ogImage={meta.seo?.ogImage || meta.featuredImage}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="glow-orb animate-aurora left-1/2 top-[-14rem] h-[26rem] w-[38rem] -translate-x-1/2 bg-emerald-500/25"
    ></div>
    <div class="glow-orb animate-float right-[-6rem] top-[4rem] h-[18rem] w-[18rem] bg-teal-400/10"></div>
    <div class="grid-overlay pointer-events-none absolute inset-0"></div>

    <div class="container-x relative py-20 text-center lg:py-24">
      <span
        class="eyebrow animate-fade-in-up inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-4 py-2"
      >
        <span class="live-dot"></span>AI-driven account management
      </span>

      <h1
        class="animate-fade-in-up-delay-1 mx-auto mt-6 max-w-4xl text-4xl font-bold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl"
      >
        {data.hero.title}
        <span class="text-gradient-brand"> {data.hero.titleAccent}</span>
      </h1>

      <p class="animate-fade-in-up-delay-2 mx-auto mt-6 max-w-2xl text-base leading-8 text-[var(--color-ink-soft)] sm:text-lg">
        {data.hero.subtitle}
      </p>

      <div class="animate-fade-in-up-delay-3 mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href={telegram} rel="noopener" class="btn btn-primary !px-7 !py-3.5 !text-base">
          {data.hero.cta}
          <svg
            viewBox="0 0 24 24"
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={ICONS.arrow}
          />
        </a>
      </div>
    </div>
  </section>

  <!-- Performance snapshot -->
  <section class="border-y border-white/5 bg-emerald-500/[0.02]" aria-label="Service snapshot">
    <div class="container-x grid grid-cols-2 gap-8 py-12 text-center md:grid-cols-4">
      {
        data.stats.map((stat) => (
          <div>
            <p class="display-stat text-3xl text-[var(--color-ink)] sm:text-4xl">{stat.value}</p>
            <p class="metric-label mt-2">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- What it is -->
  <section class="border-t border-white/5" aria-labelledby="about-heading">
    <div class="container-x grid items-center gap-12 py-20 lg:grid-cols-2 lg:py-24">
      <div>
        <span class="eyebrow">{data.about.kicker}</span>
        <h2 id="about-heading" class="mt-3 text-3xl leading-tight md:text-4xl">{data.about.title}</h2>
        {
          data.about.body.map((paragraph) => (
            <p class="mt-5 text-base leading-8 text-[var(--color-ink-soft)]">{paragraph}</p>
          ))
        }
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            data.about.highlights.map((item) => (
              <div class="flex items-start gap-3">
                <svg
                  viewBox="0 0 24 24"
                  class="mt-0.5 h-5 w-5 shrink-0 text-emerald-400"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={ICONS.check}
                />
                <span class="text-sm text-[var(--color-ink-soft)]">{item}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="brand-card reveal p-6 sm:p-8">
        <div class="mb-4 flex items-center gap-4">
          <span class="icon-tile">
            <svg
              viewBox="0 0 24 24"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={ICONS.shield}
            />
          </span>
          <h3 class="text-xl font-bold text-[var(--color-ink)]">{data.security.title}</h3>
        </div>
        <ul class="space-y-4">
          {
            data.security.items.map((item, index) => (
              <li class="flex gap-3 text-sm leading-6 text-[var(--color-ink-soft)]">
                <svg
                  viewBox="0 0 24 24"
                  class="h-5 w-5 shrink-0 text-emerald-400"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={ICONS[(['lock', 'shield', 'trend', 'percent'] as const)[index] ?? 'check']}
                />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="border-t border-white/5 bg-zinc-950/20" aria-labelledby="steps-heading">
    <div class="container-x py-20 lg:py-24">
      <div class="text-center">
        <span class="eyebrow">Simple, secure &amp; hands-off</span>
        <h2 id="steps-heading" class="mt-3 text-3xl leading-tight md:text-4xl">How it works</h2>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {
          data.steps.map((step) => (
            <div class="hover-brand-card reveal relative h-full p-6">
              <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-emerald-400/30 bg-emerald-400/[0.12] font-mono text-xl font-bold text-[var(--color-accent-soft)]">
                {step.step}
              </span>
              <h3 class="mt-5 text-lg font-semibold text-[var(--color-ink)]">{step.title}</h3>
              <p class="mt-3 text-sm leading-7 text-[var(--color-ink-dim)]">{step.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Compounding -->
  <section class="border-t border-white/5" aria-labelledby="compounding-heading">
    <div class="container-x py-20 text-center lg:py-24">
      <h2 id="compounding-heading" class="mx-auto max-w-3xl text-3xl leading-tight md:text-4xl">
        {data.compounding.title}
      </h2>
      <p class="mx-auto mt-6 max-w-3xl text-base leading-8 text-[var(--color-ink-soft)]">{data.compounding.body}</p>
      <p class="mt-4 font-semibold text-emerald-400">{data.compounding.formula}</p>
    </div>
  </section>

  <!-- Plans -->
  <section class="border-t border-white/5 bg-emerald-500/[0.03]" aria-labelledby="plans-heading">
    <div class="container-x py-20 lg:py-24">
      <div class="text-center">
        <span class="eyebrow">Choose your plan</span>
        <h2 id="plans-heading" class="mt-3 text-3xl leading-tight md:text-4xl">Profit-share plans</h2>
        <p class="mx-auto mt-3 max-w-xl text-sm text-[var(--color-ink-dim)]">
          Each plan offers transparent profit sharing, no hidden fees and full control of your funds.
        </p>
      </div>

      <div class="mx-auto mt-14 grid max-w-6xl gap-8 md:grid-cols-3">
        {
          data.plans.map((plan) => (
            <div class:list={['relative flex flex-col p-8', plan.popular ? 'brand-card shadow-glow' : 'panel']}>
              {plan.popular && (
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-emerald-500 px-4 py-1 text-xs font-bold uppercase tracking-wide text-black">
                  Most popular
                </span>
              )}
              <h3 class="text-2xl font-bold text-[var(--color-ink)]">{plan.name}</h3>
              <div class="mb-6 mt-2 border-b border-white/10 pb-6">
                <p class="metric-label">Min deposit</p>
                <p class="display-stat mt-1 text-4xl text-[var(--color-accent)]">{plan.deposit}</p>
              </div>

              <dl class="flex-1 space-y-4">
                <div>
                  <dt class="metric-label">Profit share</dt>
                  <dd class="mt-1 text-lg font-semibold text-[var(--color-ink)]">{plan.profitShare}</dd>
                  <dd class="text-sm text-emerald-400">{plan.youKeep}</dd>
                </div>
                <div>
                  <dt class="metric-label">Brokers</dt>
                  <dd class="mt-1 text-sm text-[var(--color-ink-soft)]">{plan.brokers}</dd>
                </div>
                <div>
                  <dt class="metric-label">Ideal for</dt>
                  <dd class="mt-1 text-sm text-[var(--color-ink-soft)]">{plan.idealFor}</dd>
                </div>
              </dl>

              <a
                href={telegram}
                rel="noopener"
                class:list={['mt-8 w-full', plan.popular ? 'btn btn-primary' : 'btn btn-ghost']}
              >
                Join now
                <svg
                  viewBox="0 0 24 24"
                  class="h-4 w-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={ICONS.arrow}
                />
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="border-t border-white/5" aria-labelledby="testimonials-heading">
    <div class="container-x py-20 lg:py-24">
      <div class="text-center">
        <span class="eyebrow">Client feedback</span>
        <h2 id="testimonials-heading" class="mt-3 text-3xl leading-tight md:text-4xl">
          What our clients say
        </h2>
      </div>

      <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          data.testimonials.map((item) => (
            <figure class="hover-brand-card reveal flex flex-col gap-4 p-6">
              <span class="stars text-sm" aria-hidden="true">★★★★★</span>
              <blockquote class="flex-1 text-sm leading-7 text-[var(--color-ink-soft)]">“{item.quote}”</blockquote>
              <figcaption class="border-t border-white/10 pt-3">
                <span class="block text-sm font-semibold text-[var(--color-ink)]">{item.name}</span>
                <span class="mt-1 block text-xs text-slate-500">{item.role}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-white/5 bg-zinc-950/20" aria-labelledby="copy-faq-heading">
    <div class="container-x py-20 lg:py-24">
      <div class="mx-auto max-w-3xl">
        <h2 id="copy-faq-heading" class="text-center text-3xl leading-tight md:text-4xl">
          Frequently asked questions
        </h2>
        <div class="mt-12 divide-y divide-[var(--color-line-soft)]">
          {
            data.faqs.map((faq, index) => (
              <details class="group py-4" open={index === 0}>
                <summary class="flex cursor-pointer list-none items-start justify-between gap-4">
                  <h3 class="text-sm font-semibold text-[var(--color-ink)]">{faq.question}</h3>
                  <span
                    aria-hidden="true"
                    class="mt-0.5 shrink-0 text-[var(--color-accent)] transition-transform group-open:rotate-45"
                  >
                    +
                  </span>
                </summary>
                <p class="mt-3 max-w-3xl text-sm leading-7 text-[var(--color-ink-soft)]">{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
      <p class="mx-auto mt-10 max-w-3xl text-center text-xs leading-6 text-[var(--color-ink-dim)]">{RISK_DISCLAIMER}</p>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="border-t border-white/5">
    <div class="container-x py-20 lg:py-24">
      <div class="brand-card reveal mx-auto max-w-4xl p-8 text-center sm:p-12">
        <h2 class="text-3xl leading-tight md:text-4xl">{data.cta.title}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-[var(--color-ink-soft)]">{data.cta.body}</p>
        <a href={telegram} rel="noopener" class="btn btn-primary mt-9 !px-7 !py-3.5 !text-base">
          {data.cta.button}
          <svg
            viewBox="0 0 24 24"
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={ICONS.arrow}
          />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
