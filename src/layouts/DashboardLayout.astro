---
/**
 * The account shell: `/dashboard/*`.
 *
 * Every account page renders through here, so the section nav, the signed-in
 * identity and the sign-out action exist in exactly one place. Before this each
 * page repeated its own `container-x py-16` block and a different set of
 * "back to dashboard" links, which is how six pages drift apart.
 *
 * The page itself passes `active` rather than the shell guessing from the URL:
 * the nav is a fixed list, and an explicit key cannot silently point at the
 * wrong tab when a route is renamed.
 */
export const prerender = false;

import { eq } from 'drizzle-orm';
import BaseLayout from './BaseLayout.astro';
import { getDb } from '../db/client';
import { customers } from '../db/schema';
import { getBuildProgressByLicense, listCustomerBuilds } from '../server/portal';
import { url } from '../lib/urls';

export interface Props {
  active: 'overview' | 'licenses' | 'downloads' | 'orders' | 'account' | 'support';
  title: string;
  heading: string;
  lead?: string;
}

const { active, title, heading, lead } = Astro.props;

const session = Astro.locals.session;
if (!session || session.subjectType !== 'customer') return Astro.redirect('/login/');

const customer = await getDb()
  .select({ email: customers.email, name: customers.name })
  .from(customers)
  .where(eq(customers.id, session.subjectId))
  .get();

const [buildProgress, readyBuilds] = await Promise.all([
  getBuildProgressByLicense(getDb(), session.subjectId),
  listCustomerBuilds(getDb(), session.subjectId),
]);
const generatingCount = [...buildProgress.values()].filter((state) => state === 'generating').length;

const nav = [
  { key: 'overview', href: url('/dashboard'), label: 'Overview' },
  { key: 'licenses', href: url('/dashboard/licenses'), label: 'Licences' },
  { key: 'downloads', href: url('/dashboard/downloads'), label: 'Downloads' },
  { key: 'orders', href: url('/dashboard/orders'), label: 'Orders' },
  { key: 'account', href: url('/dashboard/account'), label: 'Account' },
  { key: 'support', href: url('/dashboard/support'), label: 'Support' },
] as const;

/** Section icons, drawn in the same stroke as the header's icon set. */
const ICONS: Record<string, string> = {
  overview:
    '<rect x="3" y="3" width="7.5" height="7.5" rx="1.6"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.6"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.6"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.6"/>',
  licenses:
    '<path d="M12.6 11.4a5.5 5.5 0 1 0-7.78 7.78 5.5 5.5 0 0 0 7.78-7.78Zm0 0L20 4m-3 0h3v3"/>',
  downloads: '<path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14"/>',
  orders: '<path d="M6 2h12v20l-3-2-3 2-3-2-3 2V2Z"/><path d="M9 7h6M9 11h6"/>',
  account: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  support: '<path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/>',
};

/** The person this shell belongs to, for the avatar and the greeting. */
const displayName = customer?.name?.trim() || customer?.email?.split('@')[0] || 'your account';
const initial = (displayName[0] ?? 'A').toUpperCase();

/** The session's own expiry, so "signed in" is a fact with a date, not a mood. */
const sessionUntil = session.expiresAt
  ? new Date(session.expiresAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : null;
---

<BaseLayout title={title} description={`${heading} — your BestMT4EA account.`} noindex>
  <section class="relative overflow-hidden border-b border-white/5">
    <div class="glow-orb animate-aurora left-[-8rem] top-[-12rem] h-[24rem] w-[32rem] bg-emerald-500/20" aria-hidden="true">
    </div>
    <div class="grid-overlay pointer-events-none absolute inset-0"></div>

    <div class="container-x relative z-10 pb-7 pt-10">
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
        <div class="animate-fade-in-up">
          <p class="section-kicker">Account</p>
          <h1 class="mt-2 text-balance text-3xl font-bold tracking-tight sm:text-4xl">{heading}</h1>
          {
            lead && (
              <p class="mt-3 max-w-2xl text-sm leading-7 text-[var(--color-ink-soft)]">{lead}</p>
            )
          }
        </div>

        <div class="animate-fade-in-up-delay-1 flex flex-wrap items-center gap-x-4 gap-y-3">
          <span
            class="metric-value grid h-11 w-11 flex-none place-items-center rounded-full border border-emerald-400/25 bg-emerald-400/10 text-base text-[var(--color-accent-soft)]"
            aria-hidden="true"
          >
            {initial}
          </span>
          <span class="min-w-0">
            <span class="block truncate text-sm font-medium text-[var(--color-ink)]">
              {customer?.email ?? 'your account'}
            </span>
            <span class="mt-0.5 block text-xs leading-6 text-[var(--color-ink-dim)]">
              <span class="live-dot mr-1.5 inline-block align-middle" aria-hidden="true"></span>
              {sessionUntil ? `Session open until ${sessionUntil}` : 'Signed in'}
            </span>
          </span>
          <a href="/logout/" class="btn btn-ghost !px-4 !py-2 !text-xs">Sign out</a>
        </div>
      </div>
    </div>
  </section>

  <nav
    class="sticky top-16 z-30 border-b border-white/5 bg-black/75 backdrop-blur-xl"
    aria-label="Account sections"
  >
    <div class="container-x">
      <ul class="nav-rail py-2">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={active === item.key ? 'page' : undefined}
                class:list={[
                  'flex min-h-[44px] items-center gap-2 whitespace-nowrap rounded-lg px-3.5 text-sm font-semibold transition-colors',
                  active === item.key
                    ? 'bg-white/[0.07] text-white shadow-[inset_0_-1px_0_0_rgba(0,193,144,0.7)]'
                    : 'text-slate-400 hover:bg-white/[0.04] hover:text-white',
                ]}
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4"
                  aria-hidden="true"
                  set:html={ICONS[item.key]}
                />
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  {
    generatingCount > 0 && (
      <div class="border-b border-amber-400/20 bg-amber-400/10">
        <div
          class="container-x flex flex-wrap items-center justify-between gap-3 py-3"
          role="status"
          data-build-banner
        >
          <p class="flex items-center gap-2.5 text-sm text-amber-100">
            <span class="live-dot" aria-hidden="true" />
            <span>
              <strong class="font-semibold">
                Your licence{generatingCount === 1 ? ' is' : 's are'} being generated.
              </strong>{' '}
              It will be ready to download in about 10 minutes — please be patient. You can leave this page open and we
              will tell you the moment it is ready.
            </span>
          </p>
          <button type="button" class="btn btn-ghost !px-4 !py-2 !text-xs" data-notify-optin hidden>
            Notify me when ready
          </button>
        </div>
      </div>
    )
  }

  <div
    class="pointer-events-none fixed inset-x-0 top-20 z-50 flex justify-center px-4"
    data-build-toast-host
    data-generating={generatingCount}
    data-ready={readyBuilds.length}
    data-downloads-url={url('/dashboard/downloads')}
    aria-live="polite"
  >
  </div>

  <section class="container-x py-10 lg:py-12">
    <slot />
  </section>
</BaseLayout>

<script>
  /*
   * Build watcher. While a licence is generating, poll for progress; when a file
   * becomes ready, raise an on-page popup and, if the visitor opted in, a system
   * notification — so they do not have to sit refreshing the page.
   */
  const host = document.querySelector<HTMLElement>('[data-build-toast-host]');
  const optIn = document.querySelector<HTMLButtonElement>('[data-notify-optin]');
  const supportsNotifications = typeof Notification !== 'undefined';

  if (optIn && supportsNotifications && Notification.permission === 'default') {
    optIn.hidden = false;
    optIn.addEventListener('click', async () => {
      try {
        await Notification.requestPermission();
      } catch {
        /* an old browser without the promise form: ignore */
      }
      optIn.hidden = true;
    });
  }

  if (host && Number(host.dataset.generating) > 0) {
    let knownReady = Number(host.dataset.ready ?? 0);
    const downloadsUrl = host.dataset.downloadsUrl ?? '/dashboard/downloads/';
    const originalTitle = document.title;
    const deadline = Date.now() + 90 * 60_000; // stop after 90 minutes

    const announce = (titles: string[]) => {
      const names = titles.length ? titles.join(', ') : 'Your download';
      const toast = document.createElement('div');
      toast.className =
        'pointer-events-auto flex max-w-md items-center gap-4 rounded-2xl border border-emerald-400/30 bg-zinc-950/95 px-5 py-4 shadow-[0_0_40px_rgba(0,193,144,0.25)] backdrop-blur';
      toast.setAttribute('role', 'alert');
      toast.innerHTML =
        '<span class="live-dot" aria-hidden="true"></span><span class="text-sm text-slate-100"><strong class="block font-semibold text-emerald-300">Your download is ready</strong><span class="text-slate-300"></span></span><a class="btn btn-primary !px-4 !py-2 !text-xs" href="' +
        downloadsUrl +
        '">Download</a><button type="button" class="text-slate-400 hover:text-white" aria-label="Dismiss">✕</button>';
      toast.querySelector('span.text-slate-300')!.textContent = names + ' is ready to download.';
      toast.querySelector('button')!.addEventListener('click', () => toast.remove());
      host.appendChild(toast);

      document.title = '✅ Download ready — ' + originalTitle;
      if (supportsNotifications && Notification.permission === 'granted') {
        try {
          new Notification('Your download is ready', { body: names + ' is ready to download.' });
        } catch {
          /* some mobile browsers only allow notifications via a service worker */
        }
      }
      document.querySelector('[data-build-banner]')?.parentElement?.remove();
    };

    const timer = window.setInterval(async () => {
      if (Date.now() > deadline) return window.clearInterval(timer);
      try {
        const res = await fetch('/api/licenses/build-status/', { credentials: 'same-origin' });
        if (!res.ok) return;
        const state = (await res.json()) as { generating: number; ready: { id: string; title: string }[] };
        if (state.ready.length > knownReady) {
          announce(state.ready.slice(0, state.ready.length - knownReady).map((build) => build.title));
          knownReady = state.ready.length;
        }
        if (state.generating === 0) window.clearInterval(timer);
      } catch {
        /* offline blip: try again on the next tick */
      }
    }, 15_000);
  }
</script>
