{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bestmt4ea",
  "compatibility_date": "2025-09-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "bestmt4ea-files"
    }
  ],
  "vars": {
    "PUBLIC_SITE_URL": "https://bestmt4ea.com",
    "PUBLIC_R2_PUBLIC_URL": "https://files.bestmt4ea.com"
  },
  "observability": {
    "enabled": true
  }
}
