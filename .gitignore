# build output
dist/
.astro/
node_modules/

# env
.env
.env.production
.dev.vars

# wrangler
.wrangler/

# generated seed SQL (rebuilt by scripts/seed-catalog.mjs)
scripts/seed-catalog.sql

# os / editor
.DS_Store
Thumbs.db
*.log

# test artifacts
test-results/
playwright-report/

# paid product binaries — never committed (uploaded to the R2 bucket instead)
product-files/

# EA source and compiled experts — the templates live in the private R2 bucket
# (`templates/<productId>/source.mq4`). These patterns are a backstop so a stray
# copy anywhere in the tree can never be committed or published.
*.mq4
*.mq5
*.mqh
*.ex4
*.ex5
*.set

# command code local session state and notes — never published
.commandcode/

# not published: competitor research and scraped WordPress caches (regenerate
# the caches with `npm run wp:export`)
competitors_for_bestmt4ea.com.csv
.wp-cache/
